            <div class="inline-flex p-1 rounded-xl bg-brand-50 border border-brand-100 self-start">
              <button onclick="setOrderTab('orders')" data-otab="orders" class="tap order-tab-btn px-4 py-2 rounded-lg text-xs font-extrabold flex items-center gap-1.5"><i data-lucide="receipt" class="w-3.5 h-3.5"></i> Orders <span id="ordersTabCount" class="opacity-70"></span></button>
              <button onclick="setOrderTab('held')" data-otab="held" class="tap order-tab-btn px-4 py-2 rounded-lg text-xs font-extrabold flex items-center gap-1.5"><i data-lucide="pause-circle" class="w-3.5 h-3.5"></i> Held <span id="heldTabCount" class="opacity-70"></span></button>
            </div>
