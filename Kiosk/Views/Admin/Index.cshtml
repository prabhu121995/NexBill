@inject Kiosk.Services.BusinessClock ShopCountryClock
@{
    Layout = null;
    var displayName = ((ViewData["DisplayName"] as string) ?? "").Trim();
    var roleName = (ViewData["RoleName"] as string) ?? "";
    var initial = displayName.Length > 0 ? displayName[..1].ToUpperInvariant() : "?";
}
<!DOCTYPE html>
<html lang="en" class="h-full select-none">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>@(await Brand.NameAsync()) — Admin Control</title>
  <partial name="_AppIcons" />
  <partial name="_ShopClock" />
  <script src="~/lib/tailwind/tailwind.min.js"></script>
  <script src="~/lib/lucide/lucide.min.js"></script>
  <link rel="stylesheet" href="~/lib/fonts/fonts.css" />
  <link rel="stylesheet" href="~/css/density.css" asp-append-version="true" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
            digital: ['"Chakra Petch"', 'sans-serif'],
          },
          colors: {
            brand: { 25:'#fcfdfa',50:'#f9f9f3',100:'#f1f2e5',200:'#e4e6d1',300:'#d0d3b1',400:'#b8bc8a',500:'#828746',600:'#74793f',700:'#5e6133',800:'#474a26',900:'#37391e',950:'#202211' },
            mint: { 50:'#edfcf5',100:'#d3f7e6',200:'#a7eecb',500:'#10b981',600:'#059669',700:'#047857' },
            amber: { 50:'#fffbeb',100:'#fef3c7',500:'#f59e0b',600:'#d97706',700:'#b45309' },
            rose: { 50:'#fff1f2',100:'#ffe4e6',500:'#f43f5e',600:'#e11d48',700:'#be123c' },
            sky: { 50:'#f0f9ff',100:'#e0f2fe',500:'#0ea5e9',600:'#0284c7',700:'#0369a1' }
          },
          boxShadow: {
            'soft': '0 1px 2px rgba(32,34,17,.04), 0 4px 16px -4px rgba(32,34,17,.08)',
            'lift': '0 10px 30px -8px rgba(116,121,63,.28)',
            'glow': '0 0 20px rgba(116,121,63,.15)',
          },
        }
      }
    }
  </script>
  <style>
    /* White-first page with two faint orange glows - the glass cards need something soft behind them to frost. */
    .app-bg { background-color: #fdfdf9; background-image: radial-gradient(55rem 38rem at -8% -12%, rgba(184,188,138,.32), transparent 60%), radial-gradient(48rem 38rem at 108% 112%, rgba(208,211,177,.38), transparent 60%), radial-gradient(40rem 30rem at 55% 45%, rgba(241,242,229,.55), transparent 70%); background-attachment: fixed; }
    .glass { background: linear-gradient(135deg, rgba(255,255,255,.74), rgba(255,255,255,.4)); -webkit-backdrop-filter: blur(20px) saturate(170%); backdrop-filter: blur(20px) saturate(170%); border: 1px solid rgba(255,255,255,.95); box-shadow: inset 0 1px 0 #fff, inset 0 -1px 0 rgba(255,255,255,.35), 0 10px 30px -12px rgba(116,121,63,.22); }
    /* Modals and the login card: more opaque, so form text stays easy to read over whatever is behind. */
    .glass-strong { background: rgba(255,255,255,.84); -webkit-backdrop-filter: blur(24px) saturate(160%); backdrop-filter: blur(24px) saturate(160%); border: 1px solid rgba(255,255,255,.85); box-shadow: inset 0 1px 0 rgba(255,255,255,.95), 0 18px 48px -16px rgba(32,34,17,.28); }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #e4e6d1; border-radius: 6px; }
    .tap { touch-action: manipulation; transition: transform .1s ease, background-color .15s, border-color .15s, box-shadow .15s; }
    .tap:active { transform: scale(.96); }
    .tap:focus-visible { outline: 2px solid #74793f; outline-offset: 2px; }

    @@keyframes fade-in { 0%{opacity:0;transform:translateY(12px)} 100%{opacity:1;transform:translateY(0)} }
    @@keyframes slide-in-left { 0%{opacity:0;transform:translateX(-20px)} 100%{opacity:1;transform:translateX(0)} }
    @@keyframes count-pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.08)} }
    @@keyframes shake { 0%,100%{transform:translateX(0)} 20%,60%{transform:translateX(-6px)} 40%,80%{transform:translateX(6px)} }
    @@keyframes bar-grow { 0%{height:0} 100%{height:var(--bar-h)} }
    @@keyframes toast-in { 0%{opacity:0;transform:translateY(-100%) scale(.95)} 100%{opacity:1;transform:translateY(0) scale(1)} }
    @@keyframes toast-out { 0%{opacity:1;transform:translateY(0) scale(1)} 100%{opacity:0;transform:translateY(-100%) scale(.95)} }
    @@keyframes shimmer { 0%{background-position:-200% 0} 100%{background-position:200% 0} }
    @@keyframes spin { 100%{transform:rotate(360deg)} }

    .fade-in { animation: fade-in .45s ease both; }
    .slide-in { animation: slide-in-left .4s ease both; }
    .animate-shake { animation: shake .35s ease; }
    .bar-animate { animation: bar-grow .6s ease both; }

    .section-page { display: none; }
    .section-page.active { display: block; }

    .nav-item.active { background: rgba(116,121,63,.12); color: #74793f; border-right: 3px solid #74793f; }
    .stat-card { transition: transform .25s cubic-bezier(.4,0,.2,1), box-shadow .25s; }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px -8px rgba(116,121,63,.2); }
    .table-row:hover { background: #fcfdfa; }

    /* Refresh button: the icon spins only while a fetch is in flight, so the
       dashboard always shows whether the figures on screen are being re-read. */
    #refreshBtn[data-loading="1"] svg { animation: spin .8s linear infinite; }
    #refreshBtn[data-loading="1"] { pointer-events: none; opacity: .65; }

    /* Toast animations */
    .toast-visible { animation: toast-in .4s cubic-bezier(.21,1.02,.73,1) forwards; }
    .toast-hidden  { animation: toast-out .3s ease forwards; }

    /* Mobile sidebar overlay */
    .sidebar-overlay { opacity:0; pointer-events:none; transition: opacity .3s; }
    .sidebar-overlay.open { opacity:1; pointer-events:auto; }
    /* Off-canvas drawer (Users & Roles): slides in from the right over a dimmed page. */
    .offcanvas { transform: translateX(100%); visibility: hidden; transition: transform .3s cubic-bezier(.4,0,.2,1), visibility 0s linear .3s; }
    .offcanvas.open { transform: translateX(0); visibility: visible; transition: transform .3s cubic-bezier(.4,0,.2,1); }
    .offcanvas [data-form] { display: none; }
    .offcanvas[data-pane="user"] [data-form="user"], .offcanvas[data-pane="role"] [data-form="role"] { display: block; }
    .offcanvas-backdrop { opacity:0; pointer-events:none; transition: opacity .3s; }
    .offcanvas-backdrop.open { opacity:1; pointer-events:auto; }

    @@media (max-width: 1023px) {
      #sidebar { transform: translateX(-100%); transition: transform .3s cubic-bezier(.4,0,.2,1); position:fixed; top:0; left:0; bottom:0; }
      #sidebar.open { transform: translateX(0); }
    }
  </style>
</head>

<body class="h-full app-bg font-sans overflow-hidden">

  <form id="logoutForm" method="post" action="@Url.Action("Logout", "Account")" class="hidden">@Html.AntiForgeryToken()</form>
  <!-- Mobile sidebar overlay -->
  <div id="sidebarOverlay" class="sidebar-overlay fixed inset-0 bg-black/40 backdrop-blur-sm z-20 lg:hidden" onclick="toggleSidebar()"></div>

  <div class="h-full flex">

    <!-- ========== SIDEBAR ========== -->
    <aside id="sidebar" class="w-64 bg-white/70 backdrop-blur-xl border-r border-brand-100 flex flex-col flex-shrink-0 shadow-soft z-30">

      <!-- brand -->
      <div class="p-5 border-b border-brand-100 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 shadow-lift flex items-center justify-center flex-shrink-0">
          <svg viewBox="14.5 14.5 71 71" class="w-5 h-5" aria-hidden="true"><defs><mask id="nbNAdmin1"><rect x="0" y="0" width="100" height="100" fill="#fff"/><path d="M39 63V36.5h6.6l9.8 14.8V36.5H62V63h-6.6l-9.8-14.8V63z" fill="#000"/></mask></defs><g mask="url(#nbNAdmin1)"><path d="M50 16.5C58.5 21 67 23.2 75 23.2V47C75 65.5 64.5 77.5 50 84.5C35.5 77.5 25 65.5 25 47V23.2C33 23.2 41.5 21 50 16.5Z" fill="#fff" stroke="#fff" stroke-width="3" stroke-linejoin="round"/><path d="M50 16.5V84.5C35.5 77.5 25 65.5 25 47V23.2C33 23.2 41.5 21 50 16.5Z" fill="#e7e9d6" stroke="#e7e9d6" stroke-width="3" stroke-linejoin="round"/></g></svg>
        </div>
        <div>
          <h1 class="text-base font-extrabold text-brand-950 leading-tight">@(await Brand.NameAsync())</h1>
          <p class="text-[10px] font-bold text-brand-400 uppercase tracking-widest">Admin Panel</p>
        </div>
        <!-- close btn on mobile -->
        <button onclick="toggleSidebar()" class="lg:hidden ml-auto tap w-8 h-8 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <!-- nav -->
      <nav class="flex-1 py-3 px-3 space-y-1 overflow-y-auto">
        <button onclick="showSection('dashboard')" data-nav="dashboard" class="nav-item active tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-left transition-all">
          <i data-lucide="layout-dashboard" class="w-[18px] h-[18px]"></i> Dashboard
        </button>
        <button onclick="showSection('categories')" data-nav="categories" class="nav-item tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-slate-500 text-left transition-all">
          <i data-lucide="layout-list" class="w-[18px] h-[18px]"></i> Categories
        </button>
        <button onclick="showSection('menu')" data-nav="menu" class="nav-item tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-slate-500 text-left transition-all">
          <i data-lucide="package" class="w-[18px] h-[18px]"></i> Menu Items
        </button>
        <button onclick="showSection('transactionmodes')" data-nav="transactionmodes" class="nav-item tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-slate-500 text-left transition-all">
          <i data-lucide="arrow-left-right" class="w-[18px] h-[18px]"></i> Transaction Modes
        </button>
        <button onclick="showSection('orders')" data-nav="orders" class="nav-item tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-slate-500 text-left transition-all">
          <i data-lucide="receipt" class="w-[18px] h-[18px]"></i> Orders
          <span class="ml-auto px-2 py-0.5 rounded-full bg-brand-100 text-brand-700 text-[11px] font-extrabold">24</span>
        </button>
        <button onclick="showSection('staff')" data-nav="staff" class="nav-item tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-slate-500 text-left transition-all">
          <i data-lucide="users" class="w-[18px] h-[18px]"></i> Users &amp; Roles
        </button>
        <button onclick="showSection('attendance')" data-nav="attendance" class="nav-item tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-slate-500 text-left transition-all">
          <i data-lucide="clock-3" class="w-[18px] h-[18px]"></i> Attendance
        </button>
        @* Hidden for now; restore when Reports is needed.
        <button onclick="showSection('reports')" data-nav="reports" class="nav-item tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-slate-500 text-left transition-all">
          <i data-lucide="bar-chart-3" class="w-[18px] h-[18px]"></i> Reports
        </button>
        *@
        <button onclick="showSection('settings')" data-nav="settings" class="nav-item tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-slate-500 text-left transition-all">
          <i data-lucide="settings" class="w-[18px] h-[18px]"></i> Settings
        </button>
      </nav>

      <!-- bottom -->
      <div class="p-3 border-t border-brand-100 space-y-1">
        <a href="@Url.Action("Index", "Home")" onclick="event.preventDefault(); window.location.replace(this.href)" class="tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-slate-500 hover:bg-brand-50 transition">
          <i data-lucide="monitor" class="w-[18px] h-[18px]"></i> Open POS
        </a>
        <button onclick="signOut()" class="tap w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-rose-500 hover:bg-rose-50 transition text-left">
          <i data-lucide="log-out" class="w-[18px] h-[18px]"></i> Logout
        </button>
      </div>
    </aside>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="flex-1 flex flex-col overflow-hidden min-w-0">

      <!-- top bar -->
      <header class="h-14 sm:h-16 bg-white/70 backdrop-blur-xl border-b border-brand-100 flex items-center justify-between px-4 sm:px-6 flex-shrink-0 shadow-soft z-20">
        <div class="flex items-center gap-3">
          <!-- hamburger on mobile -->
          <button onclick="toggleSidebar()" class="lg:hidden tap w-9 h-9 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 hover:bg-brand-100 flex-shrink-0">
            <i data-lucide="menu" class="w-5 h-5"></i>
          </button>
          <div>
            <h2 id="pageTitle" class="text-base sm:text-lg font-extrabold text-brand-950">Dashboard</h2>
            <p id="pageSubtitle" class="text-[11px] sm:text-xs text-slate-400 font-semibold hidden sm:block">Overview of today's performance</p>
          </div>
        </div>
        <div class="flex items-center gap-2 sm:gap-3">
          <div id="refreshWrap" class="flex items-center gap-2">
            <span id="syncedAt" class="hidden md:inline text-[10px] font-bold text-slate-400 whitespace-nowrap"></span>
            <button id="refreshBtn" type="button" onclick="loadDashboard(true)" title="Refresh from database"
                    class="tap w-9 h-9 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 hover:bg-brand-100 flex-shrink-0">
              <i data-lucide="refresh-cw" class="w-[18px] h-[18px]"></i>
              <span class="sr-only">Refresh</span>
            </button>
          </div>
          <span id="liveClock" class="text-xs sm:text-sm font-mono font-bold text-brand-600 bg-brand-50 px-2.5 sm:px-3 py-1.5 rounded-lg"></span>
          <div class="hidden sm:flex flex-col items-end leading-tight">
            <span class="text-xs font-extrabold text-brand-950">@displayName</span>
            <span class="text-[10px] font-bold text-brand-400 uppercase tracking-wider">@roleName</span>
          </div>
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white font-bold text-sm shadow-lift" title="@displayName">@initial</div>
        </div>
      </header>

      <!-- scrollable area -->
      <div class="flex-1 overflow-y-auto p-4 sm:p-6">

        <!-- ===== DASHBOARD ===== -->
        <div id="sec-dashboard" class="section-page active fade-in">

          <!-- stat cards -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-5 sm:mb-6">
            <div class="stat-card glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <div class="flex items-center justify-between mb-2 sm:mb-3">
                <span class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Today Revenue</span>
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-mint-50 flex items-center justify-center"><i data-lucide="indian-rupee" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-mint-600"></i></div>
              </div>
              <p id="kpiRevenue" class="text-xl sm:text-2xl font-extrabold text-brand-950 font-digital">&#8212;</p>
              <p id="kpiRevenueNote" class="text-[10px] sm:text-xs font-bold text-slate-400 mt-1 flex items-center gap-1">Loading&#8230;</p>
            </div>
            <div class="stat-card glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <div class="flex items-center justify-between mb-2 sm:mb-3">
                <span class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Orders</span>
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-brand-50 flex items-center justify-center"><i data-lucide="shopping-bag" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-brand-600"></i></div>
              </div>
              <p id="kpiOrders" class="text-xl sm:text-2xl font-extrabold text-brand-950 font-digital">&#8212;</p>
              <p id="kpiOrdersNote" class="text-[10px] sm:text-xs font-bold text-slate-400 mt-1 flex items-center gap-1">Loading&#8230;</p>
            </div>
            <div class="stat-card glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <div class="flex items-center justify-between mb-2 sm:mb-3">
                <span class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Avg Order</span>
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-amber-50 flex items-center justify-center"><i data-lucide="calculator" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-600"></i></div>
              </div>
              <p id="kpiAvgOrder" class="text-xl sm:text-2xl font-extrabold text-brand-950 font-digital">&#8212;</p>
              <p class="text-[10px] sm:text-xs font-bold text-slate-400 mt-1">Per settled bill</p>
            </div>
            <div class="stat-card glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <div class="flex items-center justify-between mb-2 sm:mb-3">
                <span class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Active Staff</span>
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-sky-50 flex items-center justify-center"><i data-lucide="users" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-sky-600"></i></div>
              </div>
              <p id="kpiStaff" class="text-xl sm:text-2xl font-extrabold text-brand-950 font-digital">&#8212;</p>
              <p id="kpiStaffNote" class="text-[10px] sm:text-xs font-bold text-slate-400 mt-1">On shift today</p>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 sm:gap-4">
            <!-- hourly chart -->
            <div class="lg:col-span-2 glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <h3 class="text-sm font-extrabold text-brand-950 mb-4">Hourly Sales</h3>
              <div class="flex items-end gap-1.5 sm:gap-2 h-36 sm:h-40" id="hourlyChart"></div>
            </div>
            <!-- top items -->
            <div class="glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <h3 class="text-sm font-extrabold text-brand-950 mb-4">Top Sellers</h3>
              <div class="space-y-3" id="topSellers"></div>
            </div>
          </div>

          <!-- recent orders -->
          <div class="mt-4 glass rounded-2xl shadow-soft overflow-hidden">
            <div class="px-4 sm:px-5 py-3 sm:py-4 border-b border-brand-100 flex items-center justify-between">
              <h3 class="text-sm font-extrabold text-brand-950">Recent Orders</h3>
              <button onclick="showSection('orders')" class="tap text-xs font-bold text-brand-600 hover:text-brand-700">View All &rarr;</button>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm min-w-[540px]">
                <thead><tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-brand-50">
                  <th class="text-left px-4 sm:px-5 py-2.5">Order</th><th class="text-left px-4 sm:px-5 py-2.5">Items</th><th class="text-left px-4 sm:px-5 py-2.5">Time</th><th class="text-left px-4 sm:px-5 py-2.5">Status</th><th class="text-right px-4 sm:px-5 py-2.5">Total</th>
                </tr></thead>
                <tbody id="recentOrdersBody"></tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ===== CATEGORIES ===== -->
        <div id="sec-categories" class="section-page">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-5">
            <div class="flex flex-wrap gap-2">
              <button onclick="filterCategories('all', this)" class="tap cat-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-brand-600 text-white">All <span id="catCountAll" class="opacity-70"></span></button>
              <button onclick="filterCategories('active', this)" class="tap cat-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-500 border border-brand-200">Active <span id="catCountActive" class="opacity-70"></span></button>
              <button onclick="filterCategories('inactive', this)" class="tap cat-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-500 border border-brand-200">Inactive <span id="catCountInactive" class="opacity-70"></span></button>
            </div>
            <button onclick="openCategoryModal()" class="tap px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs flex items-center gap-2 shadow-lift w-full sm:w-auto justify-center">
              <i data-lucide="plus" class="w-4 h-4"></i> Add Category
            </button>
          </div>
          <p class="text-xs text-slate-400 font-semibold mb-4">Only active categories appear on the POS rail. Deactivating one also hides its items from the till; tills pick up changes on their next page load.</p>
          <div class="glass rounded-2xl shadow-soft overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-sm min-w-[600px]">
                <thead><tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-brand-100">
                  <th class="text-left px-4 sm:px-5 py-3">Category</th><th class="text-left px-4 sm:px-5 py-3">Code</th><th class="text-right px-4 sm:px-5 py-3">Items</th><th class="text-left px-4 sm:px-5 py-3">Status</th><th class="text-center px-4 sm:px-5 py-3">Active</th><th class="text-right px-4 sm:px-5 py-3">Action</th>
                </tr></thead>
                <tbody id="categoriesBody"><tr><td colspan="6" class="px-5 py-8 text-center text-xs font-bold text-slate-400">Loading&#8230;</td></tr></tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ===== TRANSACTION MODES ===== -->
        <div id="sec-transactionmodes" class="section-page">
          <div class="flex justify-end mb-5">
            <button onclick="openModeModal()" class="tap px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs flex items-center gap-2 shadow-lift w-full sm:w-auto justify-center">
              <i data-lucide="plus" class="w-4 h-4"></i> Add Transaction Mode
            </button>
          </div>
          <p class="text-xs text-slate-400 font-semibold mb-4">These fill the Mode dropdown in the till's Transactions popup. Only active ones are offered. A mode can only be deleted once no transaction uses it.</p>
          <div class="glass rounded-2xl shadow-soft overflow-hidden">
