              </div>
              <div id="ordersDateWrap" class="flex items-center gap-2">
                <input id="ordersDate" type="date" required value="@ViewData["Today"]" max="@ViewData["Today"]" onchange="onOrdersDate()" class="px-3 py-2 rounded-xl border border-brand-200 bg-white text-xs font-bold text-slate-600 focus:outline-none focus:ring-2 focus:ring-brand-400">
              </div>
              <button onclick="loadOrdersSection(true)" title="Refresh" class="tap w-9 h-9 rounded-xl bg-white border border-brand-200 flex items-center justify-center text-brand-600 hover:bg-brand-50"><i data-lucide="refresh-cw" class="w-4 h-4"></i></button>
            </div>
          </div>

          <div id="ordersPane">
            <div class="flex flex-wrap gap-2 mb-4">
              <button onclick="filterOrders('all', this)" class="tap order-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-brand-600 text-white">All <span data-ocount="all" class="opacity-70"></span></button>
              <button onclick="filterOrders('ordered', this)" class="tap order-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-500 border border-brand-200">Open <span data-ocount="ordered" class="opacity-70"></span></button>
              <button onclick="filterOrders('completed', this)" class="tap order-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-500 border border-brand-200">Paid <span data-ocount="completed" class="opacity-70"></span></button>
            </div>
            <div class="glass rounded-2xl shadow-soft overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-sm min-w-[760px]">
                  <thead><tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-brand-100">
                    <th class="text-left px-4 sm:px-5 py-3">Order #</th><th class="text-left px-4 sm:px-5 py-3">Customer</th><th class="text-left px-4 sm:px-5 py-3">Phone</th><th class="text-left px-4 sm:px-5 py-3">Waiter</th><th class="text-left px-4 sm:px-5 py-3">Time</th><th class="text-left px-4 sm:px-5 py-3">Status</th><th class="text-right px-4 sm:px-5 py-3">Total</th><th class="text-right px-4 sm:px-5 py-3">Items</th>
                  </tr></thead>
                  <tbody id="ordersBody"><tr><td colspan="8" class="px-5 py-8 text-center text-xs font-bold text-slate-400">Loading&#8230;</td></tr></tbody>
                </table>
              </div>
              <div id="ordersPager" class="border-t border-brand-100"></div>
            </div>
          </div>

          <div id="heldPane" class="hidden">
            <p class="text-xs text-slate-400 font-semibold mb-4">Carts parked with Hold on any till. They are not bills yet, so they carry no order number and are not counted in takings.</p>
            <div class="glass rounded-2xl shadow-soft overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-sm min-w-[760px]">
                  <thead><tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-brand-100">
                    <th class="text-left px-4 sm:px-5 py-3">Hold #</th><th class="text-left px-4 sm:px-5 py-3">Customer</th><th class="text-left px-4 sm:px-5 py-3">Table</th><th class="text-left px-4 sm:px-5 py-3">Waiter</th><th class="text-left px-4 sm:px-5 py-3">Till</th><th class="text-left px-4 sm:px-5 py-3">Held</th><th class="text-right px-4 sm:px-5 py-3">Total</th><th class="text-right px-4 sm:px-5 py-3">Items</th>
                  </tr></thead>
                  <tbody id="heldBody"><tr><td colspan="8" class="px-5 py-8 text-center text-xs font-bold text-slate-400">Loading&#8230;</td></tr></tbody>
                </table>
              </div>
              <div id="heldPager" class="border-t border-brand-100"></div>
            </div>
          </div>
        </div>

        <!-- ===== USERS & ROLES ===== -->
        @* One page, two lists: staff accounts (users) and the roles they sign in as
           (config_role). Add and edit open in the off-canvas drawer below. *@
        <div id="sec-staff" class="section-page">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
            <div class="inline-flex p-1 rounded-xl bg-brand-50 border border-brand-100 self-start">
              <button onclick="setStaffTab('users')" data-stab="users" class="tap staff-tab-btn px-4 py-2 rounded-lg text-xs font-extrabold flex items-center gap-1.5"><i data-lucide="user" class="w-3.5 h-3.5"></i> Users <span id="usersTabCount" class="opacity-70"></span></button>
              <button onclick="setStaffTab('roles')" data-stab="roles" class="tap staff-tab-btn px-4 py-2 rounded-lg text-xs font-extrabold flex items-center gap-1.5"><i data-lucide="shield" class="w-3.5 h-3.5"></i> Roles <span id="rolesTabCount" class="opacity-70"></span></button>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="loadStaffSection(true)" title="Refresh" class="tap w-9 h-9 rounded-xl bg-white border border-brand-200 flex items-center justify-center text-brand-600 hover:bg-brand-50"><i data-lucide="refresh-cw" class="w-4 h-4"></i></button>
              <button id="staffAddBtn" onclick="staffTab === 'users' ? openUserDrawer() : openRoleDrawer()" class="tap px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs flex items-center gap-2 shadow-lift justify-center">
                <i data-lucide="plus" class="w-4 h-4"></i> <span id="staffAddLabel">Add User</span>
              </button>
            </div>
          </div>

          <div id="usersPane">
            <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-2 mb-4">
              <div class="flex flex-wrap items-center gap-2">
                <button onclick="filterUsers('all', this)" class="tap user-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-brand-600 text-white">All <span id="userCountAll" class="opacity-70"></span></button>
                <button onclick="filterUsers('active', this)" class="tap user-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-500 border border-brand-200">Active <span id="userCountActive" class="opacity-70"></span></button>
                <button onclick="filterUsers('inactive', this)" class="tap user-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-500 border border-brand-200">Inactive <span id="userCountInactive" class="opacity-70"></span></button>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <div class="relative flex-1 min-w-[220px]">
                  <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                  <input id="userSearch" oninput="renderUsers()" placeholder="Search name, username or phone&#8230;" class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-brand-200 bg-white text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400">
                </div>
                <select id="userRoleFilter" onchange="renderUsers()" class="px-3 py-2.5 rounded-xl border border-brand-200 bg-white text-xs font-bold text-slate-600 focus:outline-none focus:ring-2 focus:ring-brand-400">
                  <option value="">All roles</option>
                </select>
              </div>
            </div>
            <div class="glass rounded-2xl shadow-soft overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-sm min-w-[760px]">
                  <thead><tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-brand-100">
                    <th class="text-left px-4 sm:px-5 py-3">User</th><th class="text-left px-4 sm:px-5 py-3">Phone</th><th class="text-left px-4 sm:px-5 py-3">Role</th><th class="text-left px-4 sm:px-5 py-3">Last Sign-in</th><th class="text-center px-4 sm:px-5 py-3">Active</th><th class="text-right px-4 sm:px-5 py-3">Action</th>
                  </tr></thead>
                  <tbody id="usersBody"><tr><td colspan="6" class="px-5 py-8 text-center text-xs font-bold text-slate-400">Loading&#8230;</td></tr></tbody>
                </table>
              </div>
            </div>
          </div>

          <div id="rolesPane" class="hidden">
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <button onclick="filterRoles('all', this)" class="tap role-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-brand-600 text-white">All <span id="roleCountAll" class="opacity-70"></span></button>
              <button onclick="filterRoles('active', this)" class="tap role-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-500 border border-brand-200">Active <span id="roleCountActive" class="opacity-70"></span></button>
              <button onclick="filterRoles('inactive', this)" class="tap role-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-500 border border-brand-200">Inactive <span id="roleCountInactive" class="opacity-70"></span></button>
            </div>
            <p class="text-xs text-slate-400 font-semibold mb-4">A role decides where its staff land after sign-in. Admin and Supervisor can open this panel; every other role opens Billing POS. Waiters do not sign in at all - they are only picked on the bill in the till's waiter list. Switching a role off stops its staff from signing in (or, for Waiter, hides them from the picker). Built-in roles can be renamed but not deleted.</p>
            <div class="glass rounded-2xl shadow-soft overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-sm min-w-[680px]">
                  <thead><tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-brand-100">
                    <th class="text-left px-4 sm:px-5 py-3">Role</th><th class="text-left px-4 sm:px-5 py-3">Code</th><th class="text-left px-4 sm:px-5 py-3">Access</th><th class="text-right px-4 sm:px-5 py-3">Users</th><th class="text-center px-4 sm:px-5 py-3">Active</th><th class="text-right px-4 sm:px-5 py-3">Action</th>
                  </tr></thead>
                  <tbody id="rolesBody"><tr><td colspan="6" class="px-5 py-8 text-center text-xs font-bold text-slate-400">Loading&#8230;</td></tr></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== ATTENDANCE ===== -->
        @* One trading day of staff_attendance: sign-ins for admins, supervisors and
           cashiers, punches for waiters. Hours are first in to last out. *@
        <div id="sec-attendance" class="section-page">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
            <div class="flex flex-wrap items-center gap-2">
              <button onclick="filterAttendance('all', this)" class="tap att-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-brand-600 text-white">All <span data-acount="all" class="opacity-70"></span></button>
              <button onclick="filterAttendance('LOGIN', this)" class="tap att-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-500 border border-brand-200">Sign-ins <span data-acount="LOGIN" class="opacity-70"></span></button>
              <button onclick="filterAttendance('PUNCH', this)" class="tap att-filter-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-500 border border-brand-200">Waiters <span data-acount="PUNCH" class="opacity-70"></span></button>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="shiftAttendanceDate(-1)" title="Previous day" class="tap w-9 h-9 rounded-xl bg-white border border-brand-200 flex items-center justify-center text-brand-600 hover:bg-brand-50"><i data-lucide="chevron-left" class="w-4 h-4"></i></button>
              <input id="attDate" type="date" required value="@ViewData["Today"]" max="@ViewData["Today"]" onchange="loadAttendance()" class="px-3 py-2 rounded-xl border border-brand-200 bg-white text-xs font-bold text-slate-600 focus:outline-none focus:ring-2 focus:ring-brand-400">
              <button onclick="shiftAttendanceDate(1)" title="Next day" class="tap w-9 h-9 rounded-xl bg-white border border-brand-200 flex items-center justify-center text-brand-600 hover:bg-brand-50"><i data-lucide="chevron-right" class="w-4 h-4"></i></button>
              <button onclick="loadAttendance(true)" title="Refresh" class="tap w-9 h-9 rounded-xl bg-white border border-brand-200 flex items-center justify-center text-brand-600 hover:bg-brand-50"><i data-lucide="refresh-cw" class="w-4 h-4"></i></button>
            </div>
          </div>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-4">
            <div class="glass rounded-2xl p-4 shadow-soft">
              <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Staff in</p>
              <p id="attStaff" class="text-2xl font-extrabold text-brand-950 mt-1">&#8212;</p>
            </div>
            <div class="glass rounded-2xl p-4 shadow-soft">
              <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">On shift now</p>
              <p id="attOnShift" class="text-2xl font-extrabold text-mint-600 mt-1">&#8212;</p>
            </div>
            <div class="glass rounded-2xl p-4 shadow-soft">
              <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total hours</p>
              <p id="attHours" class="text-2xl font-extrabold text-brand-950 mt-1">&#8212;</p>
            </div>
            <div class="glass rounded-2xl p-4 shadow-soft">
              <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">No logout</p>
              <p id="attMissed" class="text-2xl font-extrabold text-amber-600 mt-1">&#8212;</p>
            </div>
          </div>

          <div class="glass rounded-2xl shadow-soft overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-sm min-w-[760px]">
                <thead><tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-brand-100">
                  <th class="text-left px-4 sm:px-5 py-3">Staff</th><th class="text-left px-4 sm:px-5 py-3">Role</th><th class="text-left px-4 sm:px-5 py-3">First In</th><th class="text-left px-4 sm:px-5 py-3">Last Out</th><th class="text-right px-4 sm:px-5 py-3">Hours</th><th class="text-right px-4 sm:px-5 py-3">Times In</th><th class="text-left px-4 sm:px-5 py-3">Status</th>
                </tr></thead>
                <tbody id="attBody"><tr><td colspan="7" class="px-5 py-8 text-center text-xs font-bold text-slate-400">Loading&#8230;</td></tr></tbody>
              </table>
            </div>
          </div>
          <p class="text-xs text-slate-400 font-semibold mt-3">Admins, supervisors and cashiers are clocked by signing in and out (Close Terminal counts as a sign-out). Waiters are punched in and out from the user button on the till. Hours run from the first time in to the last time out, so a break taken by signing out is inside them. "No logout" means the day was never closed; its hours stop at the last time out recorded.</p>
        </div>

        <!-- ===== REPORTS ===== -->
        <div id="sec-reports" class="section-page">
          <!-- range filter -->
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 mb-5">
            <div class="flex flex-wrap gap-2">
              <button onclick="setReportPreset('today')" data-preset="today" class="tap rpt-preset px-3.5 py-2 rounded-xl text-xs font-bold">Today</button>
              <button onclick="setReportPreset('yesterday')" data-preset="yesterday" class="tap rpt-preset px-3.5 py-2 rounded-xl text-xs font-bold">Yesterday</button>
              <button onclick="setReportPreset('week')" data-preset="week" class="tap rpt-preset px-3.5 py-2 rounded-xl text-xs font-bold">Last 7 Days</button>
              <button onclick="setReportPreset('month')" data-preset="month" class="tap rpt-preset px-3.5 py-2 rounded-xl text-xs font-bold">This Month</button>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <label for="rptFrom" class="text-[11px] font-bold text-slate-400 uppercase">From</label>
              <input id="rptFrom" type="date" required value="@ViewData["Today"]" max="@ViewData["Today"]" onchange="onReportDates(this)" class="px-3 py-2 rounded-xl border border-brand-200 bg-white text-xs font-bold text-slate-600 focus:outline-none focus:ring-2 focus:ring-brand-400">
              <label for="rptTo" class="text-[11px] font-bold text-slate-400 uppercase">To</label>
              <input id="rptTo" type="date" required value="@ViewData["Today"]" max="@ViewData["Today"]" onchange="onReportDates(this)" class="px-3 py-2 rounded-xl border border-brand-200 bg-white text-xs font-bold text-slate-600 focus:outline-none focus:ring-2 focus:ring-brand-400">
              <button type="button" onclick="loadReports(true)" title="Refresh from database" class="tap w-9 h-9 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 hover:bg-brand-100 flex-shrink-0">
                <i data-lucide="refresh-cw" class="w-4 h-4"></i><span class="sr-only">Refresh</span>
              </button>
            </div>
          </div>

          <!-- summary -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-5">
            <div class="glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <span class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Revenue</span>
              <p id="rptRevenue" class="text-xl sm:text-2xl font-extrabold text-brand-950 font-digital mt-1">&#8212;</p>
              <p id="rptRevenueNote" class="text-[10px] sm:text-xs font-bold text-slate-400 mt-1">&nbsp;</p>
            </div>
            <div class="glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <span class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Orders</span>
              <p id="rptOrders" class="text-xl sm:text-2xl font-extrabold text-brand-950 font-digital mt-1">&#8212;</p>
              <p class="text-[10px] sm:text-xs font-bold text-slate-400 mt-1">Settled bills</p>
            </div>
            <div class="glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <span class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Avg Order</span>
              <p id="rptAvg" class="text-xl sm:text-2xl font-extrabold text-brand-950 font-digital mt-1">&#8212;</p>
              <p class="text-[10px] sm:text-xs font-bold text-slate-400 mt-1">Per settled bill</p>
            </div>
            <div class="glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <span class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Items Sold</span>
              <p id="rptItems" class="text-xl sm:text-2xl font-extrabold text-brand-950 font-digital mt-1">&#8212;</p>
              <p class="text-[10px] sm:text-xs font-bold text-slate-400 mt-1">Excluding FOC</p>
            </div>
          </div>

          <!-- hourly trend -->
          <div class="glass rounded-2xl p-4 sm:p-5 shadow-soft mb-5">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-4">
              <div>
                <h3 class="text-sm font-extrabold text-brand-950">Hourly Trend</h3>
                <p id="rptHourlySub" class="text-xs text-slate-400 font-semibold">By the hour the bill was rung</p>
              </div>
              <span class="text-[11px] font-bold text-slate-500">Bar height = amount</span>
            </div>
            <div class="overflow-x-auto">
              <div id="rptHourly" class="min-w-[480px]"></div>
            </div>
          </div>

          <!-- breakdowns -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 sm:gap-4">
            <div class="glass rounded-2xl p-4 sm:p-5 shadow-soft">
              <h3 class="text-sm font-extrabold text-brand-950 mb-1">Category Breakdown</h3>
              <p class="text-xs text-slate-400 font-semibold mb-4">Line value before discount, service charge and tax</p>
              <div class="space-y-3" id="rptCategories"></div>
            </div>
            <div class="glass rounded-2xl shadow-soft overflow-hidden">
              <div class="px-4 sm:px-5 pt-4 sm:pt-5 pb-3">
                <h3 class="text-sm font-extrabold text-brand-950 mb-1">Cashier Wise</h3>
                <p class="text-xs text-slate-400 font-semibold">Who took the payment</p>
              </div>
              <table class="w-full text-sm">
                <thead><tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-y border-brand-100">
                  <th class="text-left px-4 sm:px-5 py-2.5">Cashier</th><th class="text-right px-3 py-2.5">Orders</th><th class="text-right px-4 sm:px-5 py-2.5">Amount</th>
                </tr></thead>
                <tbody id="rptCashiers"></tbody>
              </table>
            </div>
            <div class="glass rounded-2xl shadow-soft overflow-hidden">
              <div class="px-4 sm:px-5 pt-4 sm:pt-5 pb-3">
                <h3 class="text-sm font-extrabold text-brand-950 mb-1">Waiter Wise</h3>
                <p class="text-xs text-slate-400 font-semibold">Waiter picked on the bill</p>
              </div>
              <table class="w-full text-sm">
                <thead><tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-y border-brand-100">
                  <th class="text-left px-4 sm:px-5 py-2.5">Waiter</th><th class="text-right px-3 py-2.5">Orders</th><th class="text-right px-3 py-2.5">Pax</th><th class="text-right px-4 sm:px-5 py-2.5">Amount</th>
                </tr></thead>
                <tbody id="rptWaiters"></tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ===== SETTINGS ===== -->
        <div id="sec-settings" class="section-page">
          @{
            var store = (StoreInfo)ViewData["Store"]!;
            // Pos:Country decides the QR scheme: UPI in India, PayNow in Singapore.
            var qrUpi = ShopCountryClock.Country.UsesUpi;
            var qrScheme = ShopCountryClock.Country.QrScheme;
          }
          <div class="space-y-4">

            <div class="glass rounded-2xl p-5 sm:p-6 shadow-soft">
              <h3 class="text-sm font-extrabold text-brand-950 mb-4 flex items-center gap-2"><i data-lucide="store" class="w-4 h-4 text-brand-500"></i> Store Info</h3>
              @* The config_store row. App Name is view only - the seed sets it. *@
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">App Name</label><input value="@store.AppName" readonly tabindex="-1" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-slate-50 text-sm font-semibold text-slate-400 cursor-not-allowed"></div>
                <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Store Name</label><input id="setStoreName" maxlength="100" value="@store.StoreName" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition"></div>
                <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Address</label><input id="setAddress" maxlength="250" value="@store.Address" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition"></div>
                <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Phone</label><input id="setPhone" maxlength="20" value="@store.Phone" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition"></div>
                <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">GST No.</label><input id="setGstNo" maxlength="15" value="@store.GstNo" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition uppercase"></div>
              </div>
            </div>

            <div class="glass rounded-2xl p-5 sm:p-6 shadow-soft">
              <h3 class="text-sm font-extrabold text-brand-950 mb-4 flex items-center gap-2"><i data-lucide="receipt" class="w-4 h-4 text-brand-500"></i> Tax & Billing</h3>
              <div class="space-y-3">
                @* Service charge and tax are config_terminal_setting rows; currency and
                   PayNow are on config_store. The two toggles below are still placeholder markup. *@
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Service Charge (%)</label><input id="setServiceCharge" type="number" min="0" max="100" step="0.01" value="@ViewData["ServiceChargePercent"]" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition"></div>
                  <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Tax Rate (%)</label><input id="setGst" type="number" min="0" max="100" step="0.01" value="@ViewData["GstPercent"]" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition"></div>
                  <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Currency</label>
                    <select id="setCurrency" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition">
                      <option value="">Country default (@ShopCountryClock.Country.CurrencySymbol @ShopCountryClock.Country.CurrencyCode)</option>
                      @foreach (var c in Kiosk.Services.CurrencyOptions.All)
                      {
                        <option value="@c.Symbol" selected="@(c.Symbol == store.CurrencySymbol)">@c.Label</option>
                      }
                    </select></div>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">Applies to every till, the customer screen and this panel on their next page load.</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div class="flex items-center justify-between p-3 sm:p-4 bg-brand-25 rounded-xl border border-brand-100 gap-4">
                    <div class="min-w-0"><p class="text-sm font-bold text-brand-950">Print Receipt Automatically</p><p class="text-xs text-slate-400">Print after every completed order</p></div>
                    <button onclick="this.dataset.on = this.dataset.on==='1'?'0':'1'; this.classList.toggle('bg-brand-600'); this.classList.toggle('bg-slate-300'); this.querySelector('span').classList.toggle('translate-x-5')" data-on="1" class="w-11 h-6 rounded-full bg-brand-600 relative transition-colors flex-shrink-0"><span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform translate-x-5"></span></button>
                  </div>
                  <div class="flex items-center justify-between p-3 sm:p-4 bg-brand-25 rounded-xl border border-brand-100 gap-4">
                    <div class="min-w-0"><p class="text-sm font-bold text-brand-950">Sound Effects</p><p class="text-xs text-slate-400">Beep sounds on actions</p></div>
                    <button onclick="this.dataset.on = this.dataset.on==='1'?'0':'1'; this.classList.toggle('bg-brand-600'); this.classList.toggle('bg-slate-300'); this.querySelector('span').classList.toggle('translate-x-5')" data-on="1" class="w-11 h-6 rounded-full bg-brand-600 relative transition-colors flex-shrink-0"><span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform translate-x-5"></span></button>
                  </div>
                </div>
              </div>
            </div>

            <div class="glass rounded-2xl p-5 sm:p-6 shadow-soft">
              <h3 class="text-sm font-extrabold text-brand-950 mb-4 flex items-center gap-2"><i data-lucide="qr-code" class="w-4 h-4 text-brand-500"></i> @qrScheme QR <span class="text-xs font-semibold text-slate-400">&middot; @ShopCountryClock.Country.Name</span></h3>
              <div class="space-y-3">
                <div class="flex items-center justify-between p-3 sm:p-4 bg-brand-25 rounded-xl border border-brand-100 gap-4">
                  <div class="min-w-0"><p class="text-sm font-bold text-brand-950">Show on customer screen</p><p class="text-xs text-slate-400">Splits the customer display and shows a scannable @qrScheme QR for the amount due</p></div>
                  <button id="setPayNowEnabled" type="button" onclick="setPayNowToggle(this.dataset.on !== '1')" data-on="@(store.PayNowEnabled ? "1" : "0")" class="w-11 h-6 rounded-full @(store.PayNowEnabled ? "bg-brand-600" : "bg-slate-300") relative transition-colors flex-shrink-0"><span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform @(store.PayNowEnabled ? "translate-x-5" : "")"></span></button>
                </div>
                @if (qrUpi)
                {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <input type="hidden" id="setPayNowType" value="upi">
                  <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">UPI ID</label><input id="setPayNowProxy" maxlength="60" value="@store.PayNowProxy" placeholder="myshop@okaxis" autocomplete="off" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold font-mono focus:outline-none focus:ring-2 focus:ring-brand-400 transition"><p class="text-xs text-slate-400 mt-1">The shop's UPI ID (VPA) that receives the payment.</p></div>
                  <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Payee name</label><input id="setPayNowMerchant" maxlength="25" value="@store.PayNowMerchantName" placeholder="MY SHOP" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition"><p class="text-xs text-slate-400 mt-1">Shown in the customer's UPI app. Max 25 characters.</p></div>
                </div>
                }
                else
                {
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Registered to</label>
                    <select id="setPayNowType" onchange="renderPayNowHint()" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition">
                      <option value="uen" selected="@(store.PayNowType != "mobile")">UEN</option>
                      <option value="mobile" selected="@(store.PayNowType == "mobile")">Mobile</option>
                    </select></div>
                  <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">UEN / Mobile</label><input id="setPayNowProxy" maxlength="20" value="@store.PayNowProxy" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold font-mono focus:outline-none focus:ring-2 focus:ring-brand-400 transition"><p id="payNowHint" class="text-xs text-slate-400 mt-1"></p></div>
                  <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Business name on QR</label><input id="setPayNowMerchant" maxlength="25" value="@store.PayNowMerchantName" placeholder="MY SHOP PTE LTD" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition"><p class="text-xs text-slate-400 mt-1">Shown in the customer's banking app. Max 25 characters.</p></div>
                </div>
                }
              </div>
            </div>

            <button id="saveSettingsBtn" onclick="saveCharges()" class="tap px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-lift flex items-center gap-2 w-full sm:w-auto justify-center">
              <i data-lucide="save" class="w-4 h-4"></i> Save Settings
            </button>
          </div>
        </div>

      </div>
    </main>
  </div>

  <!-- ========== ADD MENU ITEM MODAL ========== -->
  <div id="menuModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="glass-strong rounded-2xl shadow-lift w-full max-w-lg p-5 sm:p-6 fade-in max-h-[95vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-5">
        <h3 id="itemModalTitle" class="text-lg font-extrabold text-brand-950">Add Menu Item</h3>
        <button onclick="closeMenuModal()" class="tap w-8 h-8 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 hover:bg-brand-100"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>
      <div class="space-y-3">
        <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Item Name</label><input id="itemName" maxlength="80" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition" placeholder="e.g. Masala Dosa"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Price (<span class="till-currency"></span>)</label><input id="itemPrice" type="number" min="0.01" step="0.01" inputmode="decimal" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition" placeholder="4.50"></div>
          <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Type</label>
            <div class="grid grid-cols-2 gap-1.5">
              <button type="button" id="itemVegBtn" onclick="setItemVeg(true)" class="tap py-3 rounded-xl border text-xs font-extrabold flex items-center justify-center gap-1.5"><span class="w-3 h-3 rounded-[3px] border-[1.5px] border-emerald-600 flex items-center justify-center"><span class="w-1 h-1 rounded-full bg-emerald-600"></span></span>Veg</button>
              <button type="button" id="itemNonVegBtn" onclick="setItemVeg(false)" class="tap py-3 rounded-xl border text-xs font-extrabold flex items-center justify-center gap-1.5"><span class="w-3 h-3 rounded-[3px] border-[1.5px] border-rose-600 flex items-center justify-center"><span class="w-1 h-1 rounded-full bg-rose-600"></span></span>Non-veg</button>
            </div>
          </div>
        </div>
        <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Category</label>
          <select id="itemCat" onchange="updateItemHint()" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition"></select>
        </div>
        <label class="flex items-center justify-between p-3 bg-brand-25 rounded-xl border border-brand-100 gap-4 cursor-pointer">
          <span class="min-w-0"><span class="block text-sm font-bold text-brand-950">Active</span><span class="block text-xs text-slate-400">Shown on the POS</span></span>
          <input id="itemActive" type="checkbox" class="w-5 h-5 accent-brand-600" checked>
        </label>
        <p id="itemHint" class="hidden text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-xl px-3 py-2 font-semibold"></p>
        <button id="itemSaveBtn" onclick="saveMenuItem()" class="tap w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-lift flex items-center justify-center gap-2"><i data-lucide="save" class="w-4 h-4"></i> <span id="itemSaveLabel">Add Item</span></button>
      </div>
    </div>
  </div>

  <!-- ========== ADD CATEGORY MODAL ========== -->
  <div id="categoryModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="glass-strong rounded-2xl shadow-lift w-full max-w-lg p-5 sm:p-6 fade-in max-h-[95vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-5">
        <h3 id="catModalTitle" class="text-lg font-extrabold text-brand-950">Add Category</h3>
        <button onclick="closeCategoryModal()" class="tap w-8 h-8 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 hover:bg-brand-100"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>
      <div class="space-y-3">
        <div class="flex items-end gap-3">
          <div class="flex-1 min-w-0"><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Category Name</label><input id="newCatName" maxlength="40" oninput="renderCatPreview()" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition" placeholder="e.g. Juices"></div>
          @* Live preview of the till's rail tile - selected and unselected - in the chosen colour. *@
          <div class="flex gap-1.5 flex-shrink-0" title="How it looks on the POS">
            <div id="catPreviewOn"  class="w-[68px] rounded-2xl py-2 px-1 flex flex-col items-center gap-1 border border-brand-300 bg-brand-50"></div>
            <div id="catPreviewOff" class="w-[68px] rounded-2xl py-2 px-1 flex flex-col items-center gap-1 border border-slate-100 bg-white"></div>
          </div>
        </div>
        <div>
          <label class="flex items-center justify-between text-xs font-bold text-slate-400 uppercase mb-1">
            Colour
            <button type="button" onclick="randomCatColor(true)" class="tap normal-case inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-brand-50 text-brand-700 hover:bg-brand-100 text-[11px] font-bold"><i data-lucide="shuffle" class="w-3 h-3"></i> Random</button>
          </label>
          <div id="catColorPicker" class="grid grid-cols-10 gap-1.5"></div>
        </div>
        <div>
          <label class="flex items-center justify-between text-xs font-bold text-slate-400 uppercase mb-1">Icon <span id="catIconName" class="normal-case font-mono text-brand-600"></span></label>
          <div id="catIconPicker" class="max-h-64 overflow-y-auto pr-1 p-2 rounded-xl border border-brand-100"></div>
        </div>
        <button id="addCategoryBtn" onclick="saveCategory()" class="tap w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-lift flex items-center justify-center gap-2"><i data-lucide="save" class="w-4 h-4"></i> <span id="catSaveLabel">Add Category</span></button>
      </div>
    </div>
  </div>

  <!-- ========== ADD / EDIT TRANSACTION MODE MODAL ========== -->
  <div id="modeModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="glass-strong rounded-2xl shadow-lift w-full max-w-md p-5 sm:p-6 fade-in">
      <div class="flex items-center justify-between mb-5">
        <h3 id="modeModalTitle" class="text-lg font-extrabold text-brand-950">Add Transaction Mode</h3>
        <button onclick="closeModeModal()" class="tap w-8 h-8 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 hover:bg-brand-100"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>
      <div class="space-y-3">
        <div><label class="block text-xs font-bold text-slate-400 uppercase mb-1">Mode Name</label><input id="modeName" maxlength="30" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold uppercase focus:outline-none focus:ring-2 focus:ring-brand-400 transition" placeholder="e.g. PAYNOW"></div>
        <div><label for="modeSort" class="block text-xs font-bold text-slate-400 uppercase mb-1">Order</label><input id="modeSort" type="number" min="0" max="999" step="1" inputmode="numeric" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition" placeholder="Last"></div>
        <p class="text-[11px] text-slate-400 font-semibold -mt-1">Lowest first in the till's payment list. Leave blank on a new mode to add it at the end.</p>
        <button id="modeSaveBtn" onclick="saveMode()" class="tap w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-lift flex items-center justify-center gap-2"><i data-lucide="save" class="w-4 h-4"></i> <span id="modeSaveLabel">Add Mode</span></button>
      </div>
    </div>
  </div>

  <!-- ========== CONFIRM DELETE MODAL ========== -->
  <div id="confirmModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="glass-strong rounded-2xl shadow-lift w-full max-w-sm p-5 sm:p-6 fade-in text-center">
      <div class="w-12 h-12 mx-auto rounded-full bg-rose-50 flex items-center justify-center text-rose-500 mb-3"><i data-lucide="trash-2" class="w-5 h-5"></i></div>
      <h3 id="confirmTitle" class="text-base font-extrabold text-brand-950">Delete?</h3>
      <p id="confirmMsg" class="text-sm text-slate-500 font-semibold mt-1"></p>
      <div class="mt-5 grid grid-cols-2 gap-2">
        <button onclick="closeConfirm()" class="tap py-2.5 rounded-xl bg-brand-50 text-brand-700 font-bold text-sm hover:bg-brand-100">Cancel</button>
        <button id="confirmOkBtn" class="tap py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm">Delete</button>
      </div>
    </div>
  </div>

  <!-- ========== ORDER / HOLD ITEMS MODAL ========== -->
  <div id="orderViewModal" onclick="if (event.target === this) closeOrderView()" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="glass-strong rounded-2xl shadow-lift w-full max-w-lg max-h-[90vh] flex flex-col fade-in">
      <div class="flex items-start justify-between gap-3 p-5 sm:p-6 pb-3 border-b border-brand-100">
        <div class="min-w-0">
          <h3 id="ovTitle" class="text-lg font-extrabold text-brand-950"></h3>
          <p id="ovSub" class="text-xs font-semibold text-slate-400 mt-0.5"></p>
        </div>
        <button onclick="closeOrderView()" class="tap w-8 h-8 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 hover:bg-brand-100 flex-shrink-0"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>
      <div id="ovBody" class="p-5 sm:p-6 pt-4 overflow-y-auto"></div>
    </div>
  </div>

  <!-- ========== USERS & ROLES OFF-CANVAS ========== -->
  @* One right-hand drawer shared by both lists; data-pane picks the user or role form. *@
  <div id="staffDrawerBackdrop" onclick="closeStaffDrawer()" class="offcanvas-backdrop fixed inset-0 z-40 bg-black/40 backdrop-blur-sm"></div>
  <aside id="staffDrawer" role="dialog" aria-modal="true" aria-labelledby="drawerTitle" data-pane="user"
         class="offcanvas fixed top-0 right-0 bottom-0 z-50 w-full sm:w-[440px] bg-white shadow-lift flex flex-col">
    <div class="flex items-start justify-between gap-3 px-5 sm:px-6 py-4 border-b border-brand-100">
      <div class="min-w-0">
        <h3 id="drawerTitle" class="text-lg font-extrabold text-brand-950">Add User</h3>
        <p id="drawerSub" class="text-xs font-semibold text-slate-400 mt-0.5"></p>
      </div>
      <button onclick="closeStaffDrawer()" class="tap w-8 h-8 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 hover:bg-brand-100 flex-shrink-0"><i data-lucide="x" class="w-4 h-4"></i></button>
    </div>

    <div class="flex-1 overflow-y-auto px-5 sm:px-6 py-5">
      <!-- user form -->
      <div data-form="user" class="space-y-3">
        <div><label for="uName" class="block text-xs font-bold text-slate-400 uppercase mb-1">Full Name</label><input id="uName" maxlength="100" autocomplete="off" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition" placeholder="e.g. Priya S"></div>
        <div id="uIdRow" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div id="uUsernameWrap"><label for="uUsername" class="block text-xs font-bold text-slate-400 uppercase mb-1">Username</label><input id="uUsername" maxlength="50" autocomplete="off" autocapitalize="none" spellcheck="false" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold font-mono lowercase focus:outline-none focus:ring-2 focus:ring-brand-400 transition" placeholder="priya"></div>
          <div><label for="uPhone" class="block text-xs font-bold text-slate-400 uppercase mb-1">Phone <span class="normal-case font-semibold">(optional)</span></label><input id="uPhone" type="tel" inputmode="tel" maxlength="25" autocomplete="off" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition" placeholder="98765 43210"></div>
        </div>
        <p id="uSignInHint" class="text-[11px] text-slate-400 font-semibold -mt-1">Staff sign in with either the username or the phone number.</p>
        <div id="uPwdWrap">
          <label for="uPassword" class="block text-xs font-bold text-slate-400 uppercase mb-1">Password</label>
          <div class="relative">
            <input id="uPassword" type="password" maxlength="100" autocomplete="new-password" class="w-full pl-4 pr-11 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition" placeholder="At least 4 characters">
            <button type="button" onclick="togglePwd()" title="Show / hide" class="tap absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-lg text-slate-400 hover:text-brand-600 flex items-center justify-center"><i id="uPwdIcon" data-lucide="eye" class="w-4 h-4"></i></button>
          </div>
          <p id="uPwdHint" class="hidden text-[11px] text-slate-400 font-semibold mt-1">Leave blank to keep the current password.</p>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Role</label>
          <div id="uRolePicker" class="grid grid-cols-2 gap-2"></div>
        </div>
        <label class="flex items-center justify-between p-3 bg-brand-25 rounded-xl border border-brand-100 gap-4 cursor-pointer">
          <span class="min-w-0"><span class="block text-sm font-bold text-brand-950">Active</span><span id="uActiveSub" class="block text-xs text-slate-400">Can sign in</span></span>
          <input id="uActive" type="checkbox" class="w-5 h-5 accent-brand-600" checked>
        </label>
        <p id="uNote" class="hidden text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-xl px-3 py-2 font-semibold"></p>
      </div>

      <!-- role form -->
      <div data-form="role" class="space-y-3">
        <div><label for="rName" class="block text-xs font-bold text-slate-400 uppercase mb-1">Role Name</label><input id="rName" maxlength="50" autocomplete="off" oninput="suggestRoleCode()" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition" placeholder="e.g. Kitchen"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label for="rCode" class="block text-xs font-bold text-slate-400 uppercase mb-1">Code</label><input id="rCode" maxlength="20" autocomplete="off" spellcheck="false" oninput="this.dataset.touched='1'; this.value = this.value.toUpperCase().replace(/[^A-Z0-9_]/g,'')" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold font-mono uppercase focus:outline-none focus:ring-2 focus:ring-brand-400 transition disabled:bg-slate-50 disabled:text-slate-400 disabled:cursor-not-allowed" placeholder="KITCHEN"></div>
          <div><label for="rSort" class="block text-xs font-bold text-slate-400 uppercase mb-1">Order</label><input id="rSort" type="number" min="0" max="999" step="1" inputmode="numeric" class="w-full px-4 py-3 rounded-xl border border-brand-200 bg-brand-25 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-400 transition"></div>
        </div>
        <p id="rCodeHint" class="text-[11px] text-slate-400 font-semibold -mt-1">The code is fixed once saved: sign-in and permissions match on it.</p>
        <div id="rAccess" class="p-3 rounded-xl border text-xs font-semibold"></div>
        <div id="rUsersWrap" class="hidden">
          <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Users on this role</label>
          <div id="rUsers" class="flex flex-wrap gap-1.5"></div>
        </div>
      </div>
    </div>

    <div class="px-5 sm:px-6 py-4 border-t border-brand-100 grid grid-cols-2 gap-2">
      <button onclick="closeStaffDrawer()" class="tap py-3 rounded-xl bg-brand-50 text-brand-700 font-bold text-sm hover:bg-brand-100">Cancel</button>
      <button id="drawerSaveBtn" onclick="saveStaffDrawer()" class="tap py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-lift flex items-center justify-center gap-2 disabled:opacity-60"><i data-lucide="save" class="w-4 h-4"></i> <span id="drawerSaveLabel">Save</span></button>
    </div>
  </aside>

  <!-- ========== TOAST (FIXED) ========== -->
  <div id="toast" class="fixed top-4 left-1/2 -translate-x-1/2 sm:left-auto sm:translate-x-0 sm:right-6 sm:top-5 z-[200] pointer-events-none" style="opacity:0">
    <div class="pointer-events-auto flex items-center gap-2.5 px-5 py-3.5 rounded-2xl bg-brand-950 text-white text-sm font-bold shadow-lift border border-brand-800 min-w-[220px] max-w-[90vw] sm:max-w-sm">
      <div id="toastIcon" class="w-7 h-7 rounded-full bg-mint-500/20 flex items-center justify-center flex-shrink-0">
        <svg id="toastSvg" class="w-4 h-4 text-mint-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <span id="toastMsg" class="leading-snug"></span>
    </div>
  </div>

  <script>
    // ===================== ICONS =====================
    function drawIcons() { try { if (window.lucide) lucide.createIcons(); } catch(e){} }

    // POST, so a prefetch or a mistyped URL cannot sign the panel out.
    // Chrome lets a page close its own window only while that window's history holds
    // a single entry. A plain form submit adds one, and the login screen's Close
    // Terminal is then refused wherever the server has no window to close, so the
    // sign-out replaces this page instead of adding to the history.
    async function signOut() {
      playBeep('click');
      const form = document.getElementById('logoutForm');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (res.ok) { window.location.replace(res.url); return; }
      } catch { /* fall through and let the browser show what went wrong */ }
      form.submit();
    }

    // ===================== CLOCK =====================
    function tickClock() {
      const d = new Date();
      document.getElementById('liveClock').textContent = shopTime(d, { seconds: true });
    }
    setInterval(tickClock, 1000);

    // ===================== SIDEBAR TOGGLE =====================
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('open');
      document.getElementById('sidebarOverlay').classList.toggle('open');
    }

    // ===================== NAVIGATION =====================
    const sectionMeta = {
      dashboard: { title:'Dashboard', sub:'Overview of today\'s performance' },
      categories:{ title:'Categories', sub:'Categories shown on the POS' },
      transactionmodes:{ title:'Transaction Modes', sub:'The modes offered on cash in and cash out entries' },
      menu:      { title:'Menu Items', sub:'Manage your menu catalogue' },
      orders:    { title:'Orders', sub:'Track and manage all orders' },
      staff:     { title:'Users & Roles', sub:'Staff accounts and what they can open' },
      attendance:{ title:'Attendance', sub:'Who worked each day, first in, last out and hours' },
      reports:   { title:'Reports', sub:'Sales analytics and insights' },
      settings:  { title:'Settings', sub:'Store configuration' },
    };
    function showSection(id) {
      document.querySelectorAll('.section-page').forEach(s => s.classList.remove('active'));
      const sec = document.getElementById('sec-'+id);
      sec.classList.add('active');
      sec.classList.remove('fade-in');
      void sec.offsetWidth;
      sec.classList.add('fade-in');

      document.querySelectorAll('.nav-item').forEach(n => { n.classList.remove('active'); n.classList.add('text-slate-500'); });
      const active = document.querySelector(`[data-nav="${id}"]`);
      active.classList.add('active'); active.classList.remove('text-slate-500');

      document.getElementById('pageTitle').textContent = sectionMeta[id].title;
      document.getElementById('pageSubtitle').textContent = sectionMeta[id].sub;

      // The button only refreshes the dashboard, so it is not offered on sections it
      // would do nothing for. Returning re-reads, since the figures have aged.
      document.getElementById('refreshWrap').classList.toggle('hidden', id !== 'dashboard');
      if (id === 'dashboard') loadDashboard();
      if (id === 'categories') loadCategories();
      if (id === 'transactionmodes') loadModes();
      if (id === 'menu') loadMenu();
      if (id === 'orders') loadOrdersSection();
      if (id === 'staff') loadStaffSection();
      if (id === 'attendance') loadAttendance();
      if (id === 'reports') loadReports();

      playBeep('click');

      // close sidebar on mobile
      if (window.innerWidth < 1024) {
        document.getElementById('sidebar').classList.remove('open');
        document.getElementById('sidebarOverlay').classList.remove('open');
      }
    }

    // ===================== TOAST (FIXED) =====================
    let toastTimer = null;
    function showToast(msg, type = 'success') {
      const t = document.getElementById('toast');
      const icon = document.getElementById('toastIcon');
      const svg = document.getElementById('toastSvg');

      document.getElementById('toastMsg').textContent = msg;

      // icon colors by type
      if (type === 'success') {
        icon.className = 'w-7 h-7 rounded-full bg-mint-500/20 flex items-center justify-center flex-shrink-0';
        svg.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';
        svg.className = 'w-4 h-4 text-mint-400';
      } else if (type === 'error') {
        icon.className = 'w-7 h-7 rounded-full bg-rose-500/20 flex items-center justify-center flex-shrink-0';
        svg.innerHTML = '<line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>';
        svg.className = 'w-4 h-4 text-rose-400';
      }

      // clear previous
      clearTimeout(toastTimer);
      t.classList.remove('toast-visible','toast-hidden');
      t.style.opacity = '';
      void t.offsetWidth; // reflow

      t.classList.add('toast-visible');
      playBeep(type === 'error' ? 'error' : 'success');

      toastTimer = setTimeout(() => {
        t.classList.remove('toast-visible');
        t.classList.add('toast-hidden');
        setTimeout(() => { t.classList.remove('toast-hidden'); t.style.opacity = '0'; }, 300);
      }, 2800);
    }

    // ===================== RENDER FUNCTIONS =====================

    // ===================== DASHBOARD: LIVE DATA =====================
    // The dashboard holds no figures of its own: every number, bar and row below
    // comes from the API. That keeps the panel honest when a bill is rung on
    // another till, and means a stale screen is one refresh away from correct.
    const DASH_ENDPOINT   = '@Url.Action("Dashboard", "Admin")';
    const DASH_REFRESH_MS = 60000;

    let DASH = null;
    let dashInFlight = false;

    const rupees  = n => SHOP_TIME.currency + shopNumber(Math.round(Number(n) || 0));
    const setText = (id, v) => { document.getElementById(id).textContent = v; };

    // Names, table numbers and item names are typed in by staff, so they are
    // escaped before going back into innerHTML.
    function esc(v) {
      return String(v === null || v === undefined ? '' : v)
        .replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
    }

    // Worked out from the UTC timestamp, so it reads correctly even on a browser
    // whose clock is set to a different zone than the till's.
    function timeAgo(utcIso) {
      const t = shopParse(utcIso);
      if (isNaN(t.getTime())) return '';
      const mins = Math.floor((Date.now() - t.getTime()) / 60000);
      if (mins < 1)  return 'just now';
      if (mins < 60) return mins + ' min ago';
      const hrs = mins / 60;
      if (hrs < 24)  return (hrs < 10 ? hrs.toFixed(1) : Math.round(hrs)) + ' hr ago';
      return Math.round(hrs / 24) + ' d ago';
    }

    function emptyNote(msg) {
      return `<p class="w-full text-center text-xs font-bold text-slate-400 py-6">${msg}</p>`;
    }

    async function loadDashboard(manual = false) {
      if (dashInFlight) return;
      dashInFlight = true;

      const btn = document.getElementById('refreshBtn');
      btn.dataset.loading = '1';
      if (manual) playBeep('click');

      try {
        const res = await fetch(DASH_ENDPOINT, {
          headers: { 'Accept': 'application/json' },
          cache: 'no-store'
        });

        // A redirect to the login page means the cookie expired while the panel sat
        // open. Reloading hands it to the login flow rather than parsing login HTML
        // as figures.
        if (res.redirected || res.status === 401 || res.status === 403) {
          location.reload();
          return;
        }
        if (!res.ok) throw new Error('HTTP ' + res.status);

        DASH = await res.json();
        renderKpis();
        renderHourlyChart();
        renderTopSellers();
        renderRecentOrders();
        drawIcons();
        setText('syncedAt', 'Synced ' + shopTime(new Date()));
        if (manual) showToast('Dashboard refreshed');
      } catch (e) {
        setText('syncedAt', 'Sync failed');
        // Only shout when the user asked: a failed background poll keeps the last
        // good figures on screen rather than throwing a toast at an idle counter.
        if (manual) showToast('Could not reach the database', 'error');
      } finally {
        dashInFlight = false;
        delete btn.dataset.loading;
      }
    }

    // Dashboard: KPI cards
    function renderKpis() {
      if (!DASH) return;

      setText('kpiRevenue', rupees(DASH.revenue.value));
      const rev = document.getElementById('kpiRevenueNote');
      const pct = DASH.revenue.deltaPercent;
      if (pct === null || pct === undefined) {
        // No takings yesterday means there is no honest percentage to quote.
        rev.className = 'text-[10px] sm:text-xs font-bold text-slate-400 mt-1';
        rev.textContent = 'No baseline for yesterday';
      } else {
        const up = pct >= 0;
        rev.className = `text-[10px] sm:text-xs font-bold mt-1 flex items-center gap-1 ${up ? 'text-mint-600' : 'text-rose-600'}`;
        rev.innerHTML = `<i data-lucide="${up ? 'trending-up' : 'trending-down'}" class="w-3 h-3"></i> ${up ? '+' : ''}${pct}% vs yesterday`;
      }

      setText('kpiOrders', DASH.orders.value);
      const ord   = document.getElementById('kpiOrdersNote');
      const delta = DASH.orders.delta;
      const bits  = [];
      if (delta !== null && delta !== undefined) bits.push(`${delta >= 0 ? '+' : ''}${delta} vs yesterday`);
      if (DASH.openOrders > 0) bits.push(`${DASH.openOrders} still open`);
      ord.className = 'text-[10px] sm:text-xs font-bold mt-1 ' +
        (delta === null || delta === undefined ? 'text-slate-400' : delta >= 0 ? 'text-mint-600' : 'text-rose-600');
      ord.textContent = bits.length ? bits.join('  \u00b7  ') : 'Settled bills today';

      setText('kpiAvgOrder', rupees(DASH.avgOrder));

      setText('kpiStaff', DASH.staff.onShift);
      setText('kpiStaffNote', `Signed in today, of ${DASH.staff.active} active`);
    }

    // Dashboard: hourly chart
    function renderHourlyChart() {
      const data = (DASH && DASH.hourly) || [];
      const el = document.getElementById('hourlyChart');
      if (!data.length) { el.innerHTML = emptyNote('No sales rung yet today'); return; }

      // Guard the divisor: an open day with nothing sold would make every bar NaN%.
      const max = Math.max(...data.map(d => Number(d.value) || 0), 1);
      el.innerHTML = data.map((d, i) => {
        const v   = Number(d.value) || 0;
        const h   = Math.round((v / max) * 100);
        const cap = v === 0 ? '' : v >= 1000 ? SHOP_TIME.currency + (v / 1000).toFixed(1) + 'k' : rupees(v);
        return `<div class="flex-1 flex flex-col items-center gap-1" title="${esc(d.label)}: ${rupees(v)}">
          <span class="text-[9px] sm:text-[10px] font-bold text-brand-600">${cap}</span>
          <div class="w-full bg-brand-100 rounded-t-lg overflow-hidden" style="height:120px;display:flex;align-items:flex-end">
            <div class="w-full rounded-t-lg bg-gradient-to-t from-brand-600 to-brand-400 bar-animate" style="--bar-h:${h}%;height:${h}%;animation-delay:${i * .06}s"></div>
          </div>
          <span class="text-[9px] sm:text-[10px] font-bold text-slate-400">${esc(d.label)}</span>
        </div>`;
      }).join('');
    }

    // Dashboard: top sellers
    function renderTopSellers() {
      const items = (DASH && DASH.topSellers) || [];
      const el = document.getElementById('topSellers');
      if (!items.length) { el.innerHTML = emptyNote('Nothing sold yet today'); return; }

      const top = Math.max(...items.map(i => Number(i.qty) || 0), 1);
      el.innerHTML = items.map((it, i) => {
        const pct = Math.round(((Number(it.qty) || 0) / top) * 100);
        return `<div class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-full bg-brand-100 text-brand-700 text-[10px] font-extrabold flex items-center justify-center flex-shrink-0">${i + 1}</span>
          <div class="flex-1 min-w-0">
            <div class="flex justify-between text-xs font-bold"><span class="text-slate-700 truncate">${esc(it.name)}</span><span class="text-brand-600 flex-shrink-0 ml-2">${it.qty} sold</span></div>
            <div class="mt-1 h-1.5 rounded-full bg-brand-100 overflow-hidden"><div class="h-full rounded-full bg-gradient-to-r from-brand-500 to-brand-400 transition-all" style="width:${pct}%"></div></div>
          </div>
        </div>`;
      }).join('');
    }

    // Covers the statuses the till actually writes - "ordered", "completed",
    // "merged" - alongside the kitchen states, so an unknown value still renders.
    const STATUS_STYLE = {
      ordered:   ['bg-amber-50 text-amber-700 border-amber-200',  'open'],
      preparing: ['bg-amber-50 text-amber-700 border-amber-200',  'preparing'],
      ready:     ['bg-sky-50 text-sky-700 border-sky-200',        'ready'],
      completed: ['bg-mint-50 text-mint-700 border-mint-200',     'paid'],
      cancelled: ['bg-rose-50 text-rose-600 border-rose-200',     'cancelled'],
      merged:    ['bg-slate-100 text-slate-500 border-slate-200', 'merged'],
    };
    function statusBadge(s) {
      const [cls, label] = STATUS_STYLE[s] || ['bg-slate-100 text-slate-500 border-slate-200', s || 'unknown'];
      return `<span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold border ${cls} capitalize whitespace-nowrap">${esc(label)}</span>`;
    }

    // Dashboard: recent orders
    function renderRecentOrders() {
      const rows = (DASH && DASH.recent) || [];
      const body = document.getElementById('recentOrdersBody');
      if (!rows.length) {
        body.innerHTML = `<tr><td colspan="5" class="px-5 py-8 text-center text-xs font-bold text-slate-400">No orders yet today</td></tr>`;
        return;
      }
      body.innerHTML = rows.map(o =>
        `<tr class="table-row border-b border-brand-50 last:border-0">
          <td class="px-4 sm:px-5 py-3 font-bold text-brand-700 font-mono">#${String(o.seqNo).padStart(3, '0')}</td>
          <td class="px-4 sm:px-5 py-3 font-semibold text-slate-600">${esc(o.items) || '<span class="text-slate-300">No lines</span>'}</td>
          <td class="px-4 sm:px-5 py-3 text-slate-400 font-semibold whitespace-nowrap" title="${esc(o.localTime)}">${timeAgo(o.createdAt)}</td>
          <td class="px-4 sm:px-5 py-3">${statusBadge(o.status)}</td>
          <td class="px-4 sm:px-5 py-3 text-right font-bold text-brand-950 font-mono">${rupees(o.total)}</td>
        </tr>`
      ).join('');
    }

    // ===================== ORDERS: LIVE DATA =====================
    // Two tables behind two tabs: Orders (bills, picked by trading date) and Held
    // (carts parked on a till right now). The lists carry headers only; a bill's
    // lines are fetched when View is pressed, so items never get squashed into a cell.
    const ORDERS_ENDPOINT = '@Url.Action("Orders", "Admin")';
    const HELD_ENDPOINT   = '@Url.Action("HeldOrders", "Admin")';
    let ORDERS = [];
    let HELD = [];
    let orderTab = 'orders';
    let orderFilter = 'all';
    // Paging is done by the server, so a long history never comes down in one go.
    const PAGE_SIZES = [20, 50, 100];
    let ordersPage = 1, ordersPageSize = 20, ordersMeta = null;
    let heldPage = 1, heldPageSize = 20, heldMeta = null;

    const orderNo = n => '#' + String(n).padStart(3, '0');
    const modeLabel = o => o.orderMode === 'takeaway' ? 'Take Away' : (o.tableNo ? esc(o.tableNo) : 'Dine In');
    const viewBtn = (kind, id) =>
      `<button onclick="openOrderView('${kind}', ${id})" class="tap px-3 py-1.5 rounded-lg bg-brand-50 text-brand-700 text-[11px] font-bold border border-brand-200 hover:bg-brand-100 whitespace-nowrap inline-flex items-center gap-1"><i data-lucide="eye" class="w-3.5 h-3.5"></i> View</button>`;

    // Name with the phone under it; walk-ins usually have no number.
    const customerCell = o =>
      `<p class="font-semibold text-slate-700">${esc(o.customer)}</p>` +
      (o.phone ? `<p class="text-[11px] font-bold text-slate-400 font-mono flex items-center gap-1"><i data-lucide="phone" class="w-3 h-3"></i>${esc(o.phone)}</p>` : '');

    // How a bill was paid, as the cashier would say it. "qr" is the UPI / QR tender.
    const PAY_STYLE = {
      cash:  ['CASH',  'bg-mint-50 text-mint-700 border-mint-500',     'banknote'],
      card:  ['CARD',  'bg-sky-50 text-sky-700 border-sky-500',        'credit-card'],
      qr:    ['UPI',   'bg-brand-50 text-brand-700 border-brand-500', 'qr-code'],
      split: ['SPLIT', 'bg-amber-50 text-amber-700 border-amber-500',  'users'],
    };
    const payBadge = m => {
      const [label, cls, icon] = PAY_STYLE[m] || [String(m || '').toUpperCase(), 'bg-slate-100 text-slate-600 border-slate-300', 'wallet'];
      return `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border-2 ${cls} text-sm font-black tracking-wider uppercase"><i data-lucide="${icon}" class="w-4 h-4"></i>${esc(label)}</span>`;
    };

    function setOrderTab(tab) {
      orderTab = tab;
      document.querySelectorAll('.order-tab-btn').forEach(b => {
        const on = b.dataset.otab === tab;
        b.classList.toggle('bg-white', on); b.classList.toggle('text-brand-700', on); b.classList.toggle('shadow-soft', on);
        b.classList.toggle('text-slate-500', !on);
      });
      document.getElementById('ordersPane').classList.toggle('hidden', tab !== 'orders');
      document.getElementById('heldPane').classList.toggle('hidden', tab !== 'held');
      // Holds are always "right now", so a date picker would only mislead there.
      document.getElementById('ordersDateWrap').classList.toggle('hidden', tab !== 'orders');
    }

    function loadOrdersSection(manual = false) {
      if (manual) playBeep('click');
      return Promise.all([loadOrders(), loadHeld()]);
    }

    async function loadOrders() {
      const date = document.getElementById('ordersDate').value;
      const qs = new URLSearchParams({ status: orderFilter, page: ordersPage, pageSize: ordersPageSize });
      if (date) qs.set('date', date);
      if (phoneQuery()) qs.set('phone', phoneQuery());
      try {
        const data = await catFetch(ORDERS_ENDPOINT + '?' + qs);
        ORDERS = data.orders || [];
        ordersMeta = data;
        ordersPage = data.page; // the server clamps a page that no longer exists
        renderOrders();
      } catch (e) {
        if (e.message !== 'auth')
          document.getElementById('ordersBody').innerHTML = `<tr><td colspan="8" class="px-5 py-8 text-center text-xs font-bold text-rose-500">Could not load orders</td></tr>`;
      }
    }

    async function loadHeld() {
      const qs = new URLSearchParams({ page: heldPage, pageSize: heldPageSize });
      if (phoneQuery()) qs.set('phone', phoneQuery());
      try {
        const data = await catFetch(HELD_ENDPOINT + '?' + qs);
        HELD = data.held || [];
        heldMeta = data;
        heldPage = data.page;
        renderHeld();
      } catch (e) {
        if (e.message !== 'auth')
          document.getElementById('heldBody').innerHTML = `<tr><td colspan="8" class="px-5 py-8 text-center text-xs font-bold text-rose-500">Could not load held orders</td></tr>`;
      }
    }

    // A cleared date box falls back to today: the list is always one day.
    function onOrdersDate() {
      const el = document.getElementById('ordersDate');
      if (!el.value) el.value = '@ViewData["Today"]';
      ordersPage = 1;
      loadOrders();
    }

    // Debounced, so typing a number fires one query rather than one per digit.
    let phoneTimer = null;
    function onPhoneSearch() {
      clearTimeout(phoneTimer);
      phoneTimer = setTimeout(() => { ordersPage = 1; heldPage = 1; loadOrdersSection(); }, 350);
    }
    const phoneQuery = () => document.getElementById('ordersPhone').value.trim();

    function filterOrders(f, btn) {
      orderFilter = f;
      ordersPage = 1;
      document.querySelectorAll('.order-filter-btn').forEach(b => { b.classList.remove('bg-brand-600','text-white'); b.classList.add('bg-white','text-slate-500','border','border-brand-200'); });
      btn.classList.add('bg-brand-600','text-white'); btn.classList.remove('bg-white','text-slate-500','border','border-brand-200');
      playBeep('click');
      loadOrders();
    }

    // Shared pager: "Showing 1-20 of 134", a page-size picker and prev / numbered / next.
    function pagerHtml(kind, meta) {
      if (!meta || !meta.total) return '';
      const { page, pages, pageSize, total } = meta;
      const from = (page - 1) * pageSize + 1, to = Math.min(page * pageSize, total);

      // First, last, and two either side of the current page, with gaps as dots.
      const nums = [];
      for (let p = 1; p <= pages; p++)
        if (p === 1 || p === pages || Math.abs(p - page) <= 2) nums.push(p);
        else if (nums[nums.length - 1] !== '…') nums.push('…');

      const btn = (label, target, { active = false, disabled = false } = {}) =>
        `<button ${disabled ? 'disabled' : `onclick="goPage('${kind}', ${target})"`}
          class="tap min-w-[32px] h-8 px-2 rounded-lg text-xs font-bold border ${active ? 'bg-brand-600 text-white border-brand-600' : 'bg-white text-slate-600 border-brand-200 hover:bg-brand-50'} ${disabled ? 'opacity-40 cursor-not-allowed' : ''}">${label}</button>`;

      return `<div class="flex flex-col sm:flex-row items-center justify-between gap-3 px-4 sm:px-5 py-3">
        <div class="flex items-center gap-2 text-xs font-semibold text-slate-400">
          <span>Showing <b class="text-slate-600">${from}&ndash;${to}</b> of <b class="text-slate-600">${total}</b></span>
          <select onchange="setPageSize('${kind}', this.value)" class="px-2 py-1 rounded-lg border border-brand-200 bg-white text-xs font-bold text-slate-600 focus:outline-none focus:ring-2 focus:ring-brand-400">
            ${PAGE_SIZES.map(n => `<option value="${n}" ${n === pageSize ? 'selected' : ''}>${n} / page</option>`).join('')}
          </select>
        </div>
        <div class="flex items-center gap-1 flex-wrap justify-center">
          ${btn('&lsaquo;', page - 1, { disabled: page <= 1 })}
          ${nums.map(n => n === '…' ? `<span class="px-1 text-xs font-bold text-slate-300">&hellip;</span>` : btn(n, n, { active: n === page })).join('')}
          ${btn('&rsaquo;', page + 1, { disabled: page >= pages })}
        </div>
      </div>`;
    }

    function goPage(kind, p) {
      playBeep('click');
      if (kind === 'held') { heldPage = p; loadHeld(); }
      else { ordersPage = p; loadOrders(); }
    }

    function setPageSize(kind, n) {
      n = Number(n) || 20;
      if (kind === 'held') { heldPageSize = n; heldPage = 1; loadHeld(); }
      else { ordersPageSize = n; ordersPage = 1; loadOrders(); }
    }

    function renderOrders() {
      const c = (ordersMeta && ordersMeta.counts) || {};
      setText('ordersTabCount', c.all ? `(${c.all})` : '');
      document.querySelectorAll('[data-ocount]').forEach(el => {
        const n = c[el.dataset.ocount];
        el.textContent = n ? `(${n})` : '';
      });
      document.getElementById('ordersPager').innerHTML = pagerHtml('orders', ordersMeta);
      const list = ORDERS;
      document.getElementById('ordersBody').innerHTML = list.length ? list.map(o =>
        `<tr class="table-row border-b border-brand-50 last:border-0 ${o.status === 'merged' ? 'opacity-60' : ''}">
          <td class="px-4 sm:px-5 py-3 font-bold text-brand-700 font-mono whitespace-nowrap">${orderNo(o.seqNo)}${o.billType === 'split' ? ' <span class="text-[10px] font-extrabold text-sky-600">SPLIT</span>' : ''}</td>
          <td class="px-4 sm:px-5 py-3 font-semibold text-slate-700">${esc(o.customer)}</td>
          <td class="px-4 sm:px-5 py-3 font-mono text-xs font-bold text-slate-500 whitespace-nowrap">${o.phone ? esc(o.phone) : '<span class="text-slate-300">&mdash;</span>'}</td>
          <td class="px-4 sm:px-5 py-3 text-slate-500 font-semibold">${esc(o.waiter) || '<span class="text-slate-300">&mdash;</span>'}</td>
          <td class="px-4 sm:px-5 py-3 text-slate-400 font-semibold whitespace-nowrap" title="${esc(o.date)} ${esc(o.localTime)}">${esc(o.localTime)}</td>
          <td class="px-4 sm:px-5 py-3">${statusBadge(o.status)}${o.mergedInto ? ` <span class="text-[10px] font-bold text-slate-400">into ${orderNo(o.mergedInto)}</span>` : ''}</td>
          <td class="px-4 sm:px-5 py-3 text-right font-bold text-brand-950 font-mono">${rupees(o.total)}</td>
          <td class="px-4 sm:px-5 py-3 text-right whitespace-nowrap"><span class="text-[11px] font-bold text-slate-400 mr-2">${o.itemCount} qty</span>${viewBtn('order', o.id)}</td>
        </tr>`
      ).join('') : `<tr><td colspan="8" class="px-5 py-8 text-center text-xs font-bold text-slate-400">${phoneQuery() ? 'No orders for that phone number on this date' : 'No orders found'}</td></tr>`;
      drawIcons();
    }

    function renderHeld() {
      const heldTotal = heldMeta ? heldMeta.total : HELD.length;
      setText('heldTabCount', heldTotal ? `(${heldTotal})` : '');
      document.getElementById('heldPager').innerHTML = pagerHtml('held', heldMeta);
      document.getElementById('heldBody').innerHTML = HELD.length ? HELD.map(h =>
        `<tr class="table-row border-b border-brand-50 last:border-0">
          <td class="px-4 sm:px-5 py-3 font-bold text-amber-700 font-mono">H${h.id}</td>
          <td class="px-4 sm:px-5 py-3">${customerCell(h)}</td>
          <td class="px-4 sm:px-5 py-3 text-slate-500 font-semibold whitespace-nowrap">${modeLabel(h)}${h.guests ? ` <span class="text-slate-300">&middot; ${h.guests} pax</span>` : ''}</td>
          <td class="px-4 sm:px-5 py-3 text-slate-500 font-semibold">${esc(h.waiter) || '<span class="text-slate-300">&mdash;</span>'}</td>
          <td class="px-4 sm:px-5 py-3 text-slate-500 font-semibold">${esc(h.terminal) || '<span class="text-slate-300">&mdash;</span>'}</td>
          <td class="px-4 sm:px-5 py-3 text-slate-400 font-semibold whitespace-nowrap" title="${esc(h.businessDate)} ${esc(h.localTime)}">${timeAgo(h.heldAt)}</td>
          <td class="px-4 sm:px-5 py-3 text-right font-bold text-brand-950 font-mono">${rupees(h.total)}</td>
          <td class="px-4 sm:px-5 py-3 text-right whitespace-nowrap"><span class="text-[11px] font-bold text-slate-400 mr-2">${h.itemCount} qty</span>${viewBtn('held', h.id)}</td>
        </tr>`
      ).join('') : `<tr><td colspan="8" class="px-5 py-8 text-center text-xs font-bold text-slate-400">${phoneQuery() ? 'No held orders for that phone number' : 'No orders on hold'}</td></tr>`;
      drawIcons();
    }

    // View dialog: one bill's (or hold's) lines, fetched on demand.
    async function openOrderView(kind, id) {
      playBeep('click');
      const modal = document.getElementById('orderViewModal');
      document.getElementById('ovTitle').textContent = 'Loading…';
      document.getElementById('ovSub').textContent = '';
      document.getElementById('ovBody').innerHTML = emptyNote('Loading items…');
      modal.classList.remove('hidden'); modal.classList.add('flex');
      drawIcons();

      try {
        const d = await catFetch((kind === 'held' ? HELD_ENDPOINT : ORDERS_ENDPOINT) + '/' + id);
        document.getElementById('ovTitle').innerHTML = kind === 'held'
          ? `Hold H${d.id} <span class="ml-1 align-middle px-2 py-0.5 rounded-lg text-[11px] font-extrabold border bg-amber-50 text-amber-700 border-amber-200">on hold</span>`
          : `Order ${orderNo(d.seqNo)} <span class="ml-1 align-middle">${statusBadge(d.status)}</span>`;
        document.getElementById('ovSub').textContent =
          [d.localTime, d.orderMode === 'takeaway' ? 'Take Away' : (d.tableNo ? 'Table ' + d.tableNo : 'Dine In'),
           d.guests ? d.guests + ' pax' : '', d.waiter ? 'Waiter: ' + d.waiter : '', d.terminal]
            .filter(Boolean).join('  ·  ');
        document.getElementById('ovBody').innerHTML = orderViewBody(kind, d);
        drawIcons();
      } catch (e) {
        if (e.message === 'auth') return;
        document.getElementById('ovTitle').textContent = 'Not available';
        document.getElementById('ovBody').innerHTML = `<p class="text-center text-xs font-bold text-rose-500 py-6">${esc(e.message)}</p>`;
        // A hold recalled on a till since the list loaded: take it off the list too.
        if (kind === 'held') loadHeld();
      }
    }

    function orderViewBody(kind, d) {
      const money = n => SHOP_TIME.currency + shopNumber(n, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const lines = (d.items || []).map(i =>
        `<tr class="border-b border-brand-50 last:border-0">
          <td class="py-2 pr-2">
            <p class="font-bold text-slate-700">${esc(i.name)}${i.foc ? ' <span class="text-[10px] font-extrabold text-mint-600">FOC</span>' : ''}</p>
            <p class="text-[10px] font-semibold text-slate-400 font-mono">${esc(i.code)}${i.note ? ` &middot; <span class="font-sans italic">${esc(i.note)}</span>` : ''}</p>
          </td>
          <td class="py-2 px-2 text-center font-bold text-slate-600">${i.qty}</td>
          <td class="py-2 px-2 text-right font-semibold text-slate-500 font-mono">${money(i.price)}</td>
          <td class="py-2 pl-2 text-right font-bold text-brand-950 font-mono">${i.foc ? money(0) : money(i.price * i.qty)}</td>
        </tr>`).join('');

      const row = (label, value, strong) =>
        `<div class="flex justify-between ${strong ? 'text-sm font-extrabold text-brand-950 pt-2 mt-1 border-t border-brand-100' : 'text-xs font-semibold text-slate-500'}"><span>${label}</span><span class="font-mono">${value}</span></div>`;

      let totals = '';
      if (kind === 'held') {
        if (d.discountPercent) totals += row(`Discount (${d.discountPercent}%)`, 'applied on recall');
        totals += row('Total when held', money(d.total), true);
      } else {
        totals += row('Sub total', money(d.subTotal));
        if (d.discountAmount) totals += row(`Discount (${d.discountPercent}%)`, '- ' + money(d.discountAmount));
        if (d.serviceChargeAmount) totals += row(`Service charge (${d.serviceChargePercent}%)`, money(d.serviceChargeAmount));
        if (d.gstAmount) totals += row(`GST (${d.gstPercent}%)`, money(d.gstAmount));
        totals += row('Net total', money(d.total), true);
        if (d.billType === 'split') totals += row('Split between', d.splitCount + ' people');
        const pays = d.payments || [];
        if (pays.length) {
          totals += `<div class="mt-3 p-3 rounded-xl bg-brand-25 border border-brand-200 space-y-2">
            <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Paid by</p>
            ${pays.map(p => `<div class="flex items-center justify-between gap-3">
                ${payBadge(p.method)}
                <div class="text-right">
                  <p class="text-sm font-extrabold text-brand-950 font-mono">${money(p.amount)}</p>
                  ${p.change ? `<p class="text-[10px] font-semibold text-slate-400 font-mono">TENDERED ${money(p.tendered)} &middot; CHANGE ${money(p.change)}</p>` : ''}
                </div>
              </div>`).join('')}
          </div>`;
        } else if (d.status === 'ordered') {
          totals += `<p class="mt-3 text-center text-xs font-extrabold text-amber-700 bg-amber-50 border border-amber-200 rounded-xl py-2 uppercase tracking-wider">Not paid yet</p>`;
        }
        if (d.mergedInto) totals += `<p class="text-[11px] font-bold text-slate-400 mt-2">Merged into ${orderNo(d.mergedInto)} &mdash; these lines are billed there.</p>`;
      }

      const who = `<div class="mb-4 flex items-center justify-between gap-3 p-3 rounded-xl bg-brand-25 border border-brand-100">
          <div class="min-w-0">
            <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Customer</p>
            <p class="text-sm font-extrabold text-brand-950 truncate">${esc(d.customer) || 'Walk-in'}</p>
          </div>
          ${d.phone
            ? `<a href="tel:${esc(d.phone)}" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-brand-200 text-sm font-extrabold text-brand-700 font-mono whitespace-nowrap"><i data-lucide="phone" class="w-4 h-4"></i>${esc(d.phone)}</a>`
            : `<span class="text-xs font-bold text-slate-300">No phone</span>`}
        </div>`;

      return who + `<table class="w-full text-sm">
          <thead><tr class="text-[10px] font-bold text-slate-400 uppercase tracking-wider border-b border-brand-100">
            <th class="text-left pb-2 pr-2">Item</th><th class="text-center pb-2 px-2">Qty</th><th class="text-right pb-2 px-2">Rate</th><th class="text-right pb-2 pl-2">Amount</th>
          </tr></thead>
          <tbody>${lines || '<tr><td colspan="4" class="py-6 text-center text-xs font-bold text-slate-400">No lines on this bill</td></tr>'}</tbody>
        </table>
        <div class="mt-4 space-y-1">${totals}</div>`;
    }

    function closeOrderView() {
      const modal = document.getElementById('orderViewModal');
      modal.classList.add('hidden'); modal.classList.remove('flex');
    }

    // ===================== REPORTS =====================
    // One range of trading dates at a time, today by default. Presets are worked
    // out from the server's trading day, not the browser clock, so a back-office PC
    // set to another zone still means the cafe's "today".
    const REPORTS_ENDPOINT = '@Url.Action("Reports", "Admin")';
    const RPT_TODAY = '@ViewData["Today"]';
    let rptSeq = 0;

    // Plain yyyy-mm-dd arithmetic in UTC, so no local timezone can shift a day.
    function addDays(iso, n) {
      const d = new Date(iso + 'T00:00:00Z');
      d.setUTCDate(d.getUTCDate() + n);
      return d.toISOString().slice(0, 10);
    }

    function reportPresets() {
      const y = addDays(RPT_TODAY, -1);
      return {
        today:     [RPT_TODAY, RPT_TODAY],
        yesterday: [y, y],
        week:      [addDays(RPT_TODAY, -6), RPT_TODAY],
        month:     [RPT_TODAY.slice(0, 8) + '01', RPT_TODAY],
      };
    }

    function setReportPreset(p) {
      const [f, t] = reportPresets()[p];
      document.getElementById('rptFrom').value = f;
      document.getElementById('rptTo').value = t;
      loadReports(true);
    }

    function onReportDates(changed) {
      const from = document.getElementById('rptFrom'), to = document.getElementById('rptTo');
      if (!from.value) from.value = RPT_TODAY;
      if (!to.value) to.value = RPT_TODAY;
      // Moving one end past the other drags the other along, rather than refusing the pick.
      if (from.value > to.value) {
        if (changed === to) from.value = to.value; else to.value = from.value;
      }
      loadReports();
    }

    function markReportPreset() {
      const f = document.getElementById('rptFrom').value, t = document.getElementById('rptTo').value;
      const presets = reportPresets();
      document.querySelectorAll('.rpt-preset').forEach(b => {
        const [pf, pt] = presets[b.dataset.preset];
        b.className = 'tap rpt-preset px-3.5 py-2 rounded-xl text-xs font-bold ' +
          (pf === f && pt === t ? 'bg-brand-600 text-white' : 'bg-white text-slate-500 border border-brand-200');
      });
    }

    async function loadReports(manual = false) {
      markReportPreset();
      const from = document.getElementById('rptFrom').value, to = document.getElementById('rptTo').value;
      // Quick picks can overlap; only the newest answer is drawn.
      const seq = ++rptSeq;
      if (manual) playBeep('click');
      try {
        const r = await catFetch(`${REPORTS_ENDPOINT}?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`);
        if (seq !== rptSeq) return;
        renderReports(r);
      } catch (e) {
        if (e.message === 'auth' || seq !== rptSeq) return;
        showToast(e.message || 'Could not load the report', 'error');
      }
    }

    function fmtDay(iso) {
      return new Date(iso + 'T00:00:00Z').toLocaleDateString(SHOP_TIME.locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    }

    function renderReports(r) {
      const s = r.summary;
      setText('rptRevenue', rupees(s.revenue));
      const bits = [];
      if (s.discount) bits.push('Disc ' + rupees(s.discount));
      if (s.gst) bits.push('GST ' + rupees(s.gst));
      setText('rptRevenueNote', bits.length ? bits.join('  ·  ') : 'Net bill totals');
      setText('rptOrders', shopNumber(s.orders));
      setText('rptAvg', rupees(s.avgOrder));
      setText('rptItems', shopNumber(s.itemsSold));
      setText('rptHourlySub', r.from === r.to
        ? fmtDay(r.from) + ', by the hour the bill was rung'
        : `${fmtDay(r.from)} – ${fmtDay(r.to)}, each hour added up across the days`);

      renderReportHourly(r.hourly || []);
      renderReportCategories(r.categories || []);
      renderReportStaff('rptCashiers', r.cashiers || [], false);
      renderReportStaff('rptWaiters', r.waiters || [], true);
    }

    // One bar per hour, its height the takings, captioned "Orders(n) - amount" so
    // the bill count reads off the same bar.
    function renderReportHourly(data) {
      const el = document.getElementById('rptHourly');
      if (!data.length) { el.innerHTML = emptyNote('No settled bills in this range'); return; }

      const max = Math.max(...data.map(d => Number(d.amount) || 0), 1);
      const kfmt = v => v >= 1000 ? SHOP_TIME.currency + (v / 1000).toFixed(1) + 'k' : rupees(v);

      el.innerHTML = `<div class="flex items-end gap-1.5 sm:gap-2">${data.map((d, i) => {
          const v = Number(d.amount) || 0, n = Number(d.orders) || 0, h = Math.round((v / max) * 100);
          // Each half stays whole, so a narrow bar wraps at the dash rather than mid-word.
          const cap = n === 0 ? '&nbsp;'
            : `<span class="whitespace-nowrap text-sky-600">Orders(${n})</span> <span class="whitespace-nowrap">- ${kfmt(v)}</span>`;
          return `<div class="flex-1 flex flex-col items-center gap-1 min-w-0" title="${esc(d.label)}: ${n} order${n === 1 ? '' : 's'} · ${rupees(v)}">
            <span class="text-[9px] sm:text-[10px] font-bold text-brand-600 text-center leading-tight">${cap}</span>
            <div class="w-full bg-brand-50 rounded-t-lg overflow-hidden" style="height:150px;display:flex;align-items:flex-end">
              <div class="w-full rounded-t-lg bg-gradient-to-t from-brand-600 to-brand-400 bar-animate" style="--bar-h:${h}%;height:${h}%;animation-delay:${i * .04}s"></div>
            </div>
            <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 whitespace-nowrap">${esc(d.label)}</span>
          </div>`;
        }).join('')}</div>`;
    }

    function renderReportCategories(cats) {
      const el = document.getElementById('rptCategories');
      if (!cats.length) { el.innerHTML = emptyNote('Nothing sold in this range'); return; }
      const total = cats.reduce((a, c) => a + (Number(c.amount) || 0), 0) || 1;
      el.innerHTML = cats.map(c => {
        const pct = (Number(c.amount) || 0) / total * 100;
        // The colour lands in a style attribute, so only a plain hex value is let through.
        const color = /^#[0-9a-f]{6}$/i.test(c.color) ? c.color : '#64748b';
        return `<div>
          <div class="flex justify-between gap-2 text-xs font-bold mb-1">
            <span class="text-slate-700 truncate flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm flex-shrink-0" style="background:${color}"></span>${esc(c.name)}</span>
            <span class="text-slate-500 whitespace-nowrap">${rupees(c.amount)} <span class="text-slate-400">(${pct.toFixed(pct < 10 ? 1 : 0)}%)</span></span>
          </div>
          <div class="h-2.5 rounded-full bg-slate-100 overflow-hidden"><div class="h-full rounded-full transition-all" style="width:${pct}%;background:${color}"></div></div>
          <p class="text-[10px] font-semibold text-slate-400 mt-0.5">${c.qty} item${c.qty === 1 ? '' : 's'}</p>
        </div>`;
      }).join('');
    }

    function renderReportStaff(id, rows, withPax) {
      const body = document.getElementById(id);
      if (!rows.length) {
        body.innerHTML = `<tr><td colspan="${withPax ? 4 : 3}" class="px-5 py-8 text-center text-xs font-bold text-slate-400">No settled bills in this range</td></tr>`;
        return;
      }
      const sum = k => rows.reduce((a, r) => a + (Number(r[k]) || 0), 0);
      const num = 'px-3 py-2.5 text-right font-mono';
      const amt = 'px-4 sm:px-5 py-2.5 text-right font-mono font-extrabold text-brand-950 whitespace-nowrap';
      body.innerHTML = rows.map(r => `<tr class="border-b border-brand-50">
          <td class="px-4 sm:px-5 py-2.5 font-bold ${r.none ? 'text-slate-400 italic' : 'text-slate-700'}">${esc(r.name)}</td>
          <td class="${num} font-bold text-slate-600">${r.orders}</td>
          ${withPax ? `<td class="${num} font-semibold text-slate-500">${r.guests}</td>` : ''}
          <td class="${amt}">${rupees(r.amount)}</td>
        </tr>`).join('') +
        `<tr class="bg-brand-25">
          <td class="px-4 sm:px-5 py-2.5 text-xs font-extrabold text-slate-500 uppercase">Total</td>
          <td class="${num} font-extrabold text-slate-700">${sum('orders')}</td>
          ${withPax ? `<td class="${num} font-extrabold text-slate-600">${sum('guests')}</td>` : ''}
          <td class="${amt}">${rupees(sum('amount'))}</td>
        </tr>`;
    }

    // ===================== SETTINGS: CHARGES =====================
    // The service charge and tax rows in config_terminal_setting. This panel is the
    // only writer: the till reads them at load and its own Settings modal overrides
    // the cart in front of it without writing back, so the shop's rate cannot be
    // changed from the counter.
    const CHARGES_ENDPOINT = '@Url.Action("SaveCharges", "Admin")';
    // Store Info is saved by the same button, to the config_store row.
    const STORE_ENDPOINT = '@Url.Action("SaveStore", "Admin")';
    let savingCharges = false;

    async function saveCharges() {
      if (savingCharges) return;

      const sc  = parseFloat(document.getElementById('setServiceCharge').value);
      const gst = parseFloat(document.getElementById('setGst').value);

      // Checked here as well as server side, so a typo is caught before a round
      // trip and the message names the field rather than the constraint.
      for (const [label, v] of [['Service charge', sc], ['Tax rate', gst]]) {
        if (!Number.isFinite(v) || v < 0 || v > 100) {
          showToast(`${label} must be a number between 0 and 100`, 'error');
          return;
        }
      }

      const store = {
        storeName: document.getElementById('setStoreName').value.trim(),
        address:   document.getElementById('setAddress').value.trim(),
        phone:     document.getElementById('setPhone').value.trim(),
        gstNo:     document.getElementById('setGstNo').value.trim().toUpperCase(),
        currencySymbol:     document.getElementById('setCurrency').value,
        payNowEnabled:      document.getElementById('setPayNowEnabled').dataset.on === '1',
        payNowType:         document.getElementById('setPayNowType').value,
        payNowProxy:        document.getElementById('setPayNowProxy').value.trim(),
        payNowMerchantName: document.getElementById('setPayNowMerchant').value.trim()
      };
      if (store.payNowEnabled && !store.payNowProxy) {
        showToast(QR_UPI ? 'Enter the UPI ID, or turn the QR off' : 'Enter the PayNow UEN or mobile, or turn the QR off', 'error');
        return;
      }
      if (!store.storeName) {
        showToast('Store name is required', 'error');
        return;
      }

      savingCharges = true;
      const btn = document.getElementById('saveSettingsBtn');
      btn.disabled = true;
      playBeep('click');

      try {
        const token = document.querySelector('#logoutForm input[name="__RequestVerificationToken"]').value;
        const storeRes = await fetch(STORE_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
          body: JSON.stringify(store)
        });
        if (storeRes.redirected || storeRes.status === 401 || storeRes.status === 403) {
          location.reload();
          return;
        }
        if (!storeRes.ok) {
          const body = await storeRes.json().catch(() => null);
          showToast(body?.error || 'Could not save store info - HTTP ' + storeRes.status, 'error');
          return;
        }
        const savedStore = await storeRes.json();
        document.getElementById('setStoreName').value = savedStore.storeName;
        document.getElementById('setAddress').value   = savedStore.address;
        document.getElementById('setPhone').value     = savedStore.phone;
        document.getElementById('setGstNo').value     = savedStore.gstNo;
        document.getElementById('setPayNowProxy').value    = savedStore.payNowProxy;
        document.getElementById('setPayNowMerchant').value = savedStore.payNowMerchantName;

        const res = await fetch(CHARGES_ENDPOINT, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('#logoutForm input[name="__RequestVerificationToken"]').value
          },
          body: JSON.stringify({ serviceCharge: sc, gst })
        });

        // Same reasoning as the dashboard: a redirect means the cookie expired
        // while the panel sat open, so hand it back to the login flow.
        if (res.redirected || res.status === 401 || res.status === 403) {
          location.reload();
          return;
        }

        if (!res.ok) {
          const body = await res.json().catch(() => null);
          showToast(body?.error || 'Could not save - HTTP ' + res.status, 'error');
          return;
        }

        // Echo what the server stored rather than what was typed, so the boxes show
        // the rounded decimal(5,2) the tills will actually read.
        const saved = await res.json();
        document.getElementById('setServiceCharge').value = saved.serviceCharge;
        document.getElementById('setGst').value = saved.gst;
        showToast('Settings saved. Tills pick up the charges on their next load.');
      } catch (e) {
        showToast('Could not reach the database', 'error');
      } finally {
        savingCharges = false;
        btn.disabled = false;
      }
    }

    // ===================== CATEGORIES =====================
    // Categories - the POS left rail. Read and written through the API so
    // the panel always reflects the database rather than a copy in the page.
    const CATS_ENDPOINT = '@Url.Action("Categories", "Admin")';
    // The server's palette (Category.Palette), so the picker offers exactly what it accepts and backfills from.
    const CAT_TINTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Category.Palette));
    const tintOf = c => /^#[0-9a-f]{6}$/i.test(c?.color || '') ? c.color : CAT_TINTS[0];
    // Every food-related icon in the bundled Lucide (wwwroot/lib/lucide), grouped
    // for the picker. Names must exist in that bundle or the till shows a blank tile.
    const CAT_ICON_GROUPS = [
      { label:'Meals & Dishes', icons:['utensils','utensils-crossed','fork-knife','chef-hat','cooking-pot','soup','salad','sandwich','hamburger','pizza',
                                       'ham','beef','drumstick','fish','fish-symbol','shrimp','egg','egg-fried','wheat','croissant','popcorn','flame','flame-kindling','microwave','refrigerator'] },
      { label:'Drinks',         icons:['coffee','cup-soda','can-soda','glass-water','milk','beer','wine','bottle-wine','martini','hop','barrel','amphora'] },
      { label:'Fruit & Veg',    icons:['apple','banana','cherry','grape','citrus','carrot','leafy-green','leaf','sprout','vegan','bean','nut'] },
      { label:'Sweets & Desserts', icons:['cake','cake-slice','cupcake','cookie','donut','candy','candy-cane','lollipop','ice-cream-cone','ice-cream-bowl'] },
      { label:'Specials & Other',  icons:['star','sparkles','gift','package','layers','layout-grid','snowflake','sun','sunrise','moon','clock','percent','tag','shopping-bag','store','heart','award'] },
    ];
    const CAT_ICONS = CAT_ICON_GROUPS.flatMap(g => g.icons);
    let CATEGORIES = [];
    let catFilter = 'all';
    let catIcon = CAT_ICONS[0];
    let catBusy = false;

    const antiForgery = () => document.querySelector('#logoutForm input[name="__RequestVerificationToken"]').value;

    async function catFetch(url, options = {}) {
      const res = await fetch(url, {
        cache: 'no-store',
        ...options,
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgery(), ...(options.headers || {}) }
      });
      // Expired cookie: hand the page back to the login flow.
      if (res.redirected || res.status === 401 || res.status === 403) { location.reload(); throw new Error('auth'); }
      const body = await res.json().catch(() => null);
      if (!res.ok) throw new Error(body?.error || 'HTTP ' + res.status);
      return body;
    }

    async function loadCategories() {
      try {
        CATEGORIES = await catFetch(CATS_ENDPOINT);
        renderCategories();
      } catch (e) {
        if (e.message !== 'auth')
          document.getElementById('categoriesBody').innerHTML = `<tr><td colspan="6" class="px-5 py-8 text-center text-xs font-bold text-rose-500">Could not load categories</td></tr>`;
      }
    }

    function filterCategories(f, btn) {
      catFilter = f;
      document.querySelectorAll('.cat-filter-btn').forEach(b => { b.classList.remove('bg-brand-600','text-white'); b.classList.add('bg-white','text-slate-500','border','border-brand-200'); });
      btn.classList.add('bg-brand-600','text-white'); btn.classList.remove('bg-white','text-slate-500','border','border-brand-200');
      renderCategories();
      playBeep('click');
    }

    function renderCategories() {
      const active = CATEGORIES.filter(c => c.isActive).length;
      setText('catCountAll', CATEGORIES.length);
      setText('catCountActive', active);
      setText('catCountInactive', CATEGORIES.length - active);

      const list = catFilter === 'all' ? CATEGORIES : CATEGORIES.filter(c => c.isActive === (catFilter === 'active'));
      const body = document.getElementById('categoriesBody');
      if (!list.length) {
        body.innerHTML = `<tr><td colspan="6" class="px-5 py-8 text-center text-xs font-bold text-slate-400">No ${catFilter === 'all' ? '' : catFilter + ' '}categories</td></tr>`;
        return;
      }
      body.innerHTML = list.map(c => {
        const tint = tintOf(c);
        return `<tr class="table-row border-b border-brand-50 last:border-0 ${c.isActive ? '' : 'opacity-60'}">
          <td class="px-4 sm:px-5 py-3">
            <div class="flex items-center gap-3">
              <span class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0" style="background:${tint};color:#fff" title="${tint}"><i data-lucide="${esc(c.icon || 'utensils')}" class="w-[18px] h-[18px]"></i></span>
              <span class="font-extrabold text-brand-950">${esc(c.name)}</span>
            </div>
          </td>
          <td class="px-4 sm:px-5 py-3 font-mono text-xs font-bold text-slate-400">${esc(c.code)}</td>
          <td class="px-4 sm:px-5 py-3 text-right font-bold text-slate-600 font-mono">${c.items}</td>
          <td class="px-4 sm:px-5 py-3">${c.isActive
            ? '<span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold border bg-mint-50 text-mint-700 border-mint-200">Active</span>'
            : '<span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold border bg-slate-100 text-slate-500 border-slate-200">Inactive</span>'}</td>
          <td class="px-4 sm:px-5 py-3 text-center">
            <button onclick="toggleCategory(${c.id})" title="${c.isActive ? 'Deactivate' : 'Activate'}" aria-pressed="${c.isActive}"
                    class="w-11 h-6 rounded-full ${c.isActive ? 'bg-brand-600' : 'bg-slate-300'} relative transition-colors inline-block align-middle">
              <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform ${c.isActive ? 'translate-x-5' : ''}"></span>
            </button>
          </td>
          <td class="px-4 sm:px-5 py-3 text-right">
            <button onclick="openCategoryModal(${c.id})" title="Edit" class="tap w-8 h-8 rounded-lg bg-brand-50 text-brand-700 hover:bg-brand-100 inline-flex items-center justify-center"><i data-lucide="pencil" class="w-3.5 h-3.5"></i></button>
          </td>
        </tr>`;
      }).join('');
      drawIcons();
    }

    async function toggleCategory(id) {
      const c = CATEGORIES.find(x => x.id === id);
      if (!c || catBusy) return;
      catBusy = true;
      playBeep('click');
      try {
        const saved = await catFetch(`${CATS_ENDPOINT}/${id}/active`, { method: 'POST', body: JSON.stringify({ isActive: !c.isActive }) });
        c.isActive = saved.isActive;
        renderCategories();
        showToast(`${c.name} ${c.isActive ? 'activated' : 'deactivated'}`);
      } catch (e) {
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        catBusy = false;
      }
    }

    function renderIconPicker() {
      const picker = document.getElementById('catIconPicker');
      const scroll = picker.scrollTop;
      picker.innerHTML = CAT_ICON_GROUPS.map(g =>
        `<p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mt-2 first:mt-0 mb-1.5">${g.label}</p>
         <div class="grid grid-cols-6 sm:grid-cols-8 gap-1.5">${g.icons.map(ic =>
          `<button type="button" onclick="pickCatIcon('${ic}')" title="${ic}"
                   class="tap h-10 rounded-xl border flex items-center justify-center ${ic === catIcon ? 'bg-brand-600 border-brand-600 text-white' : 'bg-brand-25 border-brand-200 text-brand-600 hover:bg-brand-50'}">
             <i data-lucide="${ic}" class="w-[18px] h-[18px]"></i>
           </button>`).join('')}</div>`).join('');
      // Re-rendering on every pick would otherwise jump the list back to the top.
      picker.scrollTop = scroll;
      setText('catIconName', catIcon);
      renderCatPreview();
      drawIcons();
    }
    function pickCatIcon(ic) { catIcon = ic; renderIconPicker(); playBeep('click'); }

    // ---- colour ----
    let catColor = CAT_TINTS[0];
    let catEditing = null;   // the row being edited, or null when adding

    function renderColorPicker() {
      document.getElementById('catColorPicker').innerHTML = CAT_TINTS.map(col =>
        `<button type="button" onclick="pickCatColor('${col}')" title="${col}"
                 class="tap aspect-square rounded-lg flex items-center justify-center ${col === catColor ? 'ring-2 ring-offset-2 ring-brand-900' : ''}" style="background:${col}">
           ${col === catColor ? '<i data-lucide="check" class="w-3.5 h-3.5 text-white"></i>' : ''}
         </button>`).join('');
      renderCatPreview();
      drawIcons();
    }
    function pickCatColor(col) { catColor = col; renderColorPicker(); playBeep('click'); }

    // Random, preferring a colour no other active category already has.
    function randomCatColor(manual = false) {
      const taken = new Set(CATEGORIES.filter(c => c.isActive && c.id !== catEditing?.id).map(c => (c.color || '').toLowerCase()));
      let pool = CAT_TINTS.filter(c => !taken.has(c) && c !== catColor);
      if (!pool.length) pool = CAT_TINTS.filter(c => c !== catColor);
      catColor = pool[Math.floor(Math.random() * pool.length)];
      renderColorPicker();
      if (manual) playBeep('click');
    }

    // Mirrors the till's rail tile: solid when selected, a light wash otherwise.
    function renderCatPreview() {
      const name = esc(document.getElementById('newCatName').value.trim() || 'Category');
      const tile = on => `
        <span class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:${on ? catColor : catColor + '18'};color:${on ? '#fff' : catColor}"><i data-lucide="${catIcon}" class="w-[18px] h-[18px]"></i></span>
        <span class="text-[10px] font-bold leading-tight text-center truncate max-w-full ${on ? 'text-brand-900' : 'text-slate-600'}">${name}</span>`;
      document.getElementById('catPreviewOn').innerHTML = tile(true);
      document.getElementById('catPreviewOff').innerHTML = tile(false);
      drawIcons();
    }

    function openCategoryModal(id) {
      catEditing = id ? CATEGORIES.find(c => c.id === id) : null;
      catIcon = catEditing?.icon || CAT_ICONS[0];
      document.getElementById('newCatName').value = catEditing?.name || '';
      document.getElementById('catModalTitle').textContent = catEditing ? 'Edit Category' : 'Add Category';
      document.getElementById('catSaveLabel').textContent = catEditing ? 'Save Changes' : 'Add Category';
      document.getElementById('catIconPicker').scrollTop = 0;
      renderIconPicker();
      if (catEditing) { catColor = tintOf(catEditing); renderColorPicker(); }
      else randomCatColor();
      const m = document.getElementById('categoryModal');
      m.classList.remove('hidden'); m.classList.add('flex');
      setTimeout(() => document.getElementById('newCatName').focus(), 50);
    }
    function closeCategoryModal() {
      const m = document.getElementById('categoryModal');
      m.classList.add('hidden'); m.classList.remove('flex');
      catEditing = null;
    }

    async function saveCategory() {
      const name = document.getElementById('newCatName').value.trim();
      if (!name) { showToast('Enter a category name', 'error'); return; }
      if (catBusy) return;
      catBusy = true;
      const btn = document.getElementById('addCategoryBtn');
      btn.disabled = true;
      const editing = catEditing;
      try {
        await catFetch(editing ? `${CATS_ENDPOINT}/${editing.id}` : CATS_ENDPOINT,
                       { method: editing ? 'PUT' : 'POST', body: JSON.stringify({ name, icon: catIcon, color: catColor }) });
        closeCategoryModal();
        await loadCategories();
        showToast(editing ? `${name} updated. Tills pick it up on their next load.` : `${name} added`);
      } catch (e) {
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        catBusy = false;
        btn.disabled = false;
      }
    }
    document.getElementById('newCatName').addEventListener('keydown', e => { if (e.key === 'Enter') saveCategory(); });

    const parentOf = code => CATEGORIES.find(c => c.code === code);
    // "All" is the till's virtual list of every item, so nothing can sit under it.
    const realParents = () => CATEGORIES.filter(c => c.code !== 'ALL');

    function parentOptions(selected) {
      return realParents().map(c =>
        `<option value="${esc(c.code)}" ${c.code === selected ? 'selected' : ''}>${esc(c.name)}${c.isActive ? '' : ' (inactive)'}</option>`).join('');
    }

    function closeConfirm() {
      const m = document.getElementById('confirmModal');
      m.classList.add('hidden'); m.classList.remove('flex');
    }

    // ===================== TRANSACTION MODES =====================
    const MODES_ENDPOINT = '@Url.Action("TransactionModes", "Admin")';
    let MODES = [];
    let modeEditing = null;   // the row being edited, or null when adding
    let modeBusy = false;

    async function loadModes() {
      try {
        MODES = await catFetch(MODES_ENDPOINT);
        renderModes();
      } catch (e) {
        if (e.message !== 'auth')
          document.getElementById('modesBody').innerHTML = `<tr><td colspan="6" class="px-5 py-8 text-center text-xs font-bold text-rose-500">Could not load transaction modes</td></tr>`;
      }
    }

    function renderModes() {
      const body = document.getElementById('modesBody');
      if (!MODES.length) {
        body.innerHTML = `<tr><td colspan="6" class="px-5 py-8 text-center text-xs font-bold text-slate-400">No transaction modes</td></tr>`;
        return;
      }
      body.innerHTML = MODES.map(m => `<tr class="table-row border-b border-brand-50 last:border-0 ${m.isActive ? '' : 'opacity-60'}">
          <td class="px-4 sm:px-5 py-3 font-bold text-slate-600 font-mono">${m.sortOrder}</td>
          <td class="px-4 sm:px-5 py-3 font-extrabold text-brand-950">${esc(m.name)}</td>
          <td class="px-4 sm:px-5 py-3 text-right font-bold text-slate-600 font-mono">${m.used}</td>
          <td class="px-4 sm:px-5 py-3">${m.isActive
            ? '<span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold border bg-mint-50 text-mint-700 border-mint-200">Active</span>'
            : '<span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold border bg-slate-100 text-slate-500 border-slate-200">Inactive</span>'}</td>
          <td class="px-4 sm:px-5 py-3 text-center">
            <button onclick="toggleMode(${m.id})" title="${m.isActive ? 'Deactivate' : 'Activate'}" aria-pressed="${m.isActive}"
                    class="w-11 h-6 rounded-full ${m.isActive ? 'bg-brand-600' : 'bg-slate-300'} relative transition-colors inline-block align-middle">
              <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform ${m.isActive ? 'translate-x-5' : ''}"></span>
            </button>
          </td>
          <td class="px-4 sm:px-5 py-3 text-right whitespace-nowrap">
            <button onclick="openModeModal(${m.id})" title="Edit" class="tap w-8 h-8 rounded-lg bg-brand-50 text-brand-700 hover:bg-brand-100 inline-flex items-center justify-center"><i data-lucide="pencil" class="w-3.5 h-3.5"></i></button>
            <button onclick="confirmDeleteMode(${m.id})" title="${m.used ? 'In use - deactivate instead' : 'Delete'}"
                    class="tap w-8 h-8 rounded-lg inline-flex items-center justify-center ${m.used ? 'bg-slate-50 text-slate-300 cursor-not-allowed' : 'bg-rose-50 text-rose-600 hover:bg-rose-100'}"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
          </td>
        </tr>`).join('');
      drawIcons();
    }

    async function toggleMode(id) {
      const m = MODES.find(x => x.id === id);
      if (!m || modeBusy) return;
      modeBusy = true;
      playBeep('click');
      try {
        const saved = await catFetch(`${MODES_ENDPOINT}/${id}/active`, { method: 'POST', body: JSON.stringify({ isActive: !m.isActive }) });
        m.isActive = saved.isActive;
        renderModes();
        showToast(`${m.name} ${m.isActive ? 'activated' : 'deactivated'}`);
      } catch (e) {
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        modeBusy = false;
      }
    }

    function openModeModal(id) {
      modeEditing = id ? MODES.find(m => m.id === id) : null;
      document.getElementById('modeModalTitle').textContent = modeEditing ? 'Edit Transaction Mode' : 'Add Transaction Mode';
      document.getElementById('modeSaveLabel').textContent = modeEditing ? 'Save Changes' : 'Add Mode';
      document.getElementById('modeName').value = modeEditing?.name || '';
      document.getElementById('modeSort').value = modeEditing ? modeEditing.sortOrder : '';

      const m = document.getElementById('modeModal');
      m.classList.remove('hidden'); m.classList.add('flex');
      drawIcons();
      setTimeout(() => document.getElementById('modeName').focus(), 50);
    }
    function closeModeModal() {
      const m = document.getElementById('modeModal');
      m.classList.add('hidden'); m.classList.remove('flex');
      modeEditing = null;
    }

    async function saveMode() {
      const name = document.getElementById('modeName').value.trim().toUpperCase();
      if (!name) { showToast('Enter a mode name', 'error'); return; }
      const sortRaw = document.getElementById('modeSort').value.trim();
      const sortOrder = sortRaw === '' ? null : Number(sortRaw);
      if (sortOrder !== null && (!Number.isInteger(sortOrder) || sortOrder < 0 || sortOrder > 999)) { showToast('Order must be a whole number 0-999', 'error'); return; }
      if (modeBusy) return;
      modeBusy = true;
      const btn = document.getElementById('modeSaveBtn');
      btn.disabled = true;
      const editing = modeEditing;
      try {
        await catFetch(editing ? `${MODES_ENDPOINT}/${editing.id}` : MODES_ENDPOINT,
                       { method: editing ? 'PUT' : 'POST', body: JSON.stringify({ name, sortOrder }) });
        closeModeModal();
        await loadModes();
        showToast(editing ? `${name} updated` : `${name} added`);
      } catch (e) {
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        modeBusy = false;
        btn.disabled = false;
      }
    }
    document.getElementById('modeName').addEventListener('keydown', e => { if (e.key === 'Enter') saveMode(); });
    document.getElementById('modeSort').addEventListener('keydown', e => { if (e.key === 'Enter') saveMode(); });

    function confirmDeleteMode(id) {
      const m = MODES.find(x => x.id === id);
      if (!m) return;
      if (m.used > 0) { showToast(`${m.name} has ${m.used} transaction(s). Deactivate it instead.`, 'error'); return; }
      setText('confirmTitle', 'Delete transaction mode?');
      document.getElementById('confirmMsg').textContent = `"${m.name}" will be removed permanently.`;
      document.getElementById('confirmOkBtn').onclick = () => deleteMode(id);
      const c = document.getElementById('confirmModal');
      c.classList.remove('hidden'); c.classList.add('flex');
      drawIcons();
    }

    async function deleteMode(id) {
      const m = MODES.find(x => x.id === id);
      if (modeBusy) return;
      modeBusy = true;
      try {
        await catFetch(`${MODES_ENDPOINT}/${id}`, { method: 'DELETE' });
        closeConfirm();
        await loadModes();
        showToast(`${m?.name || 'Transaction mode'} deleted`);
      } catch (e) {
        closeConfirm();
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        modeBusy = false;
      }
    }

    // ===================== MENU ITEMS =====================
    // The dishes on the till, read and written through the API. Main and sub
    // categories are re-read with them so names, colours and dropdowns are current.
    const ITEMS_ENDPOINT = '@Url.Action("MenuItems", "Admin")';
    // The shop country's currency, as the till opens with, so prices read the same in both places.
    const TILL_CURRENCY = SHOP_TIME.currency;
    function setPayNowToggle(on) {
      const btn = document.getElementById('setPayNowEnabled');
      btn.dataset.on = on ? '1' : '0';
      btn.classList.toggle('bg-brand-600', on);
      btn.classList.toggle('bg-slate-300', !on);
      btn.querySelector('span').classList.toggle('translate-x-5', on);
    }
    const QR_UPI = SHOP_TIME.qrScheme === 'UPI';
    function renderPayNowHint() {
      if (QR_UPI) return;
      const mobile = document.getElementById('setPayNowType').value === 'mobile';
      document.getElementById('setPayNowProxy').placeholder = mobile ? '+6591234567' : '202312345A';
      document.getElementById('payNowHint').textContent = mobile
        ? 'Mobile number in +65 format, as registered for PayNow.'
        : 'Business UEN as registered for PayNow.';
    }
    renderPayNowHint();
    const price2 = v => TILL_CURRENCY + (Number(v) || 0).toFixed(2);
    document.querySelectorAll('.till-currency').forEach(el => el.textContent = TILL_CURRENCY);

    let ITEMS = [];
    let menuCat = '';          // category code, '' for all
    let itemEditing = null;    // the row being edited, or null when adding
    let itemVeg = true;
    let itemBusy = false;

    async function loadMenu() {
      try {
        [CATEGORIES, ITEMS] = await Promise.all([catFetch(CATS_ENDPOINT), catFetch(ITEMS_ENDPOINT)]);
        if (menuCat && !parentOf(menuCat)) menuCat = '';
        renderMenu();
      } catch (e) {
        if (e.message !== 'auth')
          document.getElementById('menuGrid').innerHTML = `<p class="col-span-full text-center text-xs font-bold text-rose-500 py-8">Could not load menu items</p>`;
      }
    }

    function selectMenuCat(code) {
      menuCat = code;
      renderMenu();
      playBeep('click');
    }

    function renderMenuChips() {
      const chip = (code, label, color, n) => {
        const on = menuCat === code;
        return `<button onclick="selectMenuCat('${esc(code)}')" class="tap flex-shrink-0 px-3.5 py-2 rounded-xl text-xs font-bold border inline-flex items-center gap-1.5 whitespace-nowrap"
                  style="${on ? `background:${color};border-color:${color};color:#fff` : `background:#fff;border-color:${color}40;color:${color}`}">
                  ${esc(label)} <span class="opacity-70">${n}</span></button>`;
      };
      document.getElementById('menuCatChips').innerHTML =
        chip('', 'All', '#74793f', ITEMS.length) +
        realParents().map(c => chip(c.code, c.name + (c.isActive ? '' : ' (off)'), c.isActive ? tintOf(c) : '#94a3b8',
                                     ITEMS.filter(i => i.category === c.code).length)).join('');
    }

    function renderMenu() {
      renderMenuChips();

      const q      = document.getElementById('menuSearch').value.trim().toLowerCase();
      const status = document.getElementById('menuStatusFilter').value;
      const veg    = document.getElementById('menuVegFilter').value;

      const list = ITEMS.filter(i =>
        (!menuCat || i.category === menuCat) &&
        (status === 'all' || i.isActive === (status === 'active')) &&
        (veg === 'all' || i.isVeg === (veg === 'veg')) &&
        (!q || i.name.toLowerCase().includes(q) || i.code.toLowerCase().includes(q)));

      const active = list.filter(i => i.isActive).length;
      setText('menuSummary', `${list.length} item${list.length === 1 ? '' : 's'} shown - ${active} active, ${list.length - active} inactive`);

      const grid = document.getElementById('menuGrid');
      if (!list.length) {
        grid.innerHTML = `<p class="col-span-full text-center text-xs font-bold text-slate-400 py-8">No menu items match</p>`;
        return;
      }

      grid.innerHTML = list.map(it => {
        const p = parentOf(it.category);
        const tint = p ? tintOf(p) : '#94a3b8';
        // Why a dish is off the till even though it is switched on.
        const hiddenBy = !it.isActive ? '' : p && !p.isActive ? `${p.name} is inactive` : '';
        return `<div class="glass rounded-2xl shadow-soft flex flex-col overflow-hidden hover:shadow-glow hover:border-brand-200 transition-all duration-200 ${it.isActive ? '' : 'opacity-60'}">
          <div class="h-1.5" style="background:${tint}"></div>
          <div class="p-4 flex flex-col flex-1">
            <div class="flex items-start justify-between gap-2">
              <span title="${it.isVeg ? 'Veg' : 'Non-veg'}" class="w-4 h-4 mt-0.5 rounded-[4px] border-[1.5px] ${it.isVeg ? 'border-emerald-600' : 'border-rose-600'} flex items-center justify-center shrink-0"><span class="w-1.5 h-1.5 rounded-full ${it.isVeg ? 'bg-emerald-600' : 'bg-rose-600'}"></span></span>
              <button onclick="toggleMenuItem(${it.id})" title="${it.isActive ? 'Deactivate' : 'Activate'}" aria-pressed="${it.isActive}"
                      class="w-10 h-[22px] rounded-full ${it.isActive ? 'bg-brand-600' : 'bg-slate-300'} relative transition-colors flex-shrink-0">
                <span class="absolute top-0.5 left-0.5 w-[18px] h-[18px] bg-white rounded-full shadow transition-transform ${it.isActive ? 'translate-x-[18px]' : ''}"></span>
              </button>
            </div>
            <h4 class="mt-2 text-sm font-extrabold text-brand-950 leading-snug">${esc(it.name)}</h4>
            <div class="mt-1.5 flex flex-wrap gap-1">
              <span class="px-2 py-0.5 rounded-lg text-[10px] font-extrabold uppercase" style="background:${tint}18;color:${tint}">${esc(p?.name || it.category)}</span>
            </div>
            ${hiddenBy ? `<p class="mt-1.5 text-[10px] font-bold text-amber-600 flex items-center gap-1"><i data-lucide="eye-off" class="w-3 h-3"></i> Hidden on POS: ${esc(hiddenBy)}</p>` : ''}
            <div class="mt-auto pt-3 flex items-end justify-between gap-2">
              <div>
                <p class="text-lg font-extrabold text-brand-700 font-digital leading-none">${price2(it.price)}</p>
                <p class="text-[10px] font-mono font-bold text-slate-300 mt-1">${esc(it.code)}</p>
              </div>
              <div class="flex gap-1.5">
                <button onclick="openMenuModal(${it.id})" title="Edit" class="tap w-8 h-8 rounded-lg bg-brand-50 text-brand-700 hover:bg-brand-100 inline-flex items-center justify-center"><i data-lucide="pencil" class="w-3.5 h-3.5"></i></button>
                <button onclick="confirmDeleteItem(${it.id})" title="${it.inUse ? 'On past bills - deactivate instead' : 'Delete'}"
                        class="tap w-8 h-8 rounded-lg inline-flex items-center justify-center ${it.inUse ? 'bg-slate-50 text-slate-300 cursor-not-allowed' : 'bg-rose-50 text-rose-600 hover:bg-rose-100'}"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
              </div>
            </div>
          </div>
        </div>`;
      }).join('');
      drawIcons();
    }

    async function toggleMenuItem(id) {
      const it = ITEMS.find(x => x.id === id);
      if (!it || itemBusy) return;
      itemBusy = true;
      playBeep('click');
      try {
        const saved = await catFetch(`${ITEMS_ENDPOINT}/${id}/active`, { method: 'POST', body: JSON.stringify({ isActive: !it.isActive }) });
        it.isActive = saved.isActive;
        renderMenu();
        showToast(`${it.name} ${it.isActive ? 'activated' : 'deactivated'}`);
      } catch (e) {
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        itemBusy = false;
      }
    }

    function setItemVeg(v) {
      itemVeg = v;
      const on  = 'bg-brand-600 border-brand-600 text-white';
      const off = 'bg-brand-25 border-brand-200 text-slate-600';
      document.getElementById('itemVegBtn').className    = `tap py-3 rounded-xl border text-xs font-extrabold flex items-center justify-center gap-1.5 ${v ? on : off}`;
      document.getElementById('itemNonVegBtn').className = `tap py-3 rounded-xl border text-xs font-extrabold flex items-center justify-center gap-1.5 ${v ? off : on}`;
    }

    // Saving an active dish under a switched-off category is allowed, but it will
    // not appear on the till until that category is on again - said up front.
    function updateItemHint() {
      const p = parentOf(document.getElementById('itemCat').value);
      const why = p && !p.isActive ? p.name : '';
      const hint = document.getElementById('itemHint');
      hint.textContent = why ? `${why} is inactive, so this item will stay hidden on the POS until it is switched on.` : '';
      hint.classList.toggle('hidden', !why);
    }

    async function openMenuModal(id) {
      // The dropdowns need categories even if the section was never opened.
      if (!CATEGORIES.length) await loadMenu();
      const parents = realParents();
      if (!parents.length) { showToast('Add a category first', 'error'); return; }

      itemEditing = id ? ITEMS.find(i => i.id === id) : null;
      setText('itemModalTitle', itemEditing ? 'Edit Menu Item' : 'Add Menu Item');
      setText('itemSaveLabel', itemEditing ? 'Save Changes' : 'Add Item');
      document.getElementById('itemName').value  = itemEditing?.name ?? '';
      document.getElementById('itemPrice').value = itemEditing ? Number(itemEditing.price).toFixed(2) : '';
      document.getElementById('itemActive').checked = itemEditing ? itemEditing.isActive : true;
      setItemVeg(itemEditing ? itemEditing.isVeg : true);

      const cat = itemEditing?.category || menuCat || parents[0].code;
      document.getElementById('itemCat').innerHTML = parentOptions(cat);
      updateItemHint();

      const m = document.getElementById('menuModal');
      m.classList.remove('hidden'); m.classList.add('flex');
      drawIcons();
      setTimeout(() => document.getElementById('itemName').focus(), 50);
    }
    function closeMenuModal() {
      const m = document.getElementById('menuModal');
      m.classList.add('hidden'); m.classList.remove('flex');
      itemEditing = null;
    }

    async function saveMenuItem() {
      const name  = document.getElementById('itemName').value.trim();
      const price = Math.round(parseFloat(document.getElementById('itemPrice').value) * 100) / 100;
      if (!name) { showToast('Enter an item name', 'error'); return; }
      if (!Number.isFinite(price) || price <= 0) { showToast('Enter a price above 0', 'error'); return; }
      if (itemBusy) return;

      itemBusy = true;
      const btn = document.getElementById('itemSaveBtn');
      btn.disabled = true;
      const editing = itemEditing;
      const body = {
        name, price, isVeg: itemVeg,
        category: document.getElementById('itemCat').value,
        isActive: document.getElementById('itemActive').checked
      };
      try {
        await catFetch(editing ? `${ITEMS_ENDPOINT}/${editing.id}` : ITEMS_ENDPOINT,
                       { method: editing ? 'PUT' : 'POST', body: JSON.stringify(body) });
        closeMenuModal();
        await loadMenu();
        showToast(editing ? `${name} updated` : `${name} added to menu`);
      } catch (e) {
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        itemBusy = false;
        btn.disabled = false;
      }
    }
    ['itemName', 'itemPrice'].forEach(id =>
      document.getElementById(id).addEventListener('keydown', e => { if (e.key === 'Enter') saveMenuItem(); }));

    function confirmDeleteItem(id) {
      const it = ITEMS.find(x => x.id === id);
      if (!it) return;
      if (it.inUse) { showToast(`${it.name} is on past bills. Deactivate it instead.`, 'error'); return; }
      setText('confirmTitle', 'Delete menu item?');
      document.getElementById('confirmMsg').textContent = `"${it.name}" will be removed from the menu permanently.`;
      document.getElementById('confirmOkBtn').onclick = () => deleteMenuItem(id);
      const m = document.getElementById('confirmModal');
      m.classList.remove('hidden'); m.classList.add('flex');
      drawIcons();
    }

    async function deleteMenuItem(id) {
      const it = ITEMS.find(x => x.id === id);
      if (itemBusy) return;
      itemBusy = true;
      try {
        await catFetch(`${ITEMS_ENDPOINT}/${id}`, { method: 'DELETE' });
        closeConfirm();
        await loadMenu();
        showToast(`${it?.name || 'Item'} deleted`);
      } catch (e) {
        closeConfirm();
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        itemBusy = false;
      }
    }

    // ===================== USERS & ROLES =====================
    // Staff accounts (users) and roles (config_role), both read and written through
    // AdminUsersController. The server enforces every rule below; the page only
    // greys out what it already knows will be refused, so the reason is shown
    // before a round trip rather than after.
    // ===================== ATTENDANCE =====================
    const ATTENDANCE_ENDPOINT = '@Url.Action("AttendanceDay", "AdminUsers")';
    let ATTENDANCE = null;
    let attFilter = 'all';

    async function loadAttendance(manual = false) {
      if (manual) playBeep('click');
      const date = document.getElementById('attDate').value;
      try {
        ATTENDANCE = await catFetch(ATTENDANCE_ENDPOINT + '?date=' + encodeURIComponent(date));
        renderAttendance();
      } catch (e) {
        if (e.message !== 'auth')
          document.getElementById('attBody').innerHTML = `<tr><td colspan="7" class="px-5 py-8 text-center text-xs font-bold text-rose-500">Could not load attendance</td></tr>`;
      }
    }

    function shiftAttendanceDate(days) {
      const input = document.getElementById('attDate');
      const d = new Date(input.value + 'T00:00:00');
      d.setDate(d.getDate() + days);
      const next = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      if (next > input.max) return;
      input.value = next;
      loadAttendance(true);
    }

    function filterAttendance(f, btn) {
      attFilter = f;
      document.querySelectorAll('.att-filter-btn').forEach(b => {
        b.classList.remove('bg-brand-600', 'text-white');
        b.classList.add('bg-white', 'text-slate-500', 'border', 'border-brand-200');
      });
      btn.classList.add('bg-brand-600', 'text-white');
      btn.classList.remove('bg-white', 'text-slate-500', 'border', 'border-brand-200');
      playBeep('click');
      if (ATTENDANCE) renderAttendance();
    }

    const fmtHours = m => m === null || m === undefined ? '' : `${Math.floor(m / 60)}h ${String(m % 60).padStart(2, '0')}m`;
    const fmtClock = iso => shopTime(iso);
    // A shift past midnight ends on the next calendar day; say so beside the time.
    const fmtOut = (iso, dayIso) => {
      const local = shopDateKey(iso);
      return fmtClock(iso) + (local !== dayIso ? ' <span class="text-[10px] font-bold text-slate-400">(next day)</span>' : '');
    };

    function renderAttendance() {
      const a = ATTENDANCE;
      setText('attStaff', a.staff);
      setText('attOnShift', a.onShift);
      setText('attHours', a.staff ? fmtHours(a.totalMinutes) : '0h 00m');
      setText('attMissed', a.missedOut);
      ['all', 'LOGIN', 'PUNCH'].forEach(k => {
        const el = document.querySelector(`[data-acount="${k}"]`);
        if (el) el.textContent = a.rows.filter(r => k === 'all' || r.source === k).length;
      });

      const list = a.rows.filter(r => attFilter === 'all' || r.source === attFilter);
      const body = document.getElementById('attBody');
      if (!list.length) {
        body.innerHTML = `<tr><td colspan="7" class="px-5 py-8 text-center text-xs font-bold text-slate-400">Nobody ${attFilter === 'PUNCH' ? 'punched in' : attFilter === 'LOGIN' ? 'signed in' : 'came in'} on this day</td></tr>`;
        return;
      }

      body.innerHTML = list.map(r => {
        const status = r.onShift
          ? '<span class="px-2.5 py-1 rounded-full bg-mint-50 text-mint-700 text-[11px] font-extrabold">On shift</span>'
          : r.missedOut
            ? '<span class="px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 text-[11px] font-extrabold">No logout</span>'
            : '<span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-500 text-[11px] font-extrabold">Out</span>';
        // Still in: the last out on the row belongs to an earlier session, not the end of the day.
        const out = !r.onShift && !r.missedOut && r.lastOutAt ? fmtOut(r.lastOutAt, a.date)
          : r.missedOut && r.lastOutAt ? `<span class="text-slate-400">${fmtOut(r.lastOutAt, a.date)}</span>`
          : '<span class="text-slate-300">&#8212;</span>';
        const how = r.source === 'PUNCH'
          ? `Punched${r.inBy ? ' in by ' + esc(r.inBy) : ''}${r.outBy ? ', out by ' + esc(r.outBy) : ''}`
          : 'Sign-in';
        return `<tr class="table-row border-b border-brand-50 last:border-0">
          <td class="px-4 sm:px-5 py-3">
            <div class="flex items-center gap-3">
              <span class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-white font-extrabold text-sm" style="background:${roleTint(r.roleCode)}">${esc((r.name || '?')[0].toUpperCase())}</span>
              <div class="min-w-0">
                <p class="font-extrabold text-brand-950 truncate">${esc(r.name)}</p>
                <p class="text-[11px] font-bold text-slate-400">${how}</p>
              </div>
            </div>
          </td>
          <td class="px-4 sm:px-5 py-3">${roleBadge(r.roleCode, r.roleName)}</td>
          <td class="px-4 sm:px-5 py-3 text-xs font-bold text-slate-600">${fmtClock(r.firstInAt)}</td>
          <td class="px-4 sm:px-5 py-3 text-xs font-bold text-slate-600">${out}</td>
          <td class="px-4 sm:px-5 py-3 text-right font-mono text-xs font-extrabold ${r.onShift ? 'text-mint-700' : 'text-brand-950'}">${r.minutes === null ? '<span class="text-slate-300">&#8212;</span>' : fmtHours(r.minutes) + (r.onShift ? ' <span class="text-[10px] font-bold text-mint-600">so far</span>' : '')}</td>
          <td class="px-4 sm:px-5 py-3 text-right text-xs font-bold text-slate-500">${r.inCount}</td>
          <td class="px-4 sm:px-5 py-3">${status}</td>
        </tr>`;
      }).join('');
      drawIcons();
    }

    const USERS_ENDPOINT = '@Url.Action("Users", "AdminUsers")';
    const ROLES_ENDPOINT = '@Url.Action("RoleList", "AdminUsers")';
    const ME = { id: @(ViewData["UserId"] ?? 0), role: '@ViewData["RoleCode"]' };
    const IS_ADMIN = ME.role === 'ADMIN';

    let USERS = [];
    let ROLES = [];
    let staffTab = 'users';
    let userStatus = 'all';   // All / Active / Inactive tab on each list
    let roleStatus = 'all';

    // Same chip styling as the category filters: the pressed tab is filled.
    function setFilterChip(cls, btn) {
      document.querySelectorAll('.' + cls).forEach(b => { b.classList.remove('bg-brand-600','text-white'); b.classList.add('bg-white','text-slate-500','border','border-brand-200'); });
      btn.classList.add('bg-brand-600','text-white'); btn.classList.remove('bg-white','text-slate-500','border','border-brand-200');
      playBeep('click');
    }
    function filterUsers(f, btn) { userStatus = f; setFilterChip('user-filter-btn', btn); renderUsers(); }
    function filterRoles(f, btn) { roleStatus = f; setFilterChip('role-filter-btn', btn); renderRoles(); }
    let staffBusy = false;
    let userEditing = null;   // the row being edited, or null when adding
    let roleEditing = null;
    let userRoleId = null;    // role picked in the drawer

    // Built-in roles keep fixed colours; added roles take the next from the list.
    const ROLE_TINTS = { ADMIN:'#74793f', SUPERVISOR:'#0284c7', CASHIER:'#059669', WAITER:'#d97706' };
    const EXTRA_TINTS = ['#e11d48', '#0d9488', '#9333ea', '#ea580c', '#4f46e5', '#65a30d'];
    function roleTint(code) {
      if (ROLE_TINTS[code]) return ROLE_TINTS[code];
      const extra = ROLES.filter(r => !r.builtIn).map(r => r.code);
      const i = Math.max(0, extra.indexOf(code));
      return EXTRA_TINTS[i % EXTRA_TINTS.length];
    }
    const roleBadge = (code, name) => {
      const t = roleTint(code);
      return `<span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold border" style="background:${t}14;color:${t};border-color:${t}40">${esc(name || code)}</span>`;
    };
    const switchBtn = (on, onclick, title, disabled) =>
      `<button onclick="${onclick}" title="${esc(title)}" aria-pressed="${on}" ${disabled ? 'disabled' : ''}
               class="w-11 h-6 rounded-full ${on ? 'bg-brand-600' : 'bg-slate-300'} relative transition-colors inline-block align-middle ${disabled ? 'opacity-40 cursor-not-allowed' : ''}">
         <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform ${on ? 'translate-x-5' : ''}"></span>
       </button>`;
    const iconBtn = (icon, onclick, title, tone, disabled) =>
      `<button onclick="${onclick}" title="${esc(title)}" ${disabled ? 'disabled' : ''}
               class="tap w-8 h-8 rounded-lg inline-flex items-center justify-center ${disabled ? 'bg-slate-50 text-slate-300 cursor-not-allowed' : tone}"><i data-lucide="${icon}" class="w-3.5 h-3.5"></i></button>`;

    function setStaffTab(tab) {
      staffTab = tab;
      document.querySelectorAll('.staff-tab-btn').forEach(b => {
        const on = b.dataset.stab === tab;
        b.classList.toggle('bg-white', on); b.classList.toggle('text-brand-700', on); b.classList.toggle('shadow-soft', on);
        b.classList.toggle('text-slate-500', !on);
      });
      document.getElementById('usersPane').classList.toggle('hidden', tab !== 'users');
      document.getElementById('rolesPane').classList.toggle('hidden', tab !== 'roles');
      setText('staffAddLabel', tab === 'users' ? 'Add User' : 'Add Role');
      // Roles are an Admin-only edit, so a supervisor is not offered the button.
      document.getElementById('staffAddBtn').classList.toggle('hidden', tab === 'roles' && !IS_ADMIN);
    }

    async function loadStaffSection(manual = false) {
      if (manual) playBeep('click');
      try {
        [USERS, ROLES] = await Promise.all([catFetch(USERS_ENDPOINT), catFetch(ROLES_ENDPOINT)]);
        renderUsers();
        renderRoles();
      } catch (e) {
        if (e.message === 'auth') return;
        const fail = msg => `<tr><td colspan="6" class="px-5 py-8 text-center text-xs font-bold text-rose-500">${msg}</td></tr>`;
        document.getElementById('usersBody').innerHTML = fail('Could not load users');
        document.getElementById('rolesBody').innerHTML = fail('Could not load roles');
      }
    }

    // ---------- users list ----------
    function fillUserRoleFilter() {
      const sel = document.getElementById('userRoleFilter');
      const keep = sel.value;
      sel.innerHTML = '<option value="">All roles</option>' +
        ROLES.map(r => `<option value="${r.id}">${esc(r.name)}${r.isActive ? '' : ' (off)'}</option>`).join('');
      sel.value = [...sel.options].some(o => o.value === keep) ? keep : '';
    }

    function renderUsers() {
      fillUserRoleFilter();
      setText('usersTabCount', USERS.length);

      const q      = document.getElementById('userSearch').value.trim().toLowerCase();
      const roleId = document.getElementById('userRoleFilter').value;
      const status = userStatus;

      // Tab counts follow the search and role filter, so each tab says what it will show.
      const matched = USERS.filter(u =>
        (!roleId || String(u.roleId) === roleId) &&
        (!q || u.displayName.toLowerCase().includes(q) || u.username.toLowerCase().includes(q) || (u.phone || '').includes(q)));
      const activeCount = matched.filter(u => u.isActive).length;
      setText('userCountAll', matched.length);
      setText('userCountActive', activeCount);
      setText('userCountInactive', matched.length - activeCount);

      const list = USERS.filter(u =>
        (!roleId || String(u.roleId) === roleId) &&
        (status === 'all' || u.isActive === (status === 'active')) &&
        (!q || u.displayName.toLowerCase().includes(q) || u.username.toLowerCase().includes(q) || (u.phone || '').includes(q)));

      const body = document.getElementById('usersBody');
      if (!list.length) {
        body.innerHTML = `<tr><td colspan="6" class="px-5 py-8 text-center text-xs font-bold text-slate-400">No ${status === 'all' ? '' : status + ' '}users match</td></tr>`;
        return;
      }

      body.innerHTML = list.map(u => {
        const self = u.id === ME.id;
        const locked = u.roleCode === 'ADMIN' && !IS_ADMIN;   // supervisor looking at an admin
        const role = ROLES.find(r => r.id === u.roleId);
        const tint = roleTint(u.roleCode);
        const toggleWhy = locked ? 'Only an Admin can change an Admin account' : self ? 'You cannot deactivate yourself' : (u.isActive ? 'Deactivate' : 'Activate');
        const delWhy = locked ? 'Only an Admin can remove an Admin account' : self ? 'You cannot delete yourself'
                     : u.inUse ? 'Has bills on record - deactivate instead' : 'Delete';
        return `<tr class="table-row border-b border-brand-50 last:border-0 ${u.isActive ? '' : 'opacity-60'}">
          <td class="px-4 sm:px-5 py-3">
            <div class="flex items-center gap-3">
              <span class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-white font-extrabold text-sm" style="background:${u.isActive ? tint : '#94a3b8'}">${esc((u.displayName || u.username)[0].toUpperCase())}</span>
              <div class="min-w-0">
                <p class="font-extrabold text-brand-950 truncate">${esc(u.displayName)}${self ? ' <span class="text-[10px] font-bold text-brand-500">(you)</span>' : ''}</p>
                ${u.canSignIn
                  ? `<p class="text-[11px] font-mono font-bold text-slate-400">${esc(u.username)}</p>`
                  : '<p class="text-[11px] font-bold text-slate-400 flex items-center gap-1"><i data-lucide="user-x" class="w-3 h-3"></i> No sign-in</p>'}
              </div>
            </div>
          </td>
          <td class="px-4 sm:px-5 py-3 font-mono text-xs font-bold text-slate-500">${u.phone ? esc(u.phone) : '<span class="text-slate-300">&#8212;</span>'}</td>
          <td class="px-4 sm:px-5 py-3">${roleBadge(u.roleCode, u.roleName)}${role && !role.isActive ? '<p class="text-[10px] font-bold text-amber-600 mt-1">Role is off - cannot sign in</p>' : ''}</td>
          <td class="px-4 sm:px-5 py-3 text-xs font-bold text-slate-500">${!u.canSignIn ? '<span class="text-slate-300">Picker only</span>'
            : u.lastLoginAt ? esc(timeAgo(u.lastLoginAt)) : '<span class="text-slate-300">Never</span>'}</td>
          <td class="px-4 sm:px-5 py-3 text-center">${switchBtn(u.isActive, `toggleUser(${u.id})`, toggleWhy, locked || self)}</td>
          <td class="px-4 sm:px-5 py-3 text-right whitespace-nowrap">
            ${iconBtn('pencil', `openUserDrawer(${u.id})`, locked ? 'Only an Admin can edit an Admin account' : 'Edit', 'bg-brand-50 text-brand-700 hover:bg-brand-100', locked)}
            ${iconBtn('trash-2', `confirmDeleteUser(${u.id})`, delWhy, 'bg-rose-50 text-rose-600 hover:bg-rose-100', locked || self || u.inUse)}
          </td>
        </tr>`;
      }).join('');
      drawIcons();
    }

    async function toggleUser(id) {
      const u = USERS.find(x => x.id === id);
      if (!u || staffBusy) return;
      staffBusy = true;
      playBeep('click');
      try {
        const saved = await catFetch(`${USERS_ENDPOINT}/${id}/active`, { method: 'POST', body: JSON.stringify({ isActive: !u.isActive }) });
        u.isActive = saved.isActive;
        renderUsers();
        renderRoles();
        showToast(`${u.displayName} ${u.isActive ? 'activated' : 'deactivated'}`);
      } catch (e) {
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        staffBusy = false;
      }
    }

    function confirmDeleteUser(id) {
      const u = USERS.find(x => x.id === id);
      if (!u) return;
      setText('confirmTitle', 'Delete user?');
      document.getElementById('confirmMsg').textContent = `${u.displayName} (${u.username}) will be removed and can no longer sign in.`;
      document.getElementById('confirmOkBtn').onclick = () => deleteUser(id);
      const m = document.getElementById('confirmModal');
      m.classList.remove('hidden'); m.classList.add('flex');
      drawIcons();
    }

    async function deleteUser(id) {
      const u = USERS.find(x => x.id === id);
      if (staffBusy) return;
      staffBusy = true;
      try {
        await catFetch(`${USERS_ENDPOINT}/${id}`, { method: 'DELETE' });
        closeConfirm();
        await loadStaffSection();
        showToast(`${u?.displayName || 'User'} deleted`);
      } catch (e) {
        closeConfirm();
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        staffBusy = false;
      }
    }

    // ---------- roles list ----------
    function renderRoles() {
      setText('rolesTabCount', ROLES.length);
      const activeCount = ROLES.filter(r => r.isActive).length;
      setText('roleCountAll', ROLES.length);
      setText('roleCountActive', activeCount);
      setText('roleCountInactive', ROLES.length - activeCount);

      const list = roleStatus === 'all' ? ROLES : ROLES.filter(r => r.isActive === (roleStatus === 'active'));
      const body = document.getElementById('rolesBody');
      if (!list.length) {
        body.innerHTML = `<tr><td colspan="6" class="px-5 py-8 text-center text-xs font-bold text-slate-400">No ${roleStatus === 'all' ? '' : roleStatus + ' '}roles</td></tr>`;
        return;
      }
      body.innerHTML = list.map(r => {
        const mine = r.code === ME.role;
        const toggleWhy = !IS_ADMIN ? 'Only an Admin can change roles'
                        : r.code === 'ADMIN' ? 'The Admin role cannot be switched off'
                        : mine ? 'You cannot switch off your own role' : (r.isActive ? 'Switch off' : 'Switch on');
        const delWhy = !IS_ADMIN ? 'Only an Admin can change roles'
                     : r.builtIn ? 'Built-in role - switch it off instead'
                     : r.users > 0 ? 'Has users - move them first' : 'Delete';
        const access = r.canAdmin
          ? '<span class="inline-flex items-center gap-1 text-[11px] font-extrabold text-brand-700"><i data-lucide="layout-dashboard" class="w-3.5 h-3.5"></i> Admin + POS</span>'
          : !r.canSignIn
          ? '<span class="inline-flex items-center gap-1 text-[11px] font-extrabold text-amber-700"><i data-lucide="list-checks" class="w-3.5 h-3.5"></i> Picker only - no sign-in</span>'
          : '<span class="inline-flex items-center gap-1 text-[11px] font-extrabold text-slate-500"><i data-lucide="monitor" class="w-3.5 h-3.5"></i> POS only</span>';
        return `<tr class="table-row border-b border-brand-50 last:border-0 ${r.isActive ? '' : 'opacity-60'}">
          <td class="px-4 sm:px-5 py-3">
            <div class="flex items-center gap-3">
              <span class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-white" style="background:${roleTint(r.code)}"><i data-lucide="${r.canAdmin ? 'shield-check' : 'user'}" class="w-[18px] h-[18px]"></i></span>
              <div class="min-w-0">
                <p class="font-extrabold text-brand-950">${esc(r.name)}</p>
                ${r.builtIn ? '<p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Built-in</p>' : ''}
              </div>
            </div>
          </td>
          <td class="px-4 sm:px-5 py-3 font-mono text-xs font-bold text-slate-400">${esc(r.code)}</td>
          <td class="px-4 sm:px-5 py-3">${access}</td>
          <td class="px-4 sm:px-5 py-3 text-right font-bold text-slate-600 font-mono" title="${r.activeUsers} active">${r.users}</td>
          <td class="px-4 sm:px-5 py-3 text-center">${switchBtn(r.isActive, `toggleRole(${r.id})`, toggleWhy, !IS_ADMIN || r.code === 'ADMIN' || mine)}</td>
          <td class="px-4 sm:px-5 py-3 text-right whitespace-nowrap">
            ${iconBtn(IS_ADMIN ? 'pencil' : 'eye', `openRoleDrawer(${r.id})`, IS_ADMIN ? 'Edit' : 'View', 'bg-brand-50 text-brand-700 hover:bg-brand-100', false)}
            ${iconBtn('trash-2', `confirmDeleteRole(${r.id})`, delWhy, 'bg-rose-50 text-rose-600 hover:bg-rose-100', !IS_ADMIN || r.builtIn || r.users > 0)}
          </td>
        </tr>`;
      }).join('');
      drawIcons();
    }

    async function toggleRole(id) {
      const r = ROLES.find(x => x.id === id);
      if (!r || staffBusy) return;
      staffBusy = true;
      playBeep('click');
      try {
        const saved = await catFetch(`${ROLES_ENDPOINT}/${id}/active`, { method: 'POST', body: JSON.stringify({ isActive: !r.isActive }) });
        r.isActive = saved.isActive;
        renderRoles();
        renderUsers();
        showToast(r.isActive ? `${r.name} switched on`
          : r.canSignIn ? `${r.name} switched off - its ${r.users} user(s) cannot sign in`
          : `${r.name} switched off - hidden from the waiter picker`);
      } catch (e) {
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        staffBusy = false;
      }
    }

    function confirmDeleteRole(id) {
      const r = ROLES.find(x => x.id === id);
      if (!r) return;
      setText('confirmTitle', 'Delete role?');
      document.getElementById('confirmMsg').textContent = `The "${r.name}" role will be removed permanently.`;
      document.getElementById('confirmOkBtn').onclick = () => deleteRole(id);
      const m = document.getElementById('confirmModal');
      m.classList.remove('hidden'); m.classList.add('flex');
      drawIcons();
    }

    async function deleteRole(id) {
      const r = ROLES.find(x => x.id === id);
      if (staffBusy) return;
      staffBusy = true;
      try {
        await catFetch(`${ROLES_ENDPOINT}/${id}`, { method: 'DELETE' });
        closeConfirm();
        await loadStaffSection();
        showToast(`${r?.name || 'Role'} deleted`);
      } catch (e) {
        closeConfirm();
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        staffBusy = false;
      }
    }

    // ---------- off-canvas drawer ----------
    function openStaffDrawer(pane, title, sub, saveLabel) {
      const d = document.getElementById('staffDrawer');
      d.dataset.pane = pane;
      setText('drawerTitle', title);
      setText('drawerSub', sub);
      setText('drawerSaveLabel', saveLabel);
      document.getElementById('drawerSaveBtn').classList.toggle('hidden', !saveLabel);
      d.classList.add('open');
      document.getElementById('staffDrawerBackdrop').classList.add('open');
      drawIcons();
      playBeep('click');
    }
    function closeStaffDrawer() {
      document.getElementById('staffDrawer').classList.remove('open');
      document.getElementById('staffDrawerBackdrop').classList.remove('open');
      userEditing = roleEditing = null;
    }
    function saveStaffDrawer() {
      return document.getElementById('staffDrawer').dataset.pane === 'user' ? saveUser() : saveRole();
    }
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && document.getElementById('staffDrawer').classList.contains('open')) closeStaffDrawer();
    });
    ['uName', 'uUsername', 'uPhone', 'uPassword', 'rName', 'rCode', 'rSort'].forEach(id =>
      document.getElementById(id).addEventListener('keydown', e => { if (e.key === 'Enter') saveStaffDrawer(); }));

    // ---------- user form ----------
    function renderUserRolePicker() {
      const current = userEditing?.roleId;
      const self = userEditing && userEditing.id === ME.id;
      document.getElementById('uRolePicker').innerHTML = ROLES
        // An off role is shown only when the account already sits on it.
        .filter(r => r.isActive || r.id === current)
        .map(r => {
          const on = r.id === userRoleId;
          const t = roleTint(r.code);
          const blocked = (r.code === 'ADMIN' && !IS_ADMIN) || (self && r.id !== current);
          return `<button type="button" onclick="pickUserRole(${r.id})" ${blocked ? 'disabled' : ''}
                    title="${blocked ? (self ? 'You cannot change your own role' : 'Only an Admin can grant this role') : ''}"
                    class="tap px-3 py-2.5 rounded-xl border-2 text-left ${blocked ? 'opacity-40 cursor-not-allowed' : ''}"
                    style="${on ? `background:${t};border-color:${t};color:#fff` : `background:#fff;border-color:${t}33;color:${t}`}">
                    <span class="block text-sm font-extrabold">${esc(r.name)}${r.isActive ? '' : ' (off)'}</span>
                    <span class="block text-[10px] font-bold ${on ? 'text-white/80' : 'text-slate-400'}">${r.canAdmin ? 'Admin + POS' : r.canSignIn ? 'POS only' : 'Picker only, no sign-in'}</span>
                  </button>`;
        }).join('');
    }
    function pickUserRole(id) { userRoleId = id; renderUserRolePicker(); updateUserNote(); playBeep('click'); }

    // Waiters only need a name: they are picked on the bill, never signed in, so the
    // username and password fields are taken away while that role is chosen.
    const pickedRoleSignsIn = () => ROLES.find(x => x.id === userRoleId)?.canSignIn !== false;

    function updateUserNote() {
      const r = ROLES.find(x => x.id === userRoleId);
      const signsIn = pickedRoleSignsIn();

      document.getElementById('uUsernameWrap').classList.toggle('hidden', !signsIn);
      document.getElementById('uPwdWrap').classList.toggle('hidden', !signsIn);
      document.getElementById('uSignInHint').classList.toggle('hidden', !signsIn);
      document.getElementById('uIdRow').classList.toggle('sm:grid-cols-2', signsIn);
      setText('uActiveSub', signsIn ? 'Can sign in' : 'Shown in the waiter picker');

      // A password can only be kept if the account already had one to sign in with.
      const hasPwd = !!userEditing && userEditing.canSignIn;
      document.getElementById('uPassword').placeholder = hasPwd ? 'Unchanged' : 'At least 4 characters';
      document.getElementById('uPwdHint').classList.toggle('hidden', !hasPwd);

      const msg = r && !r.isActive ? `The ${r.name} role is switched off, so this account ${signsIn ? 'cannot sign in' : 'is hidden from the picker'} until it is on again.`
                : !signsIn ? `${r.name} staff do not sign in. They only appear in the till's waiter picker when a bill is settled.`
                : r?.canAdmin ? `${r.name} accounts can open this Admin Panel as well as Billing POS.` : '';
      const note = document.getElementById('uNote');
      note.textContent = msg;
      note.classList.toggle('hidden', !msg);
    }

    function togglePwd() {
      const f = document.getElementById('uPassword');
      f.type = f.type === 'password' ? 'text' : 'password';
      // lucide swaps the <i> for an <svg>, so the icon is re-created rather than edited.
      f.nextElementSibling.innerHTML = `<i data-lucide="${f.type === 'password' ? 'eye' : 'eye-off'}" class="w-4 h-4"></i>`;
      drawIcons();
    }

    async function openUserDrawer(id) {
      if (!ROLES.length) await loadStaffSection();
      userEditing = id ? USERS.find(u => u.id === id) : null;
      if (id && !userEditing) return;

      document.getElementById('uName').value     = userEditing?.displayName ?? '';
      // A waiter's stored username is internal, so it is not offered as a starting point.
      document.getElementById('uUsername').value = userEditing?.canSignIn ? userEditing.username : '';
      document.getElementById('uPhone').value    = userEditing?.phone ?? '';
      const pwd = document.getElementById('uPassword');
      pwd.value = ''; pwd.type = 'password';
      const active = document.getElementById('uActive');
      active.checked  = userEditing ? userEditing.isActive : true;
      active.disabled = !!userEditing && userEditing.id === ME.id;

      // New staff default to the first POS-only role (normally Cashier).
      userRoleId = userEditing?.roleId
        ?? (ROLES.find(r => r.isActive && !r.canAdmin) || ROLES.find(r => r.isActive))?.id ?? null;
      renderUserRolePicker();
      updateUserNote();

      openStaffDrawer('user',
        userEditing ? 'Edit User' : 'Add User',
        !userEditing ? 'A new staff member'
          : !userEditing.canSignIn ? `${userEditing.roleName} - picked on the bill, no sign-in`
          : `${userEditing.username}${userEditing.lastLoginAt ? ' - last signed in ' + timeAgo(userEditing.lastLoginAt) : ' - never signed in'}`,
        userEditing ? 'Save Changes' : 'Add User');
      setTimeout(() => document.getElementById('uName').focus(), 320);
    }

    async function saveUser() {
      const body = {
        displayName: document.getElementById('uName').value.trim(),
        username:    document.getElementById('uUsername').value.trim().toLowerCase(),
        phone:       document.getElementById('uPhone').value.trim(),
        password:    document.getElementById('uPassword').value,
        roleId:      userRoleId,
        isActive:    document.getElementById('uActive').checked
      };
      if (!body.displayName) { showToast('Enter the full name', 'error'); return; }
      if (!body.roleId) { showToast('Choose a role', 'error'); return; }
      if (pickedRoleSignsIn()) {
        if (!/^[a-z0-9._-]{3,50}$/.test(body.username)) { showToast('Username: 3-50 letters, digits, dot, dash or underscore', 'error'); return; }
        if (!(userEditing?.canSignIn) && !body.password) { showToast('Set a password - this role signs in', 'error'); return; }
        if (body.password && body.password.length < 4) { showToast('Password must be at least 4 characters', 'error'); return; }
      } else {
        // Nothing to sign in with: the server makes the username and clears the password.
        body.username = ''; body.password = '';
      }
      if (staffBusy) return;

      staffBusy = true;
      const btn = document.getElementById('drawerSaveBtn');
      btn.disabled = true;
      const editing = userEditing;
      try {
        await catFetch(editing ? `${USERS_ENDPOINT}/${editing.id}` : USERS_ENDPOINT,
                       { method: editing ? 'PUT' : 'POST', body: JSON.stringify(body) });
        closeStaffDrawer();
        await loadStaffSection();
        showToast(editing ? `${body.displayName} updated`
          : body.username ? `${body.displayName} added - signs in as "${body.username}"`
          : `${body.displayName} added to the waiter picker`);
      } catch (e) {
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        staffBusy = false;
        btn.disabled = false;
      }
    }

    // ---------- role form ----------
    function suggestRoleCode() {
      const code = document.getElementById('rCode');
      if (roleEditing || code.dataset.touched === '1') return;
      code.value = document.getElementById('rName').value.toUpperCase().replace(/[^A-Z0-9]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 20);
    }

    function openRoleDrawer(id) {
      roleEditing = id ? ROLES.find(r => r.id === id) : null;
      if (id && !roleEditing) return;
      const readOnly = !IS_ADMIN;

      const name = document.getElementById('rName');
      const code = document.getElementById('rCode');
      const sort = document.getElementById('rSort');
      name.value = roleEditing?.name ?? '';
      code.value = roleEditing?.code ?? '';
      code.dataset.touched = '';
      sort.value = roleEditing?.sortOrder ?? (Math.max(0, ...ROLES.map(r => r.sortOrder)) + 1);
      code.disabled = !!roleEditing || readOnly;
      name.disabled = sort.disabled = readOnly;
      document.getElementById('rCodeHint').classList.toggle('hidden', !!roleEditing);

      const canAdmin = roleEditing?.canAdmin;
      const access = document.getElementById('rAccess');
      access.className = `p-3 rounded-xl border text-xs font-semibold ${canAdmin ? 'bg-brand-50 border-brand-200 text-brand-800' : 'bg-slate-50 border-slate-200 text-slate-600'}`;
      access.textContent = canAdmin
        ? 'Staff on this role can open the Admin Panel and Billing POS.'
        : roleEditing && !roleEditing.canSignIn
          ? 'Staff on this role do not sign in. They have no username or password and are only picked from the waiter list when a bill is settled.'
          : 'Staff on this role open Billing POS only. Admin Panel access is limited to Admin and Supervisor.';

      const members = roleEditing ? USERS.filter(u => u.roleId === roleEditing.id) : [];
      document.getElementById('rUsersWrap').classList.toggle('hidden', !members.length);
      document.getElementById('rUsers').innerHTML = members.map(u =>
        `<span class="px-2.5 py-1 rounded-lg text-[11px] font-bold border ${u.isActive ? 'bg-white border-brand-200 text-slate-600' : 'bg-slate-50 border-slate-200 text-slate-400 line-through'}">${esc(u.displayName)}</span>`).join('');

      openStaffDrawer('role',
        readOnly ? roleEditing.name : roleEditing ? 'Edit Role' : 'Add Role',
        roleEditing ? `${roleEditing.users} user(s)${roleEditing.builtIn ? ' - built-in role' : ''}` : 'A new role staff can be given',
        readOnly ? '' : roleEditing ? 'Save Changes' : 'Add Role');
      if (!readOnly) setTimeout(() => name.focus(), 320);
    }

    async function saveRole() {
      const name = document.getElementById('rName').value.trim();
      const sortVal = document.getElementById('rSort').value;
      const body = { name, sortOrder: sortVal === '' ? null : parseInt(sortVal, 10) };
      if (!roleEditing) body.code = document.getElementById('rCode').value.trim();
      if (!name) { showToast('Enter a role name', 'error'); return; }
      if (staffBusy) return;

      staffBusy = true;
      const btn = document.getElementById('drawerSaveBtn');
      btn.disabled = true;
      const editing = roleEditing;
      try {
        await catFetch(editing ? `${ROLES_ENDPOINT}/${editing.id}` : ROLES_ENDPOINT,
                       { method: editing ? 'PUT' : 'POST', body: JSON.stringify(body) });
        closeStaffDrawer();
        await loadStaffSection();
        showToast(editing ? `${name} updated` : `${name} role added`);
      } catch (e) {
        if (e.message !== 'auth') showToast(e.message || 'Could not reach the database', 'error');
      } finally {
        staffBusy = false;
        btn.disabled = false;
      }
    }

    // ===================== SOUND =====================
    let audioCtx = null;
    function playBeep(type = 'click') {
      try {
        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const o = audioCtx.createOscillator(), g = audioCtx.createGain();
        const t = audioCtx.currentTime;
        const presets = { click:[1200,.03,.06], success:[880,.08,.2], error:[280,.1,.15], delete:[600,.04,.08] };
        const [freq, vol, dur] = presets[type] || presets.click;
        o.frequency.setValueAtTime(freq, t);
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(.001, t + dur);
        o.connect(g).connect(audioCtx.destination);
        o.start(t); o.stop(t + dur);
      } catch(e){}
    }

    // ===================== INIT =====================
    document.addEventListener('DOMContentLoaded', () => {
      drawIcons();
      tickClock();
      setOrderTab('orders');
      setStaffTab('users');
      loadDashboard();
    });

    // The counter leaves this panel open all day, so the figures are re-read on a
    // timer as well as on the button. Polling is skipped while the tab is hidden or
    // another section is showing: nothing would be visible to update, and an idle
    // back office should not hold a query open every minute.
    setInterval(() => {
      if (document.hidden) return;
      if (!document.getElementById('sec-dashboard').classList.contains('active')) return;
      loadDashboard();
    }, DASH_REFRESH_MS);

    // Coming back to the tab or the section is exactly when the figures on screen
    // are most likely to be stale.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && document.getElementById('sec-dashboard').classList.contains('active')) loadDashboard();
    });
    window.addEventListener('load', drawIcons);
  </script>
</body>
</html>
