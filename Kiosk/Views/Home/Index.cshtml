  <script>
    // ================= DATA FROM SERVER =================
    // App base path: "/" when hosted at the root, "/pos/" under an IIS virtual
    // directory. Every server call is built from this so the app can move hosts.
    const BASE = '@Url.Content("~/")';

    const _posData = @Html.Raw(ViewData["PosData"]);
    const INITIAL_CATEGORIES = _posData.categories;
    const INITIAL_MENU_CATALOG = _posData.catalog;

    // Rates from config_terminal_setting. The source of truth is the database, so
    // nothing below hardcodes 10 or 5 — change the row in the Admin Panel and
    // every till picks it up on its next load.
    const CONFIG_SERVICE_CHARGE = _posData.serviceChargePercent;
    const CONFIG_GST = _posData.gstPercent;

    const AppState = {
      orderMode: 'dinein', tableNo: 'T5', persons: 2, seqNo: @(ViewData["NextSeq"]),
      customer: 'Walk-in', phone: '',
      activeCategory: INITIAL_CATEGORIES[0]?.id || 'ALL',
      activeFilterQuery: '', vegFilter: 'all', lastDishId: null,
      selectedCartIndex: -1, cart: [],
      openOrderId: null,   // set once saved unpaid, so Pay settles that row
      waiterId: null,      // staff the bill is credited to; null for counter sales
      waiters: [],         // picker options, refreshed from the server
      billType: 'single',  // 'single' | 'split' — payment shape only
      mergeFrom: new Set(),// bills staged for merge; absorbed only when this bill saves
      discountPercent: 0, serviceChargePercent: CONFIG_SERVICE_CHARGE, gstPercent: CONFIG_GST, incdtl: 0,
      currency: SHOP_TIME.currency, soundEnabled: true, pendingOrders: [],
      showPaymentQr: false, payNowType: 'uen', payNowProxy: '', merchantName: '',
      categories: INITIAL_CATEGORIES, catalog: INITIAL_MENU_CATALOG
    };

    const money = v => `${AppState.currency}${v.toFixed(2)}`;
    // Cash In less Cash Out, sign before the currency. Rounded so float error cannot show as "-$0.00".
    const netAmount = (cashIn, cashOut) => Math.round((cashIn - cashOut) * 100) / 100;
    const signedMoney = v => `${v < 0 ? '-' : ''}${money(Math.abs(v))}`;
    // For typed-in text coming back from the server (customer names on holds).
    const escapeHtml = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    // Must uppercase the first character, not just lowercase the rest: it is also
    // used to build element ids from lowercase keys ('cash' -> 'Cash').
    const cap = s => s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : '';

    // Order numbers come from the Orders table and are padded to 3 digits (#007, #150).
    const orderLabel = n => `#${String(n).padStart(3, '0')}`;
    function renderSeqNo() {
      document.getElementById('seqNumberDisplay').textContent = orderLabel(AppState.seqNo);
    }

    const CAT_TINTS = ['#74793f','#0e9f6e','#d97706','#e11d48','#2563eb','#0891b2','#9333ea','#ca8a04','#db2777','#16a34a','#ea580c','#4f46e5','#0d9488','#64748b'];
    // Each category carries the colour set for it in the admin panel; it tints
    // the rail tile, the path and every item card under it.
    // The positional palette is only a fallback for a row that has none yet.
    function catTint(catId) {
      const i = AppState.categories.findIndex(c => c.id === catId);
      const color = i < 0 ? '' : AppState.categories[i].color;
      return /^#[0-9a-f]{6}$/i.test(color || '') ? color : CAT_TINTS[(i < 0 ? 0 : i) % CAT_TINTS.length];
    }

    // ================= CATEGORIES =================
    function itemsInCategory(catId) {
      if (catId === 'ALL') return AppState.catalog;
      return AppState.catalog.filter(i => i.category === catId);
    }

    function renderCategories() {
      const rail = document.getElementById('categoryRail');
      rail.innerHTML = '';
      AppState.categories.forEach(cat => {
        const active = AppState.activeCategory === cat.id;
        const count = itemsInCategory(cat.id).length;
        const tint = catTint(cat.id);
        const btn = document.createElement('button');
        btn.className = `rail-btn tap relative w-full rounded-2xl py-2.5 px-1 flex flex-col items-center gap-1 border ${active ? 'active bg-brand-50/90 border-brand-300' : 'bg-white/50 border-transparent hover:bg-slate-50'}`;
        btn.innerHTML = `
          <span class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:${active ? tint : tint + '18'};color:${active ? '#fff' : tint}">
            <i data-lucide="${cat.icon || 'utensils'}" class="w-5 h-5"></i>
          </span>
          <span class="text-[11px] font-bold leading-tight text-center ${active ? 'text-brand-900' : 'text-slate-600'}">${escapeHtml(cat.name)}</span>
          <span class="text-[9px] font-semibold text-slate-400">${count}</span>`;
        btn.onclick = () => selectCategory(cat.id);
        rail.appendChild(btn);
      });
      renderLevelPath();
    }

    function renderLevelPath() {
      const el = document.getElementById('levelPath');
      const cat = AppState.categories.find(c => c.id === AppState.activeCategory);
      const dish = AppState.catalog.find(d => d.id === AppState.lastDishId);
      const dishInPath = dish && (AppState.activeCategory === 'ALL' || dish.category === AppState.activeCategory);
      const tint = catTint(AppState.activeCategory);
      const step = (n, label, state) => {
        const styles = { done: `background:${tint};color:#fff`, idle: 'background:#f1f5f9;color:#94a3b8' };
        return `<span class="cut-frame cut inline-flex" style="--c:7px;background:${state === 'done' ? tint : '#e2e8f0'}">
          <span class="cut inline-flex items-center gap-1.5 px-2.5 py-1" style="--c:6.4px;${styles[state]}">
            <span class="text-[9px] font-extrabold opacity-80">L${n}</span>${escapeHtml(label)}</span></span>`;
      };
      const arrow = '<i data-lucide="chevron-right" class="w-3.5 h-3.5 text-brand-300"></i>';
      el.innerHTML =
        step(1, cat ? cat.name : cap(AppState.activeCategory), 'done') + arrow +
        step(2, dishInPath ? cap(dish.name) : 'Select item', dishInPath ? 'done' : 'idle');
    }

    function selectCategory(catId) {
      AppState.activeCategory = catId;
      AppState.activeFilterQuery = '';
      document.getElementById('quickDishFilterInput').value = '';
      playBeep('click');
      renderCategories(); renderDishGrid();
    }

    function setVegFilter(v) {
      AppState.vegFilter = v;
      playBeep('click');
      const map = { all: 'vegFilterAll', veg: 'vegFilterVeg', nonveg: 'vegFilterNon' };
      Object.entries(map).forEach(([k, id]) => {
        document.getElementById(id).className = `tap px-3 py-1.5 rounded-lg flex items-center gap-1 ${k === v ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-50'}`;
      });
      renderDishGrid();
    }
    function handleQuickDishFilter(q) { AppState.activeFilterQuery = q.toLowerCase().trim(); renderDishGrid(); }

    // ================= DISH GRID =================
    function renderDishGrid() {
      const grid = document.getElementById('dishGrid');
      grid.innerHTML = '';
      const q = AppState.activeFilterQuery;
      let items = q ? AppState.catalog.filter(i => i.name.toLowerCase().includes(q) || i.category.toLowerCase().includes(q))
                    : itemsInCategory(AppState.activeCategory);
      if (AppState.vegFilter === 'veg') items = items.filter(i => i.isVeg);
      if (AppState.vegFilter === 'nonveg') items = items.filter(i => !i.isVeg);

      const cat = AppState.categories.find(c => c.id === AppState.activeCategory);
      document.getElementById('dishGridCategoryLabel').textContent = q ? `Results for "${q}"` : (cat ? cat.name : cap(AppState.activeCategory));
      document.getElementById('dishGridCountLabel').textContent = `${items.length} dishes`;

      if (items.length === 0) {
        grid.innerHTML = `<div class="py-20 text-center"><div class="w-14 h-14 rounded-2xl bg-brand-100 text-brand-500 flex items-center justify-center mx-auto mb-3"><i data-lucide="search-x" class="w-7 h-7"></i></div><p class="font-bold text-slate-700">No dishes found</p><p class="text-xs text-slate-400 mt-1">Try another category or clear the search</p></div>`;
        renderLevelPath(); lucide.createIcons(); return;
      }

      const groups = [];
      items.forEach(d => {
        let g = groups.find(x => x.key === d.category);
        if (!g) { g = { key: d.category, items: [] }; groups.push(g); }
        g.items.push(d);
      });
      const labelOf = key => { const c = AppState.categories.find(x => x.id === key); return c ? c.name : cap(key); };
      const parentLabel = 'Menu';

      groups.forEach(g => {
        const tint = catTint(g.key);
        const section = document.createElement('section');
        section.className = 'tree-section';
        section.innerHTML = `
          <span class="tree-node" style="border-color:${tint}"></span>
          <div class="flex items-center gap-2 mb-2.5">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">${escapeHtml(parentLabel)}</span>
            <i data-lucide="chevron-right" class="w-3 h-3 text-slate-300"></i>
            <span class="text-sm font-extrabold text-slate-800">${escapeHtml(labelOf(g.key))}</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:${tint}18;color:${tint}">${g.items.length}</span>
            <span class="flex-1 h-px bg-brand-100"></span>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-3"></div>`;
        const inner = section.lastElementChild;
        g.items.forEach(dish => inner.appendChild(buildDishCard(dish)));
        grid.appendChild(section);
      });
      renderLevelPath();
      lucide.createIcons();
    }

    function buildDishCard(dish) {
      const qty = AppState.cart.filter(i => i.id === dish.id).reduce((a, c) => a + c.qty, 0);
      const tint = catTint(dish.category);
      const isLast = AppState.lastDishId === dish.id;
      const frame = document.createElement('div');
      frame.className = 'dish-card tap cut-frame cut relative cursor-pointer backdrop-blur-md';
      // The frame is the card's edge; the translucent face lets a little of it through as a tint.
      frame.style.background = isLast ? tint : (qty ? '#d0d3b1' : 'rgba(255,255,255,.95)');
      frame.style.padding = isLast ? '2.5px' : '1.5px';
      frame.onclick = () => addDishToCart(dish);
      frame.innerHTML = `
        <div class="cut relative flex flex-col min-h-[132px] ${qty ? 'bg-gradient-to-b from-brand-50/90 to-white/80' : 'bg-white/70'}">
          <div class="h-1.5 mr-[14px]" style="background:${tint}"></div>
          <div class="p-3 flex-1 flex flex-col">
            <div class="flex items-start justify-between gap-2">
              <span class="w-4 h-4 mt-0.5 rounded-[4px] border-[1.5px] ${dish.isVeg ? 'border-emerald-600' : 'border-rose-600'} flex items-center justify-center shrink-0"><span class="w-1.5 h-1.5 rounded-full ${dish.isVeg ? 'bg-emerald-600' : 'bg-rose-600'}"></span></span>
              ${qty ? `<span class="bg-brand-600 text-white text-[11px] font-extrabold px-2 py-0.5 rounded-full animate-pop-in">x${qty}</span>` : ''}
            </div>
            <div class="font-bold text-[13px] text-slate-800 leading-snug mt-2 line-clamp-2">${cap(dish.name)}</div>
            <div class="mt-auto pt-2 flex items-center justify-between pr-1">
              <span class="font-digital font-bold text-base text-slate-900">${money(dish.price)}</span>
              ${qty ? `
                <div class="flex items-center bg-brand-600 rounded-lg text-white" onclick="event.stopPropagation()">
                  <button class="w-7 h-7 flex items-center justify-center" onclick="changeDishQty('${dish.id}',-1)"><i data-lucide="minus" class="w-3.5 h-3.5"></i></button>
                  <button class="w-7 h-7 flex items-center justify-center" onclick="changeDishQty('${dish.id}',1)"><i data-lucide="plus" class="w-3.5 h-3.5"></i></button>
                </div>` :
                `<span class="w-7 h-7 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center"><i data-lucide="plus" class="w-4 h-4"></i></span>`}
            </div>
          </div>
        </div>`;
      return frame;
    }

    function changeDishQty(dishId, delta) {
      const idx = AppState.cart.findIndex(i => i.id === dishId && !i.modifier);
      const target = idx > -1 ? idx : AppState.cart.findIndex(i => i.id === dishId);
      if (target < 0) return;
      changeLineQty(target, delta);
    }

    // ================= CART =================
    function addDishToCart(dish) {
      playBeep('add');
      AppState.lastDishId = dish.id;
      const idx = AppState.cart.findIndex(i => i.id === dish.id && !i.modifier);
      if (idx > -1) { AppState.cart[idx].qty++; AppState.selectedCartIndex = idx; }
      else {
        AppState.cart.push({ id: dish.id, name: dish.name, qty: 1, rPrice: dish.price, cPrice: dish.price, modifier: '', foc: false });
        AppState.selectedCartIndex = AppState.cart.length - 1;
      }
      refreshAll();
    }

    function changeLineQty(index, delta) {
      const item = AppState.cart[index];
      if (!item) return;
      AppState.selectedCartIndex = index;
      item.qty += delta;
      if (item.qty <= 0) { removeSelectedItem(); return; }
      playBeep('click');
      refreshAll();
    }

    function renderCart() {
      const box = document.getElementById('cartItemsList');
      const total = AppState.cart.reduce((a, c) => a + c.qty, 0);
      document.getElementById('cartItemsBadge').textContent = `${total} item${total === 1 ? '' : 's'}`;
      box.innerHTML = '';

      if (!AppState.cart.length) {
        box.innerHTML = `<div class="h-full flex flex-col items-center justify-center text-center py-10"><div class="w-14 h-14 rounded-2xl bg-brand-50 text-brand-400 flex items-center justify-center mb-3"><i data-lucide="shopping-basket" class="w-7 h-7"></i></div><p class="font-bold text-sm text-slate-700">No items yet</p><p class="text-xs text-slate-400 mt-1">Tap a dish to add it</p></div>`;
        lucide.createIcons(); return;
      }

      AppState.cart.forEach((item, index) => {
        const sel = index === AppState.selectedCartIndex;
        const line = item.foc ? 0 : item.qty * item.rPrice;
        const row = document.createElement('div');
        row.className = `rounded-xl border p-2.5 flex items-center gap-2.5 cursor-pointer ${sel ? 'border-brand-400 bg-brand-50/70' : 'border-slate-100 hover:bg-slate-50'}`;
        row.onclick = () => selectCartRow(index);
        row.innerHTML = `
          <div class="flex-1 min-w-0">
            <div class="text-[13px] font-bold text-slate-800 truncate flex items-center gap-1.5">
              ${item.foc ? '<span class="bg-amber-100 text-amber-800 text-[9px] px-1.5 py-0.5 rounded font-extrabold">FOC</span>' : ''}${cap(item.name)}
            </div>
            <div class="text-[11px] text-slate-400 font-mono">${money(item.rPrice)} each</div>
            ${item.modifier ? `<div class="text-[11px] text-brand-700 italic truncate">&#8627; ${item.modifier}</div>` : ''}
          </div>
          <div class="flex items-center bg-white border border-slate-200 rounded-lg" onclick="event.stopPropagation()">
            <button class="tap w-8 h-8 flex items-center justify-center text-slate-600" onclick="changeLineQty(${index},-1)"><i data-lucide="minus" class="w-3.5 h-3.5"></i></button>
            <span class="w-6 text-center font-mono font-bold text-sm">${item.qty}</span>
            <button class="tap w-8 h-8 flex items-center justify-center text-brand-700" onclick="changeLineQty(${index},1)"><i data-lucide="plus" class="w-3.5 h-3.5"></i></button>
          </div>
          <div class="w-16 text-right font-mono font-bold text-sm ${item.foc ? 'text-amber-600 line-through' : 'text-slate-900'}">${money(item.foc ? item.qty * item.rPrice : line)}</div>
          <button class="tap w-8 h-8 shrink-0 flex items-center justify-center rounded-lg text-rose-500 hover:bg-rose-50 border border-transparent hover:border-rose-200" title="Remove item" onclick="event.stopPropagation(); removeCartItem(${index})"><i data-lucide="x" class="w-4 h-4"></i></button>`;
        box.appendChild(row);
      });
      const r = box.children[AppState.selectedCartIndex];
      if (r) r.scrollIntoView({ block: 'nearest' });
      lucide.createIcons();
    }

    // Cart state goes to the customer display through the server, so the display
    // can be any browser, profile or machine — not just another tab in this one.
    function postToDisplay(body) {
      fetch(BASE + 'api/display/state', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body,
        keepalive: true
      }).catch(() => { });
    }

    function buildDisplayState() {
      const t = computeTotals();
      return {
        type: 'update',
        cart: AppState.cart,
        totals: {
          subTotal: t.subTotal, discountAmt: t.discountAmt,
          serviceChargeAmt: t.serviceChargeAmt, gstAmt: t.gstAmt, netTotal: t.netTotal,
          discountPercent: AppState.discountPercent,
          serviceChargePercent: AppState.serviceChargePercent,
          gstPercent: AppState.gstPercent
        },
        seqNo: AppState.seqNo,
        orderMode: AppState.orderMode,
        tableNo: AppState.tableNo,
        currency: AppState.currency,
        showQr: AppState.showPaymentQr,
        payNowType: AppState.payNowType,
        payNowProxy: AppState.payNowProxy,
        merchantName: AppState.merchantName
      };
    }

    let _lastBroadcast = '';
    function broadcastCart(force) {
      const sig = JSON.stringify(buildDisplayState());
      if (!force && sig === _lastBroadcast) return;
      _lastBroadcast = sig;
      postToDisplay(sig);
    }

    // Safety net: any mutation reaches the display within ~200ms regardless of
    // which code path changed it. The signature check makes unchanged ticks free.
    setInterval(() => broadcastCart(), 200);

    function refreshAll() { renderCart(); calculateTotals(); renderDishGrid(); broadcastCart(); }
    function selectCartRow(i) { AppState.selectedCartIndex = i; playBeep('click'); renderCart(); }

    function moveSelection(d) {
      if (!AppState.cart.length) return;
      AppState.selectedCartIndex = Math.min(AppState.cart.length - 1, Math.max(0, AppState.selectedCartIndex + d));
      playBeep('click'); renderCart();
    }
    function adjustSelectedQty(d) { if (AppState.selectedCartIndex < 0) return; changeLineQty(AppState.selectedCartIndex, d); }

    function removeCartItem(index) {
      if (index < 0 || index >= AppState.cart.length) return;
      AppState.selectedCartIndex = index;
      removeSelectedItem();
    }

    function removeSelectedItem() {
      const i = AppState.selectedCartIndex;
      if (i < 0 || i >= AppState.cart.length) { showPOSNotification('warning', 'No Item Selected', 'Tap an item in the order first.'); return; }
      playBeep('delete');
      const [removed] = AppState.cart.splice(i, 1);
      showPOSNotification('info', 'Item Removed', `Removed ${cap(removed.name)}.`);
      if (AppState.selectedCartIndex >= AppState.cart.length) AppState.selectedCartIndex = AppState.cart.length - 1;
      refreshAll();
    }

    function toggleFOCForSelected() {
      const item = AppState.cart[AppState.selectedCartIndex];
      if (!item) { showPOSNotification('warning', 'No Item Selected', 'Tap an item in the order first.'); return; }
      item.foc = !item.foc; playBeep('click');
      showPOSNotification('info', 'FOC Updated', `${cap(item.name)} is ${item.foc ? 'free of charge' : 'back to normal price'}.`);
      renderCart(); calculateTotals(); broadcastCart();
    }

    function computeTotals() {
      const subTotal = AppState.cart.reduce((a, i) => a + (i.foc ? 0 : i.qty * i.rPrice), 0);
      const discountAmt = subTotal * AppState.discountPercent / 100;
      const discountedSub = Math.max(0, subTotal - discountAmt);
      const serviceChargeAmt = discountedSub * AppState.serviceChargePercent / 100;
      const gstAmt = discountedSub * AppState.gstPercent / 100;
      const netTotal = discountedSub + serviceChargeAmt + gstAmt + AppState.incdtl;
      return { subTotal, discountAmt, serviceChargeAmt, gstAmt, netTotal };
    }

    function calculateTotals() {
      const t = computeTotals();
      const set = (id, v) => document.getElementById(id).textContent = v;
      set('summarySubTotal', money(t.subTotal));
      set('summaryDiscount', `-${money(t.discountAmt)}`);
      set('summaryServiceCharge', money(t.serviceChargeAmt));
      set('summaryIncdtl', money(AppState.incdtl));
      set('summaryGST', money(t.gstAmt));
      set('summaryNetTotal', money(t.netTotal));
      set('payBtnTotal', money(t.netTotal));
      set('discountPercentLabel', `${AppState.discountPercent.toFixed(2)}%`);
      set('servicePercentLabel', `${AppState.serviceChargePercent.toFixed(2)}%`);
      set('gstPercentLabel', `${AppState.gstPercent.toFixed(2)}%`);
      broadcastCart();
      return t;
    }

    // Collapsed by default; the choice is remembered per device.
    function toggleTotalsBreakdown(open) {
      const box = document.getElementById('totalsBreakdown');
      if (open === undefined) open = box.classList.contains('hidden');
      box.classList.toggle('hidden', !open);
      document.getElementById('totalsBreakdownChevron').classList.toggle('rotate-180', open);
      try { localStorage.setItem('pos.totalsOpen', open ? '1' : '0'); } catch { }
    }

    // ================= MODALS =================
    function openModal(id) { playBeep('click'); document.getElementById(id).classList.remove('hidden'); lucide.createIcons(); }
    function closeModal(id) { playBeep('click'); document.getElementById(id).classList.add('hidden'); closeGlobalVirtualKeyboard(); }

    // ================= CONFIRM =================
    // posConfirm({ title, lines, okText, tone, warn }) resolves true on OK, false on
    // Cancel or Esc. tone 'danger' paints OK red. warn adds an amber box:
    // { title, text, actionText, action } where action runs after Cancel.
    let _confirmResolve = null;
    function posConfirm({ title, lines = [], okText = 'OK', tone = 'primary', warn = null }) {
      if (_confirmResolve) _confirmResolve(false);
      document.getElementById('confirmTitle').textContent = title;
      const body = document.getElementById('confirmBody');
      body.innerHTML = '';
      lines.forEach(l => { const p = document.createElement('p'); p.textContent = l; body.appendChild(p); });

      const danger = tone === 'danger';
      document.getElementById('confirmIconWrap').className = `w-10 h-10 rounded-xl flex items-center justify-center shrink-0 ${danger ? 'bg-rose-100 text-rose-600' : 'bg-brand-100 text-brand-700'}`;
      document.getElementById('confirmIcon').outerHTML = `<i id="confirmIcon" data-lucide="${danger ? 'alert-octagon' : 'help-circle'}" class="w-5 h-5"></i>`;
      const ok = document.getElementById('confirmOkBtn');
      ok.textContent = okText;
      ok.className = `tap h-11 rounded-xl text-white font-extrabold text-sm ${danger ? 'bg-rose-600 hover:bg-rose-700' : 'bg-brand-600 hover:bg-brand-700'}`;

      document.getElementById('confirmWarn').classList.toggle('hidden', !warn);
      const act = document.getElementById('confirmWarnAction');
      act.classList.toggle('hidden', !warn?.action);
      if (warn) {
        document.getElementById('confirmWarnTitle').textContent = warn.title;
        document.getElementById('confirmWarnText').textContent = warn.text;
        document.getElementById('confirmWarnActionText').textContent = warn.actionText || '';
        act.onclick = () => { resolveConfirm(false); warn.action?.(); };
      }

      openModal('confirmModal');
      return new Promise(r => { _confirmResolve = r; });
    }
    function resolveConfirm(answer) {
      document.getElementById('confirmModal').classList.add('hidden');
      const r = _confirmResolve; _confirmResolve = null;
      if (r) r(answer);
    }
    function toggleMoreMenu(e) { e.stopPropagation(); document.getElementById('moreMenu').classList.toggle('hidden'); playBeep('click'); }
    function closeMoreMenu() { document.getElementById('moreMenu').classList.add('hidden'); }
    document.addEventListener('click', e => { if (!e.target.closest('#moreMenu')) closeMoreMenu(); });

    // stopPropagation, or the listener below would close the menu this click opened.
    function togglePowerMenu(e) { e.stopPropagation(); closeMoreMenu(); document.getElementById('powerMenu').classList.toggle('hidden'); lucide.createIcons(); playBeep('click'); }
    function closePowerMenu() { document.getElementById('powerMenu').classList.add('hidden'); }
    document.addEventListener('click', e => { if (!e.target.closest('#powerMenu')) closePowerMenu(); });

    // Below lg the order panel is a sheet over the menu. From lg up it is a column
    // and lg:translate-y-0 wins, so the class flip does nothing there.
    function toggleOrderSheet(open) {
      document.getElementById('orderPanel').classList.toggle('translate-y-full', !open);
      if (!open) closeMoreMenu();
      playBeep('click');
    }

    // The order bar repeats the panel's item count and total. Mirrored from the
    // panel's own labels, so every path that updates them updates the bar too.
    function syncOrderSheetBar() {
      document.getElementById('orderSheetBarCount').textContent = document.getElementById('cartItemsBadge').textContent;
      document.getElementById('orderSheetBarTotal').textContent = document.getElementById('payBtnTotal').textContent;
    }
    ['cartItemsBadge', 'payBtnTotal'].forEach(id =>
      new MutationObserver(syncOrderSheetBar).observe(document.getElementById(id), { childList: true, characterData: true, subtree: true }));

    function openTableModal() {
      const g = document.getElementById('tableGrid'); g.innerHTML = '';
      for (let n = 1; n <= 12; n++) {
        const t = `T${n}`, on = t === AppState.tableNo;
        const b = document.createElement('button');
        b.className = `tap py-4 rounded-xl font-extrabold border ${on ? 'bg-brand-600 text-white border-brand-700' : 'bg-slate-50 hover:bg-brand-100 border-slate-200'}`;
        b.textContent = t; b.onclick = () => selectTable(t); g.appendChild(b);
      }
      openModal('tableModal');
    }
    function selectTable(t) { AppState.tableNo = t; document.getElementById('currentTableBadge').textContent = t; closeModal('tableModal'); broadcastCart(); showPOSNotification('info', 'Table Selected', `Active table set to ${t}.`); }

    function openPersonsModal() {
      const g = document.getElementById('personsGrid'); g.innerHTML = '';
      for (let n = 1; n <= 8; n++) {
        const on = n === AppState.persons;
        const b = document.createElement('button');
        b.className = `tap py-3 rounded-xl font-extrabold text-base border ${on ? 'bg-brand-600 text-white border-brand-700' : 'bg-slate-50 hover:bg-brand-100 border-slate-200'}`;
        b.textContent = n === 8 ? '8+' : n; b.onclick = () => selectPersons(n); g.appendChild(b);
      }
      openModal('personsModal');
    }
    function selectPersons(n) { AppState.persons = n; document.getElementById('currentPersonsCount').textContent = n === 8 ? '8+' : n; closeModal('personsModal'); }

    function openCustomerModal() {
      document.getElementById('custNameInput').value = AppState.customer === 'Walk-in' ? '' : AppState.customer;
      document.getElementById('custPhoneInput').value = AppState.phone;
      openModal('customerModal');
    }
    function updateCustomerDisplay() { document.getElementById('topCustomerLabel').textContent = AppState.customer; }
    function saveCustomer() {
      AppState.customer = document.getElementById('custNameInput').value.trim() || 'Walk-in';
      AppState.phone = document.getElementById('custPhoneInput').value.trim();
      updateCustomerDisplay(); closeModal('customerModal');
      showPOSNotification('info', 'Customer', `Order assigned to ${AppState.customer}.`);
    }
    function setCustomer(name) { AppState.customer = name; AppState.phone = ''; updateCustomerDisplay(); closeModal('customerModal'); }

    // A finished bill must not leak its customer into the next one. Recalling a
    // named bill used to make that name stick to every order afterwards.
    // Clears what belongs to one bill rather than to the till: the guest, and the
    // waiter it was credited to. Called wherever a bill leaves the screen — settled,
    // saved unpaid or cleared — so the next guest never inherits either.
    function resetCustomer() {
      AppState.customer = 'Walk-in';
      AppState.phone = '';
      AppState.waiterId = null;
      updateCustomerDisplay();
    }

    function openModifierModal() {
      const item = AppState.cart[AppState.selectedCartIndex];
      if (!item) { showPOSNotification('warning', 'No Item Selected', 'Tap an item in the order first.'); return; }
      document.getElementById('modifierDishName').textContent = cap(item.name);
      document.getElementById('inputCustomModifier').value = item.modifier || '';
      openModal('modifierModal');
    }
    function appendModifier(t) { playBeep('click'); const i = document.getElementById('inputCustomModifier'); i.value = i.value ? `${i.value}, ${t}` : t; }
    function saveModifier() {
      const item = AppState.cart[AppState.selectedCartIndex];
      if (!item) return;
      item.modifier = document.getElementById('inputCustomModifier').value.trim();
      renderCart(); broadcastCart(); closeModal('modifierModal');
      showPOSNotification('info', 'Note Saved', `Kitchen note added to ${cap(item.name)}.`);
    }
    function clearModifierForSelected() { const item = AppState.cart[AppState.selectedCartIndex]; if (item) { item.modifier = ''; renderCart(); } closeModal('modifierModal'); }

    function openDiscountModal() { document.getElementById('inputCustomDiscount').value = AppState.discountPercent; openModal('discountModal'); }
    function setDiscountPercent(p) { AppState.discountPercent = p; calculateTotals(); broadcastCart(); closeModal('discountModal'); showPOSNotification('info', 'Discount Applied', `${p}% off this order.`); }
    function applyCustomDiscount(val) {
      AppState.discountPercent = val !== undefined ? val : Math.min(100, Math.max(0, parseFloat(document.getElementById('inputCustomDiscount').value) || 0));
      calculateTotals(); broadcastCart(); closeModal('discountModal');
    }

    // ================= ORDER FLOW =================
    function setOrderMode(mode) {
      AppState.orderMode = mode;
      const on = 'tap flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-brand-800 shadow-sm';
      const off = 'tap flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-500';
      document.getElementById('btnDineIn').className = mode === 'dinein' ? on : off;
      document.getElementById('btnTakeAway').className = mode === 'takeaway' ? on : off;
      document.getElementById('tableChip').classList.toggle('opacity-40', mode === 'takeaway');
      playBeep('click'); broadcastCart();
    }
    // Shared payload builder so an unpaid order and a settled one record the same figures.
    function billPayload() {
      const t = calculateTotals();
      // billType is set before this runs, so a split bill reports its real head
      // count while an unpaid save or a normal bill reports one payer.
      const persons = AppState.billType === 'split' ? splitCount : 1;
      const shares = persons > 1 ? currentSplitShares(t.netTotal) : [t.netTotal];

      return {
        orderId: AppState.openOrderId,
        billType: AppState.billType,
        mergeFrom: [...AppState.mergeFrom],
        splitCount: persons,
        splitAmount: shares[0],
        orderMode: AppState.orderMode,
        tableNo: AppState.tableNo,
        guests: AppState.persons,
        customerName: AppState.customer,
        customerPhone: AppState.phone,
        waiterId: AppState.waiterId,
        subTotal: parseFloat(t.subTotal.toFixed(2)),
        discountPercent: parseFloat(AppState.discountPercent.toFixed(2)),
        discountAmount: parseFloat(t.discountAmt.toFixed(2)),
        serviceChargePercent: parseFloat(AppState.serviceChargePercent.toFixed(2)),
        serviceChargeAmount: parseFloat(t.serviceChargeAmt.toFixed(2)),
        gstPercent: parseFloat(AppState.gstPercent.toFixed(2)),
        gstAmount: parseFloat(t.gstAmt.toFixed(2)),
        netTotal: parseFloat(t.netTotal.toFixed(2)),
        items: AppState.cart.map(i => ({
          id: i.id, name: i.name, qty: i.qty,
          unitPrice: parseFloat(i.rPrice.toFixed(2)),
          isFOC: i.foc, note: i.modifier || ''
        }))
      };
    }

    // Saves the order unpaid — the guest settles when they leave. Pressing it again
    // updates the same order rather than creating a second one.
    async function placeOrder() {
      if (!AppState.cart.length) { showPOSNotification('warning', 'Order is Empty', 'Add dishes before saving the order.'); return; }
      playBeep('add');

      try {
        const res = await fetch(BASE + 'api/billing/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(billPayload())
        });
        if (!res.ok) { showPOSNotification('warning', 'Save Failed', 'Order could not be saved.'); return; }

        const data = await res.json();
        const n = AppState.cart.reduce((a, c) => a + c.qty, 0);
        const where = AppState.orderMode === 'dinein' ? `Table ${AppState.tableNo}` : 'Take Away';
        showPOSNotification('success', 'Order Saved',
          `${orderLabel(data.seqNo)} • ${where} • ${n} item(s) • pay on leaving`);

        // Clear the screen for the next guest. The order stays in the database as
        // 'ordered' and is settled when they pay.
        AppState.openOrderId = null;
        AppState.seqNo = data.nextSeq ?? (data.seqNo + 1);
        _tillSeqNo = null;
        AppState.cart = []; AppState.selectedCartIndex = -1; AppState.discountPercent = 0;
        AppState.mergeFrom.clear(); AppState.billType = 'single';
        resetCustomer();
        renderMergeBadge();
        renderSeqNo();
        refreshAll();
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach the server. Order not saved.');
      }
    }


    // ================= WAITER PUNCH =================
    // Waiters do not sign in, so the till clocks them in and out. The list is read
    // from the server each time the popup opens: any till can punch, so what this
    // page last saw may already be stale.
    let punchWaiters = [];
    let punchBusy = false;
    const antiForgeryToken = () => document.querySelector('#logoutForm input[name="__RequestVerificationToken"]').value;

    async function openPunchModal() {
      document.getElementById('punchList').innerHTML = '<p class="py-8 text-center text-sm font-bold text-slate-400">Loading…</p>';
      openModal('punchModal');
      await loadPunchList();
    }

    async function loadPunchList() {
      try {
        const res = await fetch(BASE + 'api/billing/attendance/waiters', { cache: 'no-store' });
        if (!res.ok) throw new Error();
        punchWaiters = await res.json();
      } catch {
        document.getElementById('punchList').innerHTML = '<p class="py-8 text-center text-sm font-bold text-rose-500">Could not load waiters</p>';
        return;
      }
      renderPunch();
    }

    function renderPunch() {
      const onShift = punchWaiters.filter(w => w.isIn).sort((a, b) => a.firstInAt.localeCompare(b.firstInAt));
      const off = punchWaiters.filter(w => !w.isIn);

      const badge = document.getElementById('punchCountBadge');
      badge.textContent = onShift.length;
      badge.classList.toggle('hidden', !onShift.length); badge.classList.toggle('flex', !!onShift.length);

      const sel = document.getElementById('punchWaiterSelect');
      const keep = sel.value;
      sel.innerHTML = off.length
        ? '<option value="">Select waiter…</option>' + off.map(w => `<option value="${w.id}">${escHtml(w.name)}</option>`).join('')
        : `<option value="">${punchWaiters.length ? 'Every waiter is punched in' : 'No waiters set up'}</option>`;
      if (off.some(w => String(w.id) === keep)) sel.value = keep;
      sel.disabled = !off.length;
      document.getElementById('punchInBtn').disabled = !off.length;

      document.getElementById('punchOnCount').textContent = `${onShift.length} of ${punchWaiters.length}`;
      const list = document.getElementById('punchList');
      if (!onShift.length) {
        list.innerHTML = '<div class="py-8 text-center"><i data-lucide="user-x" class="w-8 h-8 text-slate-300 mx-auto mb-2"></i><p class="text-sm font-bold text-slate-500">Nobody punched in yet</p></div>';
      } else {
        const t = iso => shopTime(iso);
        list.innerHTML = onShift.map(w => `
          <div class="border border-slate-200 rounded-2xl px-3.5 py-2.5 flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-mint-100 text-mint-700 flex items-center justify-center text-xs font-extrabold shrink-0">${escHtml(waiterInitials(w.name))}</span>
            <div class="min-w-0 flex-1">
              <div class="font-extrabold text-sm text-slate-800 truncate">${escHtml(w.name)}</div>
              <div class="text-[11px] font-semibold text-slate-400">In since ${t(w.firstInAt)}${w.lastInAt !== w.firstInAt ? ' · back at ' + t(w.lastInAt) : ''}${w.fromYesterday ? ' <span class="text-amber-600 font-bold">· from yesterday</span>' : ''}</div>
            </div>
            <button onclick="punchOut(${w.id})" class="tap h-9 px-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 font-bold text-xs flex items-center gap-1.5 shrink-0"><i data-lucide="log-out" class="w-3.5 h-3.5"></i>Punch Out</button>
          </div>`).join('');
      }
      lucide.createIcons();
    }

    async function punchSend(action, waiterId) {
      if (punchBusy) return;
      punchBusy = true;
      playBeep('click');
      const verb = action === 'punch-in' ? 'Punch In' : 'Punch Out';
      try {
        const res = await fetch(BASE + 'api/billing/attendance/' + action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken() },
          body: JSON.stringify({ waiterId })
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) showPOSNotification('warning', verb + ' Failed', body.error || 'Please try again.');
        else showPOSNotification('success', action === 'punch-in' ? 'Punched In' : 'Punched Out',
          `${body.name} ${action === 'punch-in' ? 'is now on shift' : 'is off shift'}.`);
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach the server.');
      } finally {
        punchBusy = false;
      }
      // Re-read either way: a refusal usually means another till already changed it.
      await loadPunchList();
    }

    function punchIn() {
      const id = Number(document.getElementById('punchWaiterSelect').value);
      if (!id) { showPOSNotification('warning', 'Select a Waiter', 'Pick who is starting their shift.'); return; }
      punchSend('punch-in', id);
    }

    function punchOut(id) { punchSend('punch-out', id); }

    // ================= END OF DAY =================
    // Moves every closed bill off Orders into order_archive (lines and payments
    // with it) so the live tables stay small. Today's unpaid bills stay where they
    // are. Reports and the dashboard read both tables, so no figure changes.
    let eodBusy = false;

    async function runEndOfDay() {
      if (eodBusy) return;
      playBeep('click');

      let preview;
      try {
        const res = await fetch(BASE + 'api/billing/eod', { cache: 'no-store' });
        preview = await res.json().catch(() => ({}));
        if (!res.ok) { showPOSNotification('warning', 'End of Day', preview.error || 'Could not check the day.'); return; }
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach the server.');
        return;
      }

      if (!preview.toArchive) {
        showPOSNotification('info', 'Nothing to Archive', preview.openToday
          ? `Only ${preview.openToday} unpaid bill(s) on the till - they stay until settled.`
          : 'The live order tables are already empty.');
        return;
      }

      const lines = [`${preview.toArchive} closed bill(s) will move to the archive, with their items and payments.`];
      if (preview.openToday) lines.push(`${preview.openToday} unpaid bill(s) from today stay on the till.`);
      lines.push('Reports, the dashboard and the Orders list still show archived bills.');
      const ok = await posConfirm({
        title: `End of Day · ${preview.businessDate}`,
        lines,
        okText: 'Run End of Day',
        warn: preview.heldCarts ? { title: 'Held carts', text: `${preview.heldCarts} held cart(s) are not bills and are not archived.` } : null
      });
      if (!ok) return;

      eodBusy = true;
      const btn = document.getElementById('eodBtn');
      btn.disabled = true;
      try {
        const res = await fetch(BASE + 'api/billing/eod', {
          method: 'POST',
          headers: { 'RequestVerificationToken': antiForgeryToken() }
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) showPOSNotification('warning', 'End of Day Failed', body.error || 'Nothing was moved. Please try again.');
        else showPOSNotification('success', 'End of Day Done',
          `Archived ${body.orders} bill(s), ${body.items} item(s), ${body.payments} payment(s).`);
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach the server.');
      } finally {
        eodBusy = false;
        btn.disabled = false;
      }
    }

    // ================= WAITER =================
    // The list comes from the server on every settle, so a waiter added mid-shift
    // appears without reloading the till. The current pick survives the refresh;
    // it is only dropped when that account is no longer selectable.
    async function loadWaiters() {
      try {
        const res = await fetch(BASE + 'api/billing/waiters');
        if (!res.ok) return;
        AppState.waiters = await res.json();
      } catch { return; }
      renderWaiterCards();
      scrollWaiterIntoView();
    }

    // Display names are staff-entered, so they are escaped before going into
    // markup rather than trusted the way a fixed label would be.
    const escHtml = v => String(v ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    // "Ravi Kumar" -> "RK". One letter when there is only one word, so a card is
    // never blank.
    const waiterInitials = name => String(name ?? '').trim().split(/\s+/).filter(Boolean)
      .slice(0, 2).map(w => w[0].toUpperCase()).join('') || '?';

    function renderWaiterCards() {
      const box = document.getElementById('waiterCards');
      const list = AppState.waiters;

      if (AppState.waiterId && !list.some(w => w.id === AppState.waiterId)) AppState.waiterId = null;

      const card = (id, name, badge, isIcon) => {
        const on = id === AppState.waiterId;
        return `<button onclick="selectWaiter(${id === null ? 'null' : id})" title="${escHtml(name)}"
          class="tap shrink-0 pl-1.5 pr-3 py-1.5 rounded-full border-2 flex items-center gap-2 ${on ? 'border-brand-600 bg-white' : 'border-brand-100 bg-white/70'}">
          <span class="w-7 h-7 rounded-full flex items-center justify-center text-[11px] font-extrabold shrink-0 ${on ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-500'}">${isIcon ? badge : escHtml(badge)}</span>
          <span class="max-w-[96px] truncate text-xs font-bold ${on ? 'text-brand-900' : 'text-slate-600'}">${escHtml(name)}</span>
        </button>`;
      };

      // Unassigned is a card like any other, so clearing the attribution is one tap
      // and never needs a trip through a list.
      box.innerHTML =
        card(null, 'Unassigned', '<i data-lucide="user-x" class="w-4 h-4"></i>', true) +
        list.map(w => card(w.id, w.name, waiterInitials(w.name), false)).join('');

      document.getElementById('waiterEmptyHint').classList.toggle('hidden', list.length > 0);
      lucide.createIcons();
    }

    function selectWaiter(id) {
      AppState.waiterId = id;
      playBeep('click');
      renderWaiterCards();
    }

    // A recalled bill can be credited to someone far along the row, so bring that
    // card into view instead of leaving the row parked at the start.
    function scrollWaiterIntoView() {
      const on = document.querySelector('#waiterCards .border-brand-600');
      if (on) on.scrollIntoView({ block: 'nearest', inline: 'center' });
    }

    let selectedPayMethod = 'mixed';
    function openPaymentModal() {
      if (!AppState.cart.length) { showPOSNotification('warning', 'Order is Empty', 'Add items before payment.'); return; }
      const { netTotal } = calculateTotals();
      document.getElementById('paymentModalTotal').textContent = money(netTotal);
      document.getElementById('paymentModalModeBadge').textContent = AppState.orderMode === 'dinein' ? `Dine In (${AppState.tableNo})` : 'Take Away';
      splitCount = 1;
      splitPaid = [false];
      splitFixed = [null];
      splitEdited = [false];

      // The body scrolls now that the dialog is taller than some kiosk screens, so
      // a reopen must start at the top rather than where the last bill left it.
      document.getElementById('paymentModalBody').scrollTop = 0;

      // Draw what is already known, then refresh in the background so the dialog
      // never waits on the network to open.
      renderWaiterCards();
      scrollWaiterIntoView();
      loadWaiters();

      // Mixed opens with the whole bill on the first mode (cash when it is active).
      renderMixedInputs(netTotal);
      selectPaymentMethod('mixed');
      openModal('paymentModal');
    }
    function selectPaymentMethod(m) {
      selectedPayMethod = m;
      document.getElementById('mixedSection').classList.toggle('hidden', m !== 'mixed');
      document.getElementById('splitSection').classList.toggle('hidden', m !== 'split');
      if (m === 'split') renderSplit();
      if (m === 'mixed') updateMixedCalculation();
    }

    // ================= MIXED PAYMENT =================
    // One payer, any number of tenders: one box per active transaction mode, and
    // the balance goes on QR / UPI. Saved as one order_payment row per non-zero part.
    // The CASH mode arrives as the built-in "cash" method; the rest by their name.
    const PAY_LABELS = { cash: 'Cash', card: 'Card', qr: 'QR / UPI', split: 'Split' };
    const payLabel = m => PAY_LABELS[m] || m;
    const PAY_MODES = (_posData.payModes && _posData.payModes.length) ? _posData.payModes : ['cash'];
    const payIcon = m => m === 'cash' || /CASH/i.test(m) ? 'banknote' : /NETS|DEBIT/i.test(m) ? 'landmark' : 'credit-card';

    function renderMixedInputs(netTotal) {
      const e = escapeHtml;
      document.getElementById('mixedInputs').innerHTML = PAY_MODES.map((m, i) => `
        <div>
          <div class="flex items-center justify-between h-7 mb-1">
            <span class="text-xs font-bold text-slate-500 flex items-center gap-1 truncate"><i data-lucide="${payIcon(m)}" class="w-3.5 h-3.5 shrink-0"></i>${e(payLabel(m))}</span>
            ${i === 0 ? '<button onclick="setMixedHalf()" class="tap text-[11px] font-bold text-brand-700 bg-brand-50 border border-brand-200 px-2.5 py-1 rounded-lg">Half</button>' : ''}
          </div>
          <input data-method="${e(m)}" type="number" step="0.10" min="0" value="${(i === 0 ? netTotal : 0).toFixed(2)}" oninput="updateMixedCalculation()" onkeydown="if (event.key === 'Enter') { event.preventDefault(); mixedEnter(this); }" onblur="this.value = (parseFloat(this.value) || 0).toFixed(2)" placeholder="${e(payLabel(m))} amount" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 font-mono font-bold text-lg focus:outline-none focus:border-brand-600">
        </div>`).join('');

      const tile = (cls, label, attr) => `<div class="${cls} rounded-xl py-2"><div class="text-[10px] font-bold uppercase tracking-wider opacity-80 truncate px-1">${e(label)}</div><div ${attr} class="font-digital font-bold text-lg">$0.00</div></div>`;
      document.getElementById('mixedSummary').innerHTML =
        PAY_MODES.map(m => tile(m === 'cash' ? 'bg-mint-50 border border-mint-200 text-mint-700' : 'bg-brand-50 border border-brand-200 text-brand-800', payLabel(m), `data-show="${e(m)}"`)).join('') +
        tile('bg-brand-50 border border-brand-200 text-brand-800', 'QR / UPI', 'id="mixedQrShow"') +
        tile('bg-slate-50 border border-slate-200 text-slate-800', 'Total', 'id="mixedTotalShow"');
      lucide.createIcons();
    }

    function mixedParts() {
      const total = Math.round(calculateTotals().netTotal * 100);
      const parts = [...document.querySelectorAll('#mixedInputs input[data-method]')].map(el => ({
        method: el.dataset.method,
        cents: Math.max(0, Math.round((parseFloat(el.value) || 0) * 100))
      }));
      const typed = parts.reduce((a, p) => a + p.cents, 0);
      // Parts typed past the bill leave nothing for QR; `over` is how far.
      return {
        parts: parts.map(p => ({ method: p.method, amount: p.cents / 100 })),
        qr: Math.max(0, total - typed) / 100,
        over: Math.max(0, typed - total) / 100,
        total: total / 100
      };
    }

    // Enter in an empty box fills it with the balance the other boxes leave:
    // CASH 10 of a 100 bill, move to MASTER, Enter, and MASTER gets 90. Moving
    // between boxes alone never fills anything, and a box that already holds an
    // amount keeps it. The text is selected so typing replaces it.
    function mixedEnter(el) {
      const cents = v => Math.max(0, Math.round((parseFloat(v) || 0) * 100));
      if (cents(el.value) === 0) {
        const total = Math.round(calculateTotals().netTotal * 100);
        const others = [...document.querySelectorAll('#mixedInputs input[data-method]')]
          .filter(x => x !== el).reduce((a, x) => a + cents(x.value), 0);
        const balance = total - others;
        if (balance > 0) el.value = (balance / 100).toFixed(2);
      } else {
        el.value = (cents(el.value) / 100).toFixed(2);
      }
      updateMixedCalculation();
      setTimeout(() => { try { el.select(); } catch { } }, 0);
    }

    function setMixedHalf() {
      playBeep('click');
      const total = Math.round(calculateTotals().netTotal * 100);
      const first = document.querySelector('#mixedInputs input[data-method]');
      if (first) first.value = (Math.round(total / 2) / 100).toFixed(2);
      updateMixedCalculation();
    }

    function updateMixedCalculation() {
      const { parts, qr, over, total } = mixedParts();
      const shows = [...document.querySelectorAll('#mixedSummary [data-show]')];
      parts.forEach(p => {
        const el = shows.find(x => x.dataset.show === p.method);
        if (el) el.textContent = money(p.amount);
      });
      document.getElementById('mixedQrShow').textContent = money(qr);
      document.getElementById('mixedTotalShow').textContent = money(total);
      const warn = document.getElementById('mixedOverWarn');
      warn.textContent = over > 0 ? `The parts are ${money(over)} more than the bill.` : '';
      warn.classList.toggle('hidden', over <= 0);
    }
    // ================= SPLIT BILL =================
    let splitCount = 1;
    let splitPaid = [false];
    // Per person: a fixed share in cents, or null to take an even part of what the
    // fixed shares leave. A share is fixed when the cashier typed it (splitEdited)
    // or once that person has paid, so later edits never move money already taken.
    let splitFixed = [null];
    let splitEdited = [false];

    // Work in cents so 100.00 / 3 gives 33.34 + 33.33 + 33.33 rather than a
    // rounded total that no longer matches the bill.
    function splitShares(total, n) {
      const cents = Math.round(total * 100);
      const base = Math.floor(cents / n);
      let extra = cents - base * n;
      return Array.from({ length: n }, () => (base + (extra-- > 0 ? 1 : 0)) / 100);
    }

    // Fixed shares as entered; everyone else splits the remainder evenly
    // (e.g. $100 with Person 1 set to $15 leaves $85 for Person 2).
    function currentSplitShares(total) {
      const cents = Math.round(total * 100);
      const fixedSum = splitFixed.reduce((a, c) => a + (c ?? 0), 0);
      const free = splitFixed.map((c, i) => c == null ? i : -1).filter(i => i >= 0);
      const freeShares = free.length ? splitShares(Math.max(0, cents - fixedSum) / 100, free.length) : [];
      return splitFixed.map((c, i) => c != null ? c / 100 : freeShares[free.indexOf(i)]);
    }

    function changeSplitCount(d) {
      splitCount = Math.min(20, Math.max(1, splitCount + d));
      splitPaid = Array(splitCount).fill(false);
      splitFixed = Array(splitCount).fill(null);
      splitEdited = Array(splitCount).fill(false);
      playBeep('click');
      renderSplit();
    }

    function toggleSplitPaid(i) {
      const shares = currentSplitShares(calculateTotals().netTotal);
      splitPaid[i] = !splitPaid[i];
      if (splitPaid[i]) splitFixed[i] = Math.round(shares[i] * 100);
      else if (!splitEdited[i]) splitFixed[i] = null;
      playBeep('click'); renderSplit();
    }

    // Blank puts the person back on the even share; otherwise the amount is
    // clamped to the bill so a typo cannot push the total far out.
    function setSplitAmount(i, raw) {
      const { netTotal } = calculateTotals();
      const v = parseFloat(raw);
      if (raw.trim() === '' || isNaN(v)) {
        splitEdited[i] = false;
        splitFixed[i] = splitPaid[i] ? splitFixed[i] : null;
      } else {
        splitEdited[i] = true;
        splitFixed[i] = Math.round(Math.min(Math.max(0, v), netTotal) * 100);
      }
    }

    function resetSplitAmounts() {
      splitPaid = Array(splitCount).fill(false);
      splitFixed = Array(splitCount).fill(null);
      splitEdited = Array(splitCount).fill(false);
      playBeep('click'); renderSplit();
    }

    function splitCollected() {
      const shares = currentSplitShares(calculateTotals().netTotal);
      return shares.reduce((a, c, i) => a + (splitPaid[i] ? c : 0), 0);
    }

    // Rebuilds the rows. Only for structural changes (head count, paid state):
    // while someone is typing the rows must stay put, because the on-screen
    // keyboard holds a reference to the input it is typing into.
    function renderSplit() {
      const list = document.getElementById('splitList');
      if (activeInputTarget && list.contains(activeInputTarget)) closeGlobalVirtualKeyboard();

      document.getElementById('splitCount').textContent = splitCount;
      list.innerHTML = '';
      for (let i = 0; i < splitCount; i++) {
        const paid = splitPaid[i];
        const row = document.createElement('div');
        row.className = `tap w-full flex items-center gap-3 px-4 py-2 rounded-xl border text-left cursor-pointer ${paid ? 'bg-mint-50 border-mint-200' : 'bg-white border-slate-200'}`;
        row.onclick = () => toggleSplitPaid(i);
        row.innerHTML = `
          <span class="w-8 h-8 rounded-lg ${paid ? 'bg-mint-600' : 'bg-slate-300'} text-white font-extrabold text-xs flex items-center justify-center shrink-0">${i + 1}</span>
          <span class="flex-1 font-bold text-sm ${paid ? 'text-mint-800' : 'text-slate-700'}">Person ${i + 1} <span data-custom class="hidden text-[10px] text-brand-600 font-extrabold uppercase">custom</span></span>
          <span class="flex items-center gap-1 font-digital font-bold text-lg ${paid ? 'text-mint-700' : 'text-slate-900'}">${AppState.currency}<input type="text" inputmode="decimal" autocomplete="off" ${paid ? 'disabled' : ''}
            class="w-24 px-2 py-1 rounded-lg border ${paid ? 'border-transparent bg-transparent' : 'border-slate-200 bg-slate-50 focus:border-brand-500 focus:bg-white placeholder:text-slate-300'} text-right font-digital font-bold text-lg outline-none"></span>
          <span class="w-12 text-right text-[10px] font-extrabold uppercase ${paid ? 'text-mint-600' : 'text-slate-300'}">${paid ? 'paid' : 'due'}</span>`;

        const input = row.querySelector('input');
        // Tapping opens the on-screen keyboard on an empty box (old amount shown
        // faintly) so the first key replaces the amount instead of appending to it.
        input.onclick = e => {
          e.stopPropagation();
          if (paid) return;
          input.placeholder = input.value;
          input.value = '';
          openGlobalVirtualKeyboard(input);
          document.getElementById('vkTargetLabel').textContent = `Person ${i + 1} amount`;
          input.scrollIntoView({ block: 'center', behavior: 'smooth' });
        };
        // Every keystroke (on-screen or physical) re-tallies the other people live.
        input.oninput = () => {
          const clean = input.value.replace(/[^0-9.]/g, '').replace(/(\..*?)\./g, '$1').replace(/(\.\d{2})\d+$/, '$1');
          if (clean !== input.value) input.value = clean;
          setSplitAmount(i, clean);
          refreshSplitTally(input);
        };
        input.onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); closeGlobalVirtualKeyboard(); } };
        // Enter, Done or tapping anywhere else: settle and show tidy amounts.
        input.onblur = () => {
          if (activeInputTarget === input) closeGlobalVirtualKeyboard();
          refreshSplitTally();
        };
        list.appendChild(row);
      }
      refreshSplitTally();
    }

    // Updates amounts, totals and the mismatch warning in place. `editing` is the
    // box being typed into, left alone so the cashier's keystrokes are not
    // reformatted under them.
    function refreshSplitTally(editing = null) {
      const { netTotal } = calculateTotals();
      const shares = currentSplitShares(netTotal);
      document.getElementById('splitResetBtn').classList.toggle('hidden', !splitFixed.some(c => c != null));

      document.querySelectorAll('#splitList > div').forEach((row, i) => {
        const input = row.querySelector('input');
        row.querySelector('[data-custom]').classList.toggle('hidden', !splitEdited[i]);
        if (input === editing) return;
        input.value = shares[i].toFixed(2);
        input.placeholder = '';
      });

      const allocated = shares.reduce((a, c) => a + c, 0);
      const collected = shares.reduce((a, c, i) => a + (splitPaid[i] ? c : 0), 0);
      document.getElementById('splitOrderTotal').textContent = money(netTotal);
      document.getElementById('splitCollected').textContent = money(collected);
      document.getElementById('splitRemaining').textContent = money(Math.max(0, netTotal - collected));

      // Every share fixed and they don't add up to the bill: say by how much.
      const diff = Math.round((allocated - netTotal) * 100) / 100;
      const warn = document.getElementById('splitWarn');
      warn.classList.toggle('hidden', Math.abs(diff) < 0.005);
      warn.textContent = diff > 0
        ? `Shares are ${money(diff)} over the bill. Lower an amount.`
        : `Shares are ${money(-diff)} short of the bill. Raise an amount or clear one.`;
    }


    // TODO: print logic to be added.
    function printBill() {
    }

    function finalizePayment() {
      const t = calculateTotals();

      if (selectedPayMethod === 'split') {
        const allocated = currentSplitShares(t.netTotal).reduce((a, c) => a + c, 0);
        if (Math.abs(allocated - t.netTotal) >= 0.005) {
          showPOSNotification('warning', 'Split Mismatch', `Shares total ${money(allocated)} but the bill is ${money(t.netTotal)}.`);
          return;
        }
        const outstanding = t.netTotal - splitCollected();
        if (outstanding > 0.005) {
          showPOSNotification('warning', 'Split Incomplete', `${money(outstanding)} still to collect.`);
          return;
        }
        // One payer is just a normal bill, however it was collected.
        AppState.billType = splitCount > 1 ? 'split' : 'single';
        closeModal('paymentModal');
        finalizePaymentWithDetails(0, [{ method: 'split', amount: round2(t.netTotal), tendered: 0 }]);
        return;
      }

      if (selectedPayMethod === 'mixed') {
        const { parts: typed, qr, over } = mixedParts();
        if (over > 0) {
          showPOSNotification('warning', 'Mixed Payment', `The parts are ${money(over)} more than the bill of ${money(t.netTotal)}.`);
          return;
        }
        const parts = [
          ...typed.map(p => ({ method: p.method, amount: p.amount, tendered: p.method === 'cash' ? p.amount : 0 })),
          { method: 'qr', amount: qr, tendered: 0 }
        ].filter(p => p.amount > 0);
        // Mixed is the only single-payer tab, so one part is a plain one-mode bill.
        // A zero bill still needs a line to save against.
        if (!parts.length) parts.push({ method: 'cash', amount: 0, tendered: 0 });
        closeModal('paymentModal');
        finalizePaymentWithDetails(0, parts);
        return;
      }
    }

    const round2 = v => Math.round(v * 100) / 100;

    // `payments` is one line per tender; they add up to the bill and are saved to
    // order_payment, which is what the drawer and card totals reconcile against.
    async function finalizePaymentWithDetails(change, payments) {
      const t = calculateTotals();
      playBeep('cash');

      try {
        // billPayload carries openOrderId, so an already-saved order is settled
        // in place instead of being written a second time.
        const res = await fetch(BASE + 'api/billing/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...billPayload(), payments })
        });
        if (res.ok) {
          const data = await res.json();
          const how = payments.map(p => payments.length > 1 ? `${payLabel(p.method)} ${money(p.amount)}` : payLabel(p.method)).join(' + ');
          showPOSNotification('success', `Paid (${how})`,
            `${orderLabel(data.seqNo)} settled • Total ${money(t.netTotal)} • Change ${money(change)}`);
          // The server reports the real next number, so settling a recalled bill
          // cannot rewind the counter.
          AppState.seqNo = data.nextSeq ?? (data.seqNo + 1);
        } else {
          showPOSNotification('warning', 'Save Failed', 'Order could not be saved to database.');
          if (_tillSeqNo !== null) AppState.seqNo = _tillSeqNo;
        }
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach server. Order not saved.');
        if (_tillSeqNo !== null) AppState.seqNo = _tillSeqNo;
      }
      _tillSeqNo = null;

      AppState.openOrderId = null;
      AppState.billType = 'single';
      AppState.mergeFrom.clear();
      resetCustomer();
      renderMergeBadge();
      renderSeqNo();
      postToDisplay(JSON.stringify({ type: 'paid' }));
      AppState.cart = []; AppState.discountPercent = 0; AppState.selectedCartIndex = -1;
      refreshAll();
    }

    // ================= HOLD =================
    // Holds live in the held_order table, not in the page, so they survive a
    // reload or a sign-out and any till can pick them up. A hold is not a bill:
    // it takes no order number until it is recalled and saved or settled.

    async function updatePendingBadge() {
      try {
        const res = await fetch(BASE + 'api/billing/held');
        if (res.ok) AppState.pendingOrders = await res.json();
      } catch { }
      const b = document.getElementById('pendingCountBadge');
      const n = AppState.pendingOrders.length;
      b.textContent = n; b.classList.toggle('hidden', !n); b.classList.toggle('flex', !!n);
    }

    async function holdCurrentOrder() {
      if (!AppState.cart.length) { showPOSNotification('warning', 'Order is Empty', 'Nothing to hold.'); return; }
      // A recalled or merge-staged bill already has a row in Orders; parking a copy
      // would leave two versions of it. Saving it with Order keeps it open instead.
      if (AppState.openOrderId || AppState.mergeFrom.size) {
        showPOSNotification('warning', 'Cannot Hold', 'This is a saved bill. Use Pay to settle it.');
        return;
      }
      playBeep('click');

      try {
        const res = await fetch(BASE + 'api/billing/hold', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(billPayload())
        });
        if (!res.ok) { showPOSNotification('warning', 'Hold Failed', 'Order could not be held.'); return; }
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach the server. Order not held.');
        return;
      }

      const where = AppState.orderMode === 'dinein' ? AppState.tableNo : 'Take Away';
      showPOSNotification('info', 'Order Held', `Order for ${where} put on hold.`);
      AppState.cart = []; AppState.selectedCartIndex = -1; AppState.discountPercent = 0;
      resetCustomer();
      refreshAll(); updatePendingBadge();
    }

    async function openPendingOrdersModal() {
      const c = document.getElementById('pendingOrdersList');
      c.innerHTML = '<p class="py-10 text-center text-sm font-bold text-slate-400">Loading…</p>';
      openModal('pendingModal');
      await updatePendingBadge();

      c.innerHTML = '';
      if (!AppState.pendingOrders.length) {
        c.innerHTML = `<div class="py-10 text-center"><i data-lucide="inbox" class="w-8 h-8 text-amber-500 mx-auto mb-2"></i><p class="text-sm font-bold text-slate-700">No held orders</p></div>`;
      } else AppState.pendingOrders.forEach(o => {
        const time = shopTime(o.heldAt);
        const by = [o.heldBy, o.terminal].filter(Boolean).join(' @@ ');
        const d = document.createElement('div');
        d.className = 'border border-slate-200 rounded-2xl p-3.5 flex justify-between items-center';
        d.innerHTML = `<div class="min-w-0"><div class="font-extrabold text-sm flex items-center gap-2">${escapeHtml(o.customerName || 'Walk-in')}<span class="bg-brand-100 text-brand-800 text-xs px-2 py-0.5 rounded-full">${o.orderMode === 'dinein' ? escapeHtml(o.tableNo) : 'Take Away'}</span></div><div class="text-xs text-slate-500 mt-1 truncate">${o.lines} line(s) • ${time}${by ? ' • ' + escapeHtml(by) : ''}${o.waiter ? ' • ' + escapeHtml(o.waiter) : ''}</div></div>
          <div class="flex items-center gap-2 shrink-0"><span class="font-digital font-bold text-brand-800 mr-1">${money(o.netTotal)}</span>
          <button onclick="recallPendingOrder(${o.id})" class="tap bg-brand-600 text-white font-bold text-xs px-3.5 py-2 rounded-xl">Recall</button>
          <button onclick="deletePendingOrder(${o.id})" class="tap bg-rose-50 text-rose-600 p-2 rounded-xl border border-rose-200"><i data-lucide="trash-2" class="w-4 h-4"></i></button></div>`;
        c.appendChild(d);
      });
      lucide.createIcons();
    }

    async function recallPendingOrder(id) {
      if (AppState.cart.length) {
        showPOSNotification('warning', 'Order in Progress', 'Hold, save or clear the current order first.');
        return;
      }
      let o;
      try {
        const res = await fetch(BASE + `api/billing/held/${id}/recall`, { method: 'POST' });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          // Another till got there first; show the list as it is now.
          showPOSNotification('warning', 'Cannot Recall', err.error || 'That hold could not be recalled.');
          openPendingOrdersModal();
          return;
        }
        o = await res.json();
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach the server.');
        return;
      }

      AppState.cart = o.items.map(i => ({
        id: i.id, name: i.name, qty: i.qty,
        rPrice: i.rPrice, cPrice: i.rPrice,
        modifier: i.modifier || '', foc: i.foc
      }));
      AppState.openOrderId     = null;
      AppState.tableNo         = o.tableNo;
      AppState.persons         = o.guests || 1;
      AppState.customer        = o.customerName || 'Walk-in';
      AppState.phone           = o.customerPhone || '';
      AppState.waiterId        = o.waiterId ?? null;
      AppState.discountPercent = o.discountPercent || 0;
      AppState.selectedCartIndex = -1;

      document.getElementById('currentTableBadge').textContent = o.tableNo;
      document.getElementById('currentPersonsCount').textContent = AppState.persons >= 8 ? '8+' : AppState.persons;
      updateCustomerDisplay(); setOrderMode(o.orderMode); refreshAll(); updatePendingBadge();
      closeModal('pendingModal');
      showPOSNotification('info', 'Order Recalled', `${o.orderMode === 'dinein' ? o.tableNo : 'Take Away'} restored.`);
    }

    async function deletePendingOrder(id) {
      if (!await posConfirm({ title: 'Discard this held order?', lines: ['It cannot be recalled afterwards.'], okText: 'Discard', tone: 'danger' })) return;
      playBeep('delete');
      try {
        const res = await fetch(BASE + `api/billing/held/${id}/discard`, { method: 'POST' });
        if (!res.ok) showPOSNotification('warning', 'Cannot Discard', 'That hold was already recalled or discarded.');
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach the server.');
      }
      openPendingOrdersModal();
    }

    async function clearCurrentOrder() {
      if (!AppState.cart.length) return;
      if (await posConfirm({ title: 'Clear current order items?', okText: 'Clear', tone: 'danger' })) {
        playBeep('delete');
        AppState.cart = []; AppState.selectedCartIndex = -1; AppState.discountPercent = 0;
        AppState.openOrderId = null;
        AppState.billType = 'single';
        AppState.mergeFrom.clear();
        // Abandoning a recalled bill restores the till's own number.
        if (_tillSeqNo !== null) { AppState.seqNo = _tillSeqNo; _tillSeqNo = null; }
        resetCustomer();
        renderMergeBadge();
        renderSeqNo();
        refreshAll();
        showPOSNotification('info', 'Order Cleared', 'Active order was reset.');
      }
    }
    /// Waiters never sign in, so nothing punches them out when the till goes away.
    /// Fetched fresh rather than read from punchWaiters: another till may have
    /// punched someone in or out since this one last loaded the list.
    async function waitersStillInWarning() {
      try {
        const res = await fetch(BASE + 'api/billing/attendance/waiters', { cache: 'no-store' });
        if (!res.ok) return null;
        const names = (await res.json()).filter(w => w.isIn).map(w => w.name);
        if (!names.length) return null;
        return {
          title: `${names.length} waiter${names.length > 1 ? 's' : ''} still punched in`,
          text: `${names.join(', ')}. Punch them out first or their shift stays open.`,
          actionText: 'Punch out waiters',
          action: openPunchModal
        };
      } catch { return null; }
    }

    const discardLine = n => `${n} item(s) in the current order will be discarded. Hold the order first if you want to keep it.`;

    async function handleClosePOS() {
      const n = AppState.cart.reduce((a, c) => a + c.qty, 0);
      const ok = await posConfirm({
        title: 'Close this terminal and end the shift?',
        lines: [...(n ? [discardLine(n)] : []), 'You will be signed out — the next launch starts at the login screen.'],
        okText: 'Close Terminal', tone: 'danger',
        warn: await waitersStillInWarning()
      });
      if (!ok) return;

      // The customer screen runs in its own browser instance, so there is no
      // window handle for it — ask it to shut down over the display channel.
      postToDisplay(JSON.stringify({ type: 'closed' }));
      playBeep('click');

      // Give the POST a moment to leave before this window goes away.
      setTimeout(exitKiosk, 250);
    }

    /// Signing out ends the shift but leaves the window open, unlike handleClosePOS.
    async function handleSignOut() {
      const n = AppState.cart.reduce((a, c) => a + c.qty, 0);
      const ok = await posConfirm({
        title: 'Sign out?',
        lines: n ? [discardLine(n)] : [],
        okText: 'Logout',
        warn: await waitersStillInWarning()
      });
      if (!ok) return;

      playBeep('click');
      await submitLogout();
    }

    /// Chrome lets a page close its own window only while that window's history
    /// holds a single entry. A plain form submit adds one, and the login screen's
    /// Close Terminal is then refused wherever the server has no window to close,
    /// so the sign-out replaces this page instead of adding to the history.
    async function submitLogout() {
      const form = document.getElementById('logoutForm');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (res.ok) { window.location.replace(res.url); return; }
      } catch { /* fall through and let the browser show what went wrong */ }
      form.submit();
    }

    /// Chrome refuses window.close() on a window a script did not open, so a
    /// launcher-started till cannot shut itself down from the page. The server can:
    /// Start-Kiosk records each window's pid and /api/terminal/close closes them.
    /// That call also signs the shift out, so the next launch starts at /login.
    async function exitKiosk() {
      // Cover the till before anything else, and set the same colour on the root
      // element: that is the colour Chrome keeps painting once the page is gone, so
      // the window disappears out of a solid frame instead of a white flash.
      document.documentElement.style.background = '#fdfdf9';
      document.getElementById('closingCover').classList.remove('hidden');
      lucide.createIcons();

      // Close the customer display THIS page opened, before the POST. On one
      // monitor the display is a popup we own, so closing it is allowed here and
      // is the only thing that can: Start-Kiosk clears display.pid in that mode,
      // so the server has no pid for it. It also shares the till's Chrome
      // process, so a WM_CLOSE aimed at that process's main window shuts the till
      // and leaves this popup holding the process open - the display would sit
      // there for the five-second graceful wait and then die by Kill(), which
      // Chrome records as a crash. Closing it first lets the till exit cleanly.
      //
      // On two monitors the launcher started the display itself and this handle is
      // null, so this is a no-op and the display.pid path does the work.
      try {
        if (_customerDisplayWin && !_customerDisplayWin.closed) _customerDisplayWin.close();
      } catch { /* already gone, or cross-origin for a window we did not open */ }

      // The POST comes first, deliberately. It is what closes both windows, so it
      // must not be cancelled by window.close() tearing this document down around
      // it. keepalive keeps it in flight even if the window goes first.
      let launcherSession = false;
      try {
        const res = await fetch(BASE + 'api/terminal/close', {
          method: 'POST',
          keepalive: true,
          // The endpoint is open to the login screen as well, so the token rather
          // than the auth cookie is what proves the request came from this origin.
          headers: { 'RequestVerificationToken': document.querySelector('#logoutForm input[name="__RequestVerificationToken"]').value }
        });
        if (res.ok) launcherSession = (await res.json()).launcherSession === true;
      } catch { /* server already gone, or hosted remotely */ }

      // The windows close from the server side a moment after that response. The
      // cover stays up for that moment — there is nothing left worth showing.
      if (launcherSession) return;

      // Nothing for the server to close. A window this page's own script opened can
      // still close itself, so try that before giving up.
      window.close();

      // Still here - opened by hand, or hosted remotely. Nothing navigates from
      // here, deliberately: a navigation issued into a window that is already
      // closing is what painted Chrome's "page can't be reached" over the till on
      // the way out, and a browser error page is the one thing that cannot be
      // allowed to show on a screen meant to look like a desktop app. The shift is
      // signed out server side already, so this cover over a dead till is safe to
      // leave up - it carries the only instruction that is still useful.
      document.getElementById('closingCoverNote').textContent =
        'This window was not opened by Start-Kiosk — press Alt+F4 to close it';
    }
    function handleCheckOut() { openPaymentModal(); }
    function openSeatModal() { const s = prompt('Enter Seat Number (e.g. S1):', 'S1'); if (s) showPOSNotification('info', 'Seat Assigned', `Seat ${s}`); }
    // ================= OPEN ORDERS / RECALL =================
    // The till keeps its own bill number while a recalled bill is being settled,
    // so this is remembered and restored rather than derived from the recall.
    let _tillSeqNo = null;

    // Search, status filter and page are server-side, so a busy day stays light.
    // The rows-per-page choice is remembered on this till only.
    const RECALL_PAGE_SIZES = [10, 25, 50, 100];
    const _recall = { q: '', status: 'all', page: 1, pageSize: 10, pages: 1, seq: 0 };
    try {
      const saved = parseInt(localStorage.getItem('till.orders.pageSize'), 10);
      if (RECALL_PAGE_SIZES.includes(saved)) _recall.pageSize = saved;
    } catch { }
    let _recallSearchTimer = null;

    function setRecallPageSize(v) {
      const n = parseInt(v, 10);
      if (!RECALL_PAGE_SIZES.includes(n)) return;
      _recall.pageSize = n; _recall.page = 1;
      try { localStorage.setItem('till.orders.pageSize', n); } catch { }
      playBeep('click');
      loadRecallList();
    }

    function openViewOrderModal() {
      _recall.q = ''; _recall.status = 'all'; _recall.page = 1;
      document.getElementById('recallPageSize').value = _recall.pageSize;
      document.getElementById('recallSearch').value = '';
      document.getElementById('recallSearchClear').classList.add('hidden');
      openModal('recallModal');
      loadRecallList();
    }

    function onRecallSearch() {
      const v = document.getElementById('recallSearch').value;
      document.getElementById('recallSearchClear').classList.toggle('hidden', !v);
      clearTimeout(_recallSearchTimer);
      _recallSearchTimer = setTimeout(() => { _recall.q = v.trim(); _recall.page = 1; loadRecallList(); }, 300);
    }

    function clearRecallSearch() {
      document.getElementById('recallSearch').value = '';
      onRecallSearch();
    }

    function setRecallStatus(s) { _recall.status = s; _recall.page = 1; playBeep('click'); loadRecallList(); }

    function gotoRecallPage(p) {
      if (p < 1 || p > _recall.pages || p === _recall.page) return;
      _recall.page = p; playBeep('click'); loadRecallList();
    }

    async function loadRecallList() {
      const list = document.getElementById('recallList');
      const btn = document.getElementById('recallRefreshBtn');
      const mySeq = ++_recall.seq;   // a slow reply must not overwrite a newer search
      list.innerHTML = '<tr><td colspan="9" class="py-12 text-center text-sm font-bold text-slate-400">Loading…</td></tr>';
      btn.classList.add('refreshing');

      let data = null;
      try {
        const qs = new URLSearchParams({ q: _recall.q, status: _recall.status, page: _recall.page, pageSize: _recall.pageSize });
        const res = await fetch(BASE + 'api/billing/today-orders?' + qs);
        if (res.ok) data = await res.json();
      } catch { }
      if (mySeq !== _recall.seq) return;
      btn.classList.remove('refreshing');

      if (!data) {
        list.innerHTML = '<tr><td colspan="9" class="py-12 text-center text-sm font-bold text-rose-500">Could not load orders. Tap refresh to try again.</td></tr>';
        renderRecallPager(null); lucide.createIcons(); return;
      }

      _recall.page = data.page; _recall.pages = data.pages;
      renderRecallChips(data.counts);
      renderRecallPager(data);

      if (!data.orders.length) {
        const msg = _recall.q || _recall.status !== 'all'
          ? ['No matching orders', 'Try another search or filter']
          : ['No orders today yet', 'Paid bills and held orders will show here'];
        list.innerHTML = `<tr><td colspan="9" class="py-14 text-center"><div class="w-14 h-14 rounded-2xl bg-brand-50 text-brand-400 flex items-center justify-center mx-auto mb-3"><i data-lucide="inbox" class="w-7 h-7"></i></div><p class="font-bold text-sm text-slate-700">${msg[0]}</p><p class="text-xs text-slate-400 mt-1">${msg[1]}</p></td></tr>`;
        lucide.createIcons(); return;
      }

      list.innerHTML = data.orders.map(o => {
        const name = o.customerName && o.customerName !== 'Walk-in' ? escHtml(o.customerName) : '<span class="text-slate-400">Walk-in</span>';
        const phone = o.customerPhone
          ? `<span class="inline-flex items-center gap-1 text-xs font-bold text-slate-700 font-digital whitespace-nowrap"><i data-lucide="phone" class="w-3.5 h-3.5 text-slate-400"></i>${escHtml(o.customerPhone)}</span>`
          : '<span class="text-slate-300">&mdash;</span>';
        const isHeld = o.kind === 'held';
        const label = isHeld ? `H${o.id}` : orderLabel(o.seqNo);
        return `<tr onclick="openOrderPreview(${o.id}, '${isHeld ? 'held' : 'order'}')" class="cursor-pointer border-b border-slate-100 last:border-0 hover:bg-brand-50/60">
          <td class="px-6 py-3 font-digital font-bold text-base ${isHeld ? 'text-amber-700' : 'text-brand-800'} whitespace-nowrap">${label}</td>
          <td class="px-3 py-3 text-xs font-semibold text-slate-500 whitespace-nowrap">${escHtml(o.localTime)}</td>
          <td class="px-3 py-3 max-w-[200px]"><p class="font-bold text-slate-700 truncate">${name}</p></td>
          <td class="px-3 py-3">${phone}</td>
          <td class="px-3 py-3 text-xs font-semibold text-slate-500 hidden md:table-cell">${o.waiter ? escHtml(o.waiter) : '<span class="text-slate-300">&mdash;</span>'}</td>
          <td class="px-3 py-3 text-center font-bold text-slate-600">${o.itemCount}</td>
          <td class="px-3 py-3">${orderStatusChip(o.status)}</td>
          <td class="px-3 py-3 text-right font-digital font-bold text-slate-900 whitespace-nowrap">${money(o.netTotal)}</td>
          <td class="px-6 py-3 text-right whitespace-nowrap">
            ${isHeld ? `<button onclick="event.stopPropagation(); removeHeldFromList(${o.id})" title="Remove this hold" class="tap mr-1.5 inline-flex items-center gap-1 text-xs font-bold text-rose-600 bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-lg hover:bg-rose-100"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i>Remove</button>` : ''}
            <span class="inline-flex items-center gap-1 text-xs font-bold text-brand-700 bg-brand-50 border border-brand-200 px-2.5 py-1 rounded-lg"><i data-lucide="eye" class="w-3.5 h-3.5"></i>View</span>
          </td>
        </tr>`;
      }).join('');
      lucide.createIcons();
    }

    // Discards a parked hold from the Today's Orders panel. Only holds can be
    // removed here — a paid bill is a sale on the books and stays.
    async function removeHeldFromList(id) {
      if (!await posConfirm({ title: `Remove hold H${id}?`, lines: ['The held items are discarded and cannot be recalled afterwards.'], okText: 'Remove', tone: 'danger' })) return false;
      playBeep('delete');
      let ok = false;
      try {
        const res = await fetch(BASE + `api/billing/held/${id}/discard`, { method: 'POST' });
        ok = res.ok;
        if (ok) showPOSNotification('info', 'Hold Removed', `H${id} was discarded.`);
        else showPOSNotification('warning', 'Cannot Remove', 'That hold was already recalled or discarded.');
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach the server.');
        return false;
      }
      // Either way the row is gone or stale, so refresh the list and the hold badge.
      loadRecallList();
      updatePendingBadge();
      return true;
    }

    function renderRecallChips(c) {
      const chips = [['all', 'All', c.all], ['completed', 'Paid', c.completed], ['held', 'Hold', c.held]];
      document.getElementById('recallStatusChips').innerHTML = chips.map(([key, label, n]) => {
        const on = _recall.status === key;
        return `<button onclick="setRecallStatus('${key}')" class="tap h-9 px-3 rounded-xl text-xs font-bold border flex items-center gap-1.5 ${on ? 'bg-brand-600 border-brand-600 text-white' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}">
          ${label}<span class="text-[10px] font-extrabold px-1.5 rounded-md ${on ? 'bg-white/20' : 'bg-slate-100 text-slate-500'}">${n}</span></button>`;
      }).join('');
    }

    function renderRecallPager(d) {
      const info = document.getElementById('recallPageInfo'), nums = document.getElementById('recallPageNums');
      const prev = document.getElementById('recallPrev'), next = document.getElementById('recallNext');
      if (!d || !d.total) {
        info.textContent = d ? '0 orders' : ''; nums.innerHTML = '';
        prev.disabled = next.disabled = true; return;
      }
      const from = (d.page - 1) * d.pageSize + 1, to = Math.min(d.total, d.page * d.pageSize);
      info.textContent = `Showing ${from}–${to} of ${d.total} order${d.total === 1 ? '' : 's'}`;
      prev.disabled = d.page <= 1; next.disabled = d.page >= d.pages;

      // First, last and a window around the current page, with gaps as "…".
      const show = new Set([1, d.pages, d.page - 1, d.page, d.page + 1].filter(p => p >= 1 && p <= d.pages));
      const list = [...show].sort((a, b) => a - b);
      let html = '', last = 0;
      list.forEach(p => {
        if (p - last > 1) html += '<span class="px-1 text-xs font-bold text-slate-400">…</span>';
        html += `<button onclick="gotoRecallPage(${p})" class="tap w-9 h-9 rounded-xl text-xs font-bold border ${p === d.page ? 'bg-brand-600 border-brand-600 text-white' : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50'}">${p}</button>`;
        last = p;
      });
      nums.innerHTML = html;
    }

    function orderStatusChip(status) {
      const map = {
        ordered:   ['Unpaid', 'bg-amber-50 text-amber-700 border-amber-200'],
        completed: ['Paid',   'bg-emerald-50 text-emerald-700 border-emerald-200'],
        held:      ['Hold',   'bg-amber-50 text-amber-700 border-amber-200'],
        merged:    ['Merged', 'bg-slate-100 text-slate-500 border-slate-200']
      };
      const [label, cls] = map[status] || [status, 'bg-slate-100 text-slate-500 border-slate-200'];
      return `<span class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full border shrink-0 ${cls}">${escHtml(label)}</span>`;
    }

    // Read-only view of one bill, same layout as the admin panel's View dialog.
    async function openOrderPreview(id, kind = 'order') {
      const isHeld = kind === 'held';
      const title = document.getElementById('opTitle'), sub = document.getElementById('opSub'),
            body = document.getElementById('opBody'), recall = document.getElementById('opRecallBtn');
      title.textContent = 'Loading…'; sub.textContent = '';
      body.innerHTML = '<p class="py-10 text-center text-sm font-bold text-slate-400">Loading items…</p>';
      recall.classList.add('hidden');
      document.getElementById('opRemoveBtn').classList.add('hidden');
      openModal('orderPreviewModal');

      let d;
      try {
        const res = await fetch(BASE + 'api/billing/today-orders/' + (isHeld ? 'held/' : '') + id);
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          title.textContent = 'Not available';
          body.innerHTML = `<p class="py-6 text-center text-xs font-bold text-rose-500">${escHtml(err.error || 'That bill could not be loaded.')}</p>`;
          return;
        }
        d = await res.json();
      } catch {
        title.textContent = 'Not available';
        body.innerHTML = '<p class="py-6 text-center text-xs font-bold text-rose-500">Could not reach the server.</p>';
        return;
      }

      title.innerHTML = `${isHeld ? 'Hold H' + d.id : 'Order ' + orderLabel(d.seqNo)} <span class="ml-1 align-middle">${orderStatusChip(d.status)}</span>`;
      sub.textContent = [d.localTime, d.orderMode === 'takeaway' ? 'Take Away' : (d.tableNo ? 'Table ' + d.tableNo : 'Dine In'),
                         d.guests ? d.guests + ' pax' : '', d.waiter ? 'Waiter: ' + d.waiter : '']
                        .filter(Boolean).join('  ·  ');

      const lines = (d.items || []).map(i => `
        <tr class="border-b border-slate-100 last:border-0">
          <td class="py-2 pr-2">
            <p class="font-bold text-slate-700">${escHtml(i.name)}${i.foc ? ' <span class="text-[10px] font-extrabold text-emerald-600">FOC</span>' : ''}</p>
            ${i.note ? `<p class="text-[10px] font-semibold text-slate-400 italic">${escHtml(i.note)}</p>` : ''}
          </td>
          <td class="py-2 px-2 text-center font-bold text-slate-600">${i.qty}</td>
          <td class="py-2 px-2 text-right font-semibold text-slate-500 font-digital">${money(i.price)}</td>
          <td class="py-2 pl-2 text-right font-bold text-slate-900 font-digital">${money(i.foc ? 0 : i.price * i.qty)}</td>
        </tr>`).join('');

      const row = (label, value, strong) =>
        `<div class="flex justify-between ${strong ? 'text-sm font-extrabold text-slate-900 pt-2 mt-1 border-t border-slate-200' : 'text-xs font-semibold text-slate-500'}"><span>${label}</span><span class="font-digital">${value}</span></div>`;

      let totals = '';
      if (isHeld) {
        // A hold has no bill breakdown yet; charges are worked out on recall.
        if (d.discountPercent) totals += row(`Discount (${d.discountPercent}%)`, 'applied on recall');
        totals += row('Total when held', money(d.total), true);
      } else {
        totals += row('Sub total', money(d.subTotal));
        if (d.discountAmount) totals += row(`Discount (${d.discountPercent}%)`, '- ' + money(d.discountAmount));
        if (d.serviceChargeAmount) totals += row(`Service charge (${d.serviceChargePercent}%)`, money(d.serviceChargeAmount));
        if (d.gstAmount) totals += row(`GST (${d.gstPercent}%)`, money(d.gstAmount));
        totals += row('Net total', money(d.total), true);
        if (d.billType === 'split') totals += row('Split between', d.splitCount + ' people');
      }

      const pays = d.payments || [];
      if (pays.length) {
        totals += `<div class="mt-3 p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
          <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Paid by</p>
          ${pays.map(p => `<div class="flex items-center justify-between gap-3">
              <span class="text-xs font-bold text-slate-700 bg-white border border-slate-200 px-2 py-0.5 rounded-lg">${escHtml(p.method)}</span>
              <div class="text-right">
                <p class="text-sm font-extrabold text-slate-900 font-digital">${money(p.amount)}</p>
                ${p.change ? `<p class="text-[10px] font-semibold text-slate-400 font-digital">TENDERED ${money(p.tendered)} &middot; CHANGE ${money(p.change)}</p>` : ''}
              </div>
            </div>`).join('')}
        </div>`;
      } else if (isHeld) {
        totals += `<p class="mt-3 text-center text-xs font-extrabold text-amber-700 bg-amber-50 border border-amber-200 rounded-xl py-2 uppercase tracking-wider">On hold &middot; not billed yet</p>`;
      } else if (d.status === 'ordered') {
        totals += `<p class="mt-3 text-center text-xs font-extrabold text-amber-700 bg-amber-50 border border-amber-200 rounded-xl py-2 uppercase tracking-wider">Not paid yet</p>`;
      }
      if (d.mergedInto) totals += `<p class="text-[11px] font-bold text-slate-400 mt-2">Merged into ${orderLabel(d.mergedInto)} &mdash; these lines are billed there.</p>`;

      const who = `<div class="mb-4 flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
          <div class="min-w-0">
            <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Customer</p>
            <p class="text-sm font-extrabold text-slate-900 truncate">${escHtml(d.customer) || 'Walk-in'}</p>
          </div>
          ${d.phone ? `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-sm font-extrabold text-brand-700 font-digital whitespace-nowrap"><i data-lucide="phone" class="w-4 h-4"></i>${escHtml(d.phone)}</span>`
                    : '<span class="text-xs font-bold text-slate-300">No phone</span>'}
        </div>`;

      body.innerHTML = who + `<table class="w-full text-sm">
          <thead><tr class="text-[10px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-200">
            <th class="text-left pb-2 pr-2">Item</th><th class="text-center pb-2 px-2">Qty</th><th class="text-right pb-2 px-2">Rate</th><th class="text-right pb-2 pl-2">Amount</th>
          </tr></thead>
          <tbody>${lines || '<tr><td colspan="4" class="py-6 text-center text-xs font-bold text-slate-400">No lines on this bill</td></tr>'}</tbody>
        </table>
        <div class="mt-4 space-y-1">${totals}</div>`;

      // A hold goes back onto the till (removing it from the hold list), or is
      // removed outright. Paid bills are read-only here.
      const remove = document.getElementById('opRemoveBtn');
      remove.classList.toggle('hidden', !isHeld);
      remove.onclick = async () => { if (await removeHeldFromList(d.id)) closeModal('orderPreviewModal'); };
      if (isHeld) {
        recall.classList.remove('hidden');
        recall.onclick = async () => {
          if (AppState.cart.length) { showPOSNotification('warning', 'Order in Progress', 'Hold, save or clear the current order first.'); return; }
          closeModal('orderPreviewModal'); closeModal('recallModal');
          await recallPendingOrder(d.id);
        };
      }
      lucide.createIcons();
    }

    async function recallOrder(id) {
      if (AppState.cart.length && !await posConfirm({ title: 'Replace the items on screen with this saved bill?', okText: 'Replace' })) return;

      try {
        const res = await fetch(BASE + 'api/billing/order/' + id);
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          // Someone else settled it; the modal is still open so just reload.
          showPOSNotification('warning', 'Cannot Open', err.error || 'That bill could not be loaded.');
          loadRecallList();
          return;
        }

        const o = await res.json();
        closeModal('recallModal');

        // Remember the till's own number so settling this bill does not rewind it.
        if (_tillSeqNo === null) _tillSeqNo = AppState.seqNo;

        AppState.cart = o.items.map(i => ({
          id: i.id, name: i.name, qty: i.qty,
          rPrice: i.rPrice, cPrice: i.rPrice,
          modifier: i.modifier || '', foc: i.foc
        }));
        AppState.openOrderId    = o.orderId;
        AppState.seqNo          = o.seqNo;
        AppState.orderMode      = o.orderMode;
        AppState.tableNo        = o.tableNo;
        AppState.persons        = o.guests || 1;
        AppState.customer       = o.customerName || 'Walk-in';
        AppState.phone          = o.customerPhone || '';
        AppState.waiterId       = o.waiterId ?? null;
        AppState.discountPercent = o.discountPercent || 0;
        AppState.billType       = 'single';
        AppState.mergeFrom.clear();
        AppState.selectedCartIndex = -1;

        document.getElementById('currentTableBadge').textContent = o.tableNo;
        document.getElementById('currentPersonsCount').textContent = AppState.persons >= 8 ? '8+' : AppState.persons;
        setOrderMode(o.orderMode);
        updateCustomerDisplay();
        renderMergeBadge();
        renderSeqNo();
        refreshAll();

        const { netTotal } = calculateTotals();
        showPOSNotification('info', `Bill ${orderLabel(o.seqNo)}`,
          Math.abs(netTotal - o.netTotal) > 0.005
            ? `Recalculated to ${money(netTotal)} — saved as ${money(o.netTotal)}. Check tax settings.`
            : `${o.tableNo} • ${money(o.netTotal)} • ready to collect`);
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach the server.');
      }
    }
    // ================= MERGE BILLS =================
    let _openOrders = [];
    const _mergePicked = new Set();

    function openMergeBillModal() {
      _mergePicked.clear();
      openModal('mergeModal');
      loadMergeList();
    }

    async function loadMergeList() {
      const list = document.getElementById('mergeList');
      const btn = document.getElementById('mergeRefreshBtn');
      list.innerHTML = '<p class="py-10 text-center text-sm font-bold text-slate-400">Loading…</p>';
      btn.classList.add('refreshing');

      try {
        const res = await fetch(BASE + 'api/billing/open-orders');
        _openOrders = res.ok ? await res.json() : [];
      } catch {
        _openOrders = [];
      }
      btn.classList.remove('refreshing');

      // Drop ticks for bills that another till has since settled or merged.
      const live = new Set(_openOrders.map(o => o.id));
      [..._mergePicked].forEach(id => { if (!live.has(id)) _mergePicked.delete(id); });

      renderMergeList();
    }

    function renderMergeList() {
      const list = document.getElementById('mergeList');
      list.innerHTML = '';

      if (!_openOrders.length) {
        list.innerHTML = `<div class="py-12 text-center"><div class="w-14 h-14 rounded-2xl bg-brand-50 text-brand-400 flex items-center justify-center mx-auto mb-3"><i data-lucide="inbox" class="w-7 h-7"></i></div><p class="font-bold text-sm text-slate-700">No unpaid bills today</p><p class="text-xs text-slate-400 mt-1">Save an order with the Order button first</p></div>`;
        lucide.createIcons(); updateMergeFooter(); return;
      }

      _openOrders.forEach(o => {
        const on = _mergePicked.has(o.id);
        const who = [o.customerName, o.customerPhone].filter(v => v && v !== 'Walk-in').join(' · ');
        const row = document.createElement('button');
        row.className = `tap w-full text-left flex items-center gap-3 px-4 py-3 rounded-2xl border ${on ? 'bg-brand-50 border-brand-300' : 'bg-white border-slate-200 hover:bg-slate-50'}`;
        row.onclick = () => toggleMergePick(o.id);
        row.innerHTML = `
          <span class="w-5 h-5 rounded-md border-2 ${on ? 'bg-brand-600 border-brand-600' : 'border-slate-300'} flex items-center justify-center shrink-0">
            ${on ? '<i data-lucide="check" class="w-3 h-3 text-white"></i>' : ''}
          </span>
          <span class="font-digital font-bold text-lg text-brand-800 w-16 shrink-0">${orderLabel(o.seqNo)}</span>
          <span class="text-xs font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-full shrink-0">${o.orderMode === 'dinein' ? o.tableNo : 'Take Away'}</span>
          <span class="flex-1 min-w-0 text-xs text-slate-500 font-semibold truncate">${who || 'Walk-in'} &middot; ${o.lines} line(s)</span>
          <span class="font-digital font-bold text-base text-slate-900 shrink-0">${money(o.netTotal)}</span>`;
        list.appendChild(row);
      });
      lucide.createIcons();
      updateMergeFooter();
    }

    function toggleMergePick(id) {
      _mergePicked.has(id) ? _mergePicked.delete(id) : _mergePicked.add(id);
      playBeep('click');
      renderMergeList();
    }

    function updateMergeFooter() {
      const total = _openOrders.filter(o => _mergePicked.has(o.id)).reduce((a, o) => a + o.netTotal, 0);
      document.getElementById('mergeSelCount').textContent = _mergePicked.size;
      document.getElementById('mergeSelTotal').textContent = money(total);
      document.getElementById('mergeBtn').disabled = _mergePicked.size < 1;
    }

    // Pulls the chosen bills' lines into the current cart. Nothing is written to
    // the database until this combined bill is saved or settled, so backing out
    // here leaves the original bills untouched.
    async function mergeSelectedBills() {
      if (_mergePicked.size < 1) { showPOSNotification('warning', 'Nothing Picked', 'Select at least one bill.'); return; }

      try {
        const res = await fetch(BASE + 'api/billing/merge-preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderIds: [..._mergePicked] })
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          showPOSNotification('warning', 'Merge Failed', err.error || 'Could not read those bills.');
          return;
        }

        const data = await res.json();
        closeModal('mergeModal');

        // Append, folding into an existing line when the dish, note and FOC match.
        data.items.forEach(i => {
          const line = AppState.cart.find(c =>
            c.id === i.id && (c.modifier || '') === (i.modifier || '') && c.foc === i.foc);
          if (line) line.qty += i.qty;
          else AppState.cart.push({
            id: i.id, name: i.name, qty: i.qty,
            rPrice: i.rPrice, cPrice: i.rPrice,
            modifier: i.modifier || '', foc: i.foc
          });
        });

        // Remember what to absorb; applied server-side on save or payment.
        // billType is left alone — it only ever records 'single' or 'split'.
        data.bills.forEach(b => AppState.mergeFrom.add(b.id));
        AppState.persons = Math.min(20, (AppState.persons || 0) + (data.guests || 0));
        AppState.selectedCartIndex = AppState.cart.length - 1;

        document.getElementById('currentPersonsCount').textContent = AppState.persons >= 8 ? '8+' : AppState.persons;
        renderMergeBadge();
        refreshAll();

        const from = data.bills.map(b => orderLabel(b.seqNo)).join(', ');
        showPOSNotification('success', 'Bills Added', `${from} pulled into this bill — not yet committed`);
      } catch {
        showPOSNotification('warning', 'Network Error', 'Could not reach the server.');
      }
    }

    function renderMergeBadge() {
      const el = document.getElementById('mergeBadge');
      el.textContent = `MERGED ${AppState.mergeFrom.size}`;
      el.classList.toggle('hidden', AppState.mergeFrom.size === 0);
    }
    function handleRefund() { const r = prompt('Receipt number for refund:', '#0001'); if (r) showPOSNotification('info', 'Refund', `Refund started for ${r}.`); }
    function handleReprintReceipt() { showPOSNotification('info', 'Last Order', `${orderLabel(Math.max(1, AppState.seqNo - 1))} sent to printer.`); }

    // A browser can only see the monitor it already sits on, so the local server
    // reports the real Windows display layout instead of us guessing at it.
    let _screens = [];
    const shortScreenName = d => (d || '').split('\\').filter(Boolean).pop() || '?';

    async function refreshScreens() {
      try {
        const res = await fetch(BASE + 'api/screens');
        if (res.ok) _screens = await res.json();
      } catch { }
      return _screens;
    }

    function screenHoldingPos() {
      const dpr = window.devicePixelRatio || 1;
      const cx = (window.screenX + window.outerWidth / 2) * dpr;
      const cy = (window.screenY + window.outerHeight / 2) * dpr;
      return _screens.find(s => cx >= s.left && cx < s.left + s.width
                              && cy >= s.top && cy < s.top + s.height) || null;
    }

    // The monitor the POS is NOT on. Null when there is only one.
    function customerScreen() {
      if (_screens.length < 2) return null;
      const here = screenHoldingPos();
      // With no match, prefer the non-primary screen — never fall through to the
      // first entry, which is the one the till is most likely sitting on.
      if (!here) return _screens.find(s => !s.isPrimary) || null;
      return _screens.find(s => s.deviceName !== here.deviceName) || null;
    }

    // ================= LAUNCHER-OWNED CUSTOMER DISPLAY =================
    // On two monitors Start-Kiosk opens the customer screen as its own kiosk
    // window and marks the till URL with launcher=1, which tells the POS page not
    // to open a second, popup copy of the same screen.
    //
    // That marker only survives one navigation. The till lands on /?launcher=1,
    // [Authorize] bounces it here, and sign-in then redirects to a bare "/" — so
    // by the time billing renders the flag is gone and it opens a popup display
    // on top of the one the launcher already has. Latch it the first time it is
    // seen instead. sessionStorage is scoped to this tab, which is exactly the
    // window the launcher owns, and it survives the login hop and every reload,
    // sign-out and sign-in for the rest of the shift.
    function launcherOwnsDisplay() {
      const KEY = 'kiosk.launcherDisplay';
      const q = new URLSearchParams(location.search);

      // On the login page the flag is inside the ReturnUrl the cookie middleware
      // built from /?launcher=1, not a parameter of its own.
      let returnUrl = '';
      for (const [k, v] of q) if (k.toLowerCase() === 'returnurl') returnUrl = v;
      const nested = new URLSearchParams(returnUrl.split('?')[1] || '');

      const flagged = q.get('launcher') === '1' || nested.get('launcher') === '1';
      try {
        if (flagged) sessionStorage.setItem(KEY, '1');
        return flagged || sessionStorage.getItem(KEY) === '1';
      } catch {
        // Storage walled off (private mode, locked-down profile). The URL is all
        // there is to go on, so fall back to it.
        return flagged;
      }
    }

    let _customerDisplayWin = null;

    function openCustomerDisplay(auto) {
      if (_customerDisplayWin && !_customerDisplayWin.closed) {
        _customerDisplayWin.focus();
        broadcastCart(true);
        return;
      }

      // The layout is already cached, so the window can be placed in the open()
      // call itself. Fetching here would both spend the user-activation token and
      // let the window flash on top of the POS before being moved.
      const target = customerScreen();
      const dpr = window.devicePixelRatio || 1;
      const px = v => Math.round(v / dpr);

      let features = 'popup=yes,menubar=no,toolbar=no,location=no,status=no';
      features += target
        ? `,left=${px(target.workLeft)},top=${px(target.workTop)},width=${px(target.workWidth)},height=${px(target.workHeight)}`
        : ',width=1280,height=720';

      const win = window.open(BASE + 'customer-display?fs=1', 'CustomerDisplay', features);
      // Blocked by the browser: carry on without a display rather than putting a
      // warning bar over the till.
      if (!win) return;
      _customerDisplayWin = win;

      if (target) {
        // Some Chromium builds ignore left/top on open; nudge it into place.
        try {
          win.moveTo(px(target.workLeft), px(target.workTop));
          win.resizeTo(px(target.workWidth), px(target.workHeight));
        } catch { }
        // Keep the till usable — the customer screen must not steal focus.
        window.focus();
        showPOSNotification('info', 'Customer Display',
          `POS on ${shortScreenName(screenHoldingPos()?.deviceName)} → customer screen on ${shortScreenName(target.deviceName)}.`);
      } else if (!auto) {
        // Nothing actionable, so stay quiet when this ran by itself on page load.
        showPOSNotification('warning', 'One Monitor Only',
          'Windows reports a single display, so the customer screen opened on this monitor.');
      }

      refreshScreens(); // keep the layout current for the next open
    }

    function openSettingsModal() { openModal('settingsModal'); }

    // ================= PAYMENT QR =================
    // Set under Admin > Settings for every till; read once on load.
    function loadQrSettings() {
      const p = _posData.payNow || {};
      AppState.showPaymentQr = !!p.enabled;
      AppState.payNowType    = p.type || 'uen';
      AppState.payNowProxy   = p.proxy || '';
      AppState.merchantName  = p.merchantName || '';
    }
    function toggleFullscreen() { document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen().catch(() => {}); }

    // ================= CASH IN / OUT =================
    let txnModes = [], txnRows = [];
    let txnEditing = null;     // the row being edited, or null when adding
    let txnSuggested = '';     // the generated number the form was filled with
    let txnType = 'OUT';
    let txnBusy = false;

    async function txnFetch(path, options = {}) {
      const res = await fetch(BASE + path, {
        cache: 'no-store',
        ...options,
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken() }
      });
      // Expired cookie: hand the page back to the login flow.
      if (res.redirected || res.status === 401 || res.status === 403) { location.reload(); throw new Error('auth'); }
      const body = await res.json().catch(() => null);
      if (!res.ok) throw new Error(body?.error || 'Please try again.');
      return body;
    }

    async function openTransactionModal() {
      document.getElementById('txnFrom').value = document.getElementById('txnTo').value = '';
      openModal('transactionModal');
      try {
        txnModes = await txnFetch('api/billing/transaction-modes');
      } catch (e) {
        if (e.message !== 'auth') showTxnError('Could not load transaction modes.');
        return;
      }
      await Promise.all([resetTxnForm(), loadTransactions()]);
    }

    function showTxnError(msg) {
      const el = document.getElementById('txnError');
      el.textContent = msg || '';
      el.classList.toggle('hidden', !msg);
    }

    function setTxnType(type) {
      txnType = type;
      const paint = (id, on, onCls) => {
        document.getElementById(id).className = `tap h-11 rounded-xl border font-extrabold text-sm flex items-center justify-center gap-1.5 ${on ? onCls : 'bg-white border-slate-200 text-slate-500'}`;
      };
      paint('txnTypeIn', type === 'IN', 'bg-mint-600 border-mint-600 text-white');
      paint('txnTypeOut', type === 'OUT', 'bg-rose-600 border-rose-600 text-white');
      document.getElementById('txnAmountSign').textContent = type === 'IN' ? '+' : '-';
    }

    // An inactive mode stays selectable only on the entry already using it.
    function fillTxnModes(row) {
      const opts = txnModes.map(m => ({ id: m.id, name: m.name }));
      if (row && !opts.some(m => m.id === row.modeId)) opts.push({ id: row.modeId, name: row.mode + ' (inactive)' });
      const sel = document.getElementById('txnMode');
      sel.innerHTML = opts.length
        ? opts.map(m => `<option value="${m.id}">${escHtml(m.name)}</option>`).join('')
        : '<option value="">No modes set up</option>';
      if (row) sel.value = row.modeId;
    }

    async function resetTxnForm() {
      txnEditing = null;
      showTxnError('');
      document.getElementById('txnFormTitle').textContent = 'New Transaction';
      document.getElementById('txnSaveLabel').textContent = 'Add Transaction';
      document.getElementById('txnCancelBtn').classList.add('hidden');
      document.getElementById('txnAmount').value = '';
      document.getElementById('txnRemarks').value = '';
      setTxnType('OUT');
      fillTxnModes(null);
      const num = document.getElementById('txnNumber');
      num.value = '';
      txnSuggested = '';
      try {
        txnSuggested = (await txnFetch('api/billing/transactions/next-number')).number;
        num.value = txnSuggested;
      } catch (e) {
        // Left blank: the server generates a number for an empty field anyway.
      }
    }

    function editTransaction(id) {
      const r = txnRows.find(x => x.id === id);
      if (!r) return;
      playBeep('click');
      txnEditing = r;
      showTxnError('');
      document.getElementById('txnFormTitle').textContent = 'Edit Transaction';
      document.getElementById('txnSaveLabel').textContent = 'Save Changes';
      document.getElementById('txnCancelBtn').classList.remove('hidden');
      document.getElementById('txnNumber').value = r.transactionNo;
      setTxnType(r.type);
      fillTxnModes(r);
      document.getElementById('txnAmount').value = r.amount.toFixed(2);
      document.getElementById('txnRemarks').value = r.remarks;
    }

    async function saveTransaction() {
      if (txnBusy) return;
      const number = document.getElementById('txnNumber').value.trim();
      const amountText = document.getElementById('txnAmount').value.trim();
      const modeId = Number(document.getElementById('txnMode').value);

      if (txnEditing && !number) { showTxnError('Enter a transaction number.'); return; }
      if (!/^[A-Za-z0-9\-_/]*$/.test(number)) { showTxnError('Transaction number can only use letters, digits, - _ or /.'); return; }
      if (!modeId) { showTxnError('Choose a transaction mode.'); return; }
      if (!/^\d{1,5}(\.\d{1,2})?$/.test(amountText) || Number(amountText) <= 0) {
        showTxnError('Enter an amount above 0, up to 99999.99, with at most 2 decimals.');
        document.getElementById('txnAmount').focus();
        return;
      }

      txnBusy = true;
      showTxnError('');
      const btn = document.getElementById('txnSaveBtn');
      btn.disabled = true;
      const editing = txnEditing;
      try {
        // An untouched suggestion goes back empty, so the server draws the number
        // and a till that used this one in the meantime does not cause a refusal.
        const saved = await txnFetch(editing ? `api/billing/transactions/${editing.id}` : 'api/billing/transactions', {
          method: editing ? 'PUT' : 'POST',
          body: JSON.stringify({
            transactionNo: !editing && number === txnSuggested ? '' : number,
            type: txnType,
            modeId,
            amount: Number(amountText),
            remarks: document.getElementById('txnRemarks').value.trim()
          })
        });
        showPOSNotification('success', editing ? 'Transaction Updated' : 'Transaction Added', saved.transactionNo);
        await Promise.all([resetTxnForm(), loadTransactions()]);
      } catch (e) {
        if (e.message !== 'auth') showTxnError(e.message);
      } finally {
        txnBusy = false;
        btn.disabled = false;
      }
    }

    async function deleteTransaction(id) {
      const r = txnRows.find(x => x.id === id);
      if (!r || txnBusy) return;
      const ok = await posConfirm({
        title: 'Delete transaction?',
        lines: [`${r.transactionNo}: ${r.type === 'IN' ? 'Cash In' : 'Cash Out'} ${money(r.amount)} (${r.mode})`],
        okText: 'Delete',
        tone: 'danger'
      });
      if (!ok) return;
      txnBusy = true;
      try {
        await txnFetch(`api/billing/transactions/${id}`, { method: 'DELETE' });
        showPOSNotification('success', 'Transaction Deleted', r.transactionNo);
        if (txnEditing?.id === id) await resetTxnForm();
        await loadTransactions();
      } catch (e) {
        if (e.message !== 'auth') showPOSNotification('warning', 'Delete Failed', e.message);
      } finally {
        txnBusy = false;
      }
    }

    async function loadTransactions() {
      const fromEl = document.getElementById('txnFrom'), toEl = document.getElementById('txnTo');
      const list = document.getElementById('txnList');
      const q = new URLSearchParams();
      if (fromEl.value) q.set('from', fromEl.value);
      if (toEl.value) q.set('to', toEl.value);
      let data;
      try {
        data = await txnFetch('api/billing/transactions?' + q);
      } catch (e) {
        if (e.message !== 'auth') list.innerHTML = `<p class="py-8 text-center text-sm font-bold text-rose-500">${escHtml(e.message)}</p>`;
        return;
      }
      // An empty filter opens on the trading day the server says it is.
      fromEl.value = data.from;
      toEl.value = data.to;
      txnRows = data.rows;
      document.getElementById('txnTotalIn').textContent = money(data.totalIn);
      document.getElementById('txnTotalOut').textContent = money(data.totalOut);
      const net = netAmount(data.totalIn, data.totalOut);
      const netEl = document.getElementById('txnTotalNet');
      netEl.textContent = signedMoney(net);
      netEl.className = `font-mono font-extrabold text-sm ${net < 0 ? 'text-rose-600' : 'text-slate-800'}`;

      if (!txnRows.length) {
        list.innerHTML = '<div class="py-8 text-center"><i data-lucide="arrow-left-right" class="w-8 h-8 text-slate-300 mx-auto mb-2"></i><p class="text-sm font-bold text-slate-500">No transactions for these dates</p></div>';
      } else {
        list.innerHTML = (data.count > txnRows.length ? `<p class="text-[11px] font-bold text-amber-700">Showing the latest ${txnRows.length} of ${data.count}. Narrow the dates to see the rest.</p>` : '') + txnRows.map(r => `
          <div class="border border-slate-200 rounded-2xl px-3.5 py-2.5 flex items-center gap-3">
            <span class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 ${r.type === 'IN' ? 'bg-mint-100 text-mint-700' : 'bg-rose-100 text-rose-600'}"><i data-lucide="${r.type === 'IN' ? 'arrow-down-left' : 'arrow-up-right'}" class="w-4 h-4"></i></span>
            <div class="min-w-0 flex-1">
              <div class="font-mono font-extrabold text-xs text-slate-800 truncate">${escHtml(r.transactionNo)}</div>
              <div class="text-[11px] font-semibold text-slate-400 truncate">${escHtml(r.mode)} · ${escHtml(r.localTime)} · ${escHtml(r.by)}</div>
              ${r.remarks ? `<div class="text-[11px] font-medium text-slate-500 truncate" title="${escHtml(r.remarks)}">${escHtml(r.remarks)}</div>` : ''}
            </div>
            <span class="font-mono font-extrabold text-sm shrink-0 ${r.type === 'IN' ? 'text-mint-700' : 'text-rose-600'}">${r.type === 'IN' ? '+' : '-'}${money(r.amount)}</span>
            <button onclick="editTransaction(${r.id})" title="Edit" class="tap w-8 h-8 rounded-lg bg-brand-50 text-brand-700 flex items-center justify-center shrink-0"><i data-lucide="pencil" class="w-3.5 h-3.5"></i></button>
            <button onclick="deleteTransaction(${r.id})" title="Delete" class="tap w-8 h-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center shrink-0"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
          </div>`).join('');
      }
      lucide.createIcons();
    }

    // ================= SETTLEMENT =================
    let settlementRequest = 0; // only the latest date change may paint the popup

    function openSettlementModal() {
      document.getElementById('setFrom').value = document.getElementById('setTo').value = '';
      openModal('settlementModal');
      loadSettlement();
    }

    // heads and each row line up by column; every column after the first is a figure.
    function settlementTable(id, heads, rows, foot) {
      const cell = (v, i, cls) => `<td class="px-3 py-1.5 ${cls} ${i ? 'text-right font-mono' : ''}">${escHtml(v)}</td>`;
      const body = rows.length
        ? rows.map(r => `<tr class="border-t border-slate-100">${r.map((v, i) => cell(v, i, 'font-bold text-slate-700')).join('')}</tr>`).join('')
        : `<tr><td colspan="${heads.length}" class="px-3 py-5 text-center font-semibold text-slate-400">Nothing for these dates</td></tr>`;
      document.getElementById(id).innerHTML = `<table class="w-full text-xs">
        <thead><tr class="text-[10px] uppercase tracking-wider text-slate-400">${heads.map((h, i) => `<th class="px-3 py-1.5 font-bold ${i ? 'text-right' : 'text-left'}">${escHtml(h)}</th>`).join('')}</tr></thead>
        <tbody>${body}</tbody>
        <tfoot><tr class="border-t-2 border-slate-200 bg-slate-50">${foot.map((v, i) => cell(v, i, 'font-extrabold text-slate-800')).join('')}</tr></tfoot>
      </table>`;
    }

    async function loadSettlement() {
      const fromEl = document.getElementById('setFrom'), toEl = document.getElementById('setTo');
      const errorEl = document.getElementById('setError'), bodyEl = document.getElementById('setBody');
      const request = ++settlementRequest;
      const q = new URLSearchParams();
      if (fromEl.value) q.set('from', fromEl.value);
      if (toEl.value) q.set('to', toEl.value);
      let data;
      try {
        data = await txnFetch('api/billing/settlement?' + q);
      } catch (e) {
        if (e.message === 'auth' || request !== settlementRequest) return;
        // Old figures under the newly picked dates would read as that range's takings.
        errorEl.textContent = e.message;
        errorEl.classList.remove('hidden');
        bodyEl.classList.add('hidden');
        return;
      }
      if (request !== settlementRequest) return;
      errorEl.classList.add('hidden');
      bodyEl.classList.remove('hidden');

      // An empty filter opens on the trading day the server says it is.
      fromEl.value = data.from;
      toEl.value = data.to;
      document.getElementById('setAsOf').textContent = `All tills · as of ${data.asOf}`;

      const s = data.summary;
      document.getElementById('setSummary').innerHTML = [
        ['Sales Total', money(s.salesTotal)],
        ['Total Discount', money(s.discount)],
        ['Service Charge', money(s.serviceCharge)],
        ['GST', money(s.gst)],
        ['Round Off', money(s.roundOff)],
        ['Net Sales', money(s.netSales), 'text-sm font-extrabold text-brand-800 bg-brand-50'],
        ['Number Of Guests', String(s.guests)],
        ['Number Of Receipts', String(s.receipts)],
        ['UnBilled', money(s.unbilled), 'text-sm font-extrabold text-mint-700 bg-mint-50']
      ].map(([label, value, cls]) => `<div class="flex justify-between gap-3 px-3 py-1.5 ${cls || 'text-xs font-bold text-slate-700'}"><span>${label}</span><span class="font-mono">${escHtml(value)}</span></div>`).join('');

      const sum = (rows, key) => rows.reduce((a, r) => a + r[key], 0);
      const payRows = rows => rows.map(p => [p.paymode, money(p.amount)]);

      settlementTable('setPaymodes', ['Paymode', 'Amount', 'Rcpt Cnt'],
        data.paymodes.map(p => [p.paymode, money(p.amount), String(p.receipts)]),
        ['Total', money(sum(data.paymodes, 'amount')), String(s.receipts)]);
      const cashIn = sum(data.transactions, 'cashIn'), cashOut = sum(data.transactions, 'cashOut');
      settlementTable('setTransactions', ['Paymode', 'Cash In', 'Cash Out', 'Net'],
        data.transactions.map(t => [t.paymode, money(t.cashIn), money(t.cashOut), signedMoney(netAmount(t.cashIn, t.cashOut))]),
        ['Total', money(cashIn), money(cashOut), signedMoney(netAmount(cashIn, cashOut))]);
      settlementTable('setSales', ['Paymode', 'Amount'], payRows(data.sales), ['Total', money(sum(data.sales, 'amount'))]);
      settlementTable('setCredit', ['Paymode', 'Amount'], payRows(data.creditSales), ['Total', money(sum(data.creditSales, 'amount'))]);
      settlementTable('setDiscounts', ['Discount', 'Amount'],
        data.discounts.map(d => [d.name, money(d.amount)]),
        ['Total', money(sum(data.discounts, 'amount'))]);
    }

    // ================= VIRTUAL KEYBOARD =================
    let activeInputTarget = null, isShiftActive = false;
    function buildKeyboard() {
      const rows = ['1234567890', 'QWERTYUIOP', 'ASDFGHJKL', 'ZXCVBNM.'];
      const box = document.getElementById('vkRows');
      const key = (label, fn, cls = '') => `<button onclick="${fn}" class="tap h-11 rounded-xl border font-bold flex items-center justify-center ${cls || 'bg-slate-50 border-slate-200 text-slate-800 hover:bg-brand-100'}">${label}</button>`;
      box.innerHTML = rows.map((r, i) => {
        let keys = [...r].map(c => key(c, `virtualKeyPress('${c}')`)).join('');
        if (i === 3) keys = `<button id="vkShiftBtn" onclick="virtualKeyToggleShift()" class="tap h-11 rounded-xl border bg-brand-100 border-brand-200 text-brand-800 flex items-center justify-center"><i data-lucide="arrow-big-up" class="w-5 h-5"></i></button>` + keys + key('<i data-lucide="delete" class="w-5 h-5"></i>', 'virtualKeyBackspace()', 'bg-rose-50 border-rose-200 text-rose-700');
        const cols = i === 2 ? 9 : 10;
        return `<div class="grid gap-1.5 ${i === 2 ? 'px-5' : ''}" style="grid-template-columns:repeat(${cols},minmax(0,1fr))">${keys}</div>`;
      }).join('') + `<div class="flex gap-1.5">${key('-', "virtualKeyPress('-')", 'w-16 bg-slate-50 border-slate-200')}<button onclick="virtualKeyPress(' ')" class="tap flex-1 h-11 rounded-xl border bg-slate-50 border-slate-200 text-slate-500 text-sm font-bold tracking-widest">SPACE</button><button onclick="closeGlobalVirtualKeyboard()" class="tap w-32 h-11 rounded-xl bg-brand-600 text-white font-bold">Enter</button></div>`;
    }
    function openGlobalVirtualKeyboard(el) {
      activeInputTarget = el;
      document.getElementById('vkTargetLabel').textContent = el.getAttribute('placeholder') || 'Field';
      document.getElementById('globalVirtualKeyboard').classList.replace('translate-y-full', 'translate-y-0');
    }
    function closeGlobalVirtualKeyboard() {
      document.getElementById('globalVirtualKeyboard').classList.replace('translate-y-0', 'translate-y-full');
      if (activeInputTarget) activeInputTarget.blur();
    }
    function fireInput() { ['input', 'change'].forEach(t => activeInputTarget.dispatchEvent(new Event(t, { bubbles: true }))); }
    function virtualKeyPress(ch) {
      if (!activeInputTarget) return;
      playBeep('click');
      const c = /[a-z]/i.test(ch) ? (isShiftActive ? ch.toUpperCase() : ch.toLowerCase()) : ch;
      activeInputTarget.value += c;
      fireInput();
      if (isShiftActive) virtualKeyToggleShift();
    }
    function virtualKeyBackspace() { if (!activeInputTarget) return; playBeep('delete'); activeInputTarget.value = activeInputTarget.value.slice(0, -1); fireInput(); }
    function virtualKeyClear() { if (!activeInputTarget) return; activeInputTarget.value = ''; fireInput(); }
    function virtualKeyToggleShift() {
      isShiftActive = !isShiftActive;
      const b = document.getElementById('vkShiftBtn');
      b.classList.toggle('bg-brand-600', isShiftActive); b.classList.toggle('text-white', isShiftActive);
      b.classList.toggle('bg-brand-100', !isShiftActive);
    }
    function bindVirtualKeyboardToInputs() {
      // Bound to click, not focus: the keyboard should appear only when someone
      // taps a field. Focusing a field in code (so a physical keyboard can type
      // straight away) must not force the on-screen keyboard up.
      // Date fields use the browser's picker: appending keystrokes would corrupt them.
      document.querySelectorAll('input:not([type="date"])').forEach(i => i.addEventListener('click', () => openGlobalVirtualKeyboard(i)));
    }

    // ================= SOUND & TOAST =================
    let audioCtx = null;
    function playBeep(type = 'click') {
      if (!AppState.soundEnabled) return;
      try {
        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const now = audioCtx.currentTime;
        const tone = (f, start, dur, wave = 'sine', vol = .1, f2) => {
          const o = audioCtx.createOscillator(), g = audioCtx.createGain();
          o.type = wave; o.frequency.setValueAtTime(f, start);
          if (f2) o.frequency.exponentialRampToValueAtTime(f2, start + dur);
          g.gain.setValueAtTime(vol, start); g.gain.exponentialRampToValueAtTime(.001, start + dur);
          o.connect(g); g.connect(audioCtx.destination); o.start(start); o.stop(start + dur);
        };
        if (type === 'click') tone(900, now, .04, 'sine', .08, 450);
        if (type === 'add') tone(600, now, .08, 'triangle', .1, 900);
        if (type === 'delete') tone(320, now, .08, 'sawtooth', .06, 160);
        if (type === 'cash') [587.33, 739.99, 880, 1174.66].forEach((f, i) => tone(f, now + i * .06, .25, 'sine', .12));
      } catch (e) {}
    }
    function toggleSound() {
      AppState.soundEnabled = !AppState.soundEnabled;
      document.getElementById('soundIcon').setAttribute('data-lucide', AppState.soundEnabled ? 'volume-2' : 'volume-x');
      const chk = document.getElementById('soundToggleCheckbox');
      chk.textContent = AppState.soundEnabled ? 'Enabled' : 'Muted';
      chk.classList.toggle('bg-brand-600', AppState.soundEnabled); chk.classList.toggle('bg-slate-400', !AppState.soundEnabled);
      lucide.createIcons();
    }

    let notifTimeout = null;
    function showPOSNotification(type, title, desc) {
      const banner = document.getElementById('posNotificationBanner');
      document.getElementById('notifTitle').textContent = title;
      document.getElementById('notifDesc').textContent = desc;
      const styles = {
        success: ['bg-mint-100 text-mint-700', 'check-circle-2', 'border-mint-500'],
        warning: ['bg-amber-100 text-amber-700', 'alert-triangle', 'border-amber-500'],
        info: ['bg-brand-100 text-brand-700', 'info', 'border-brand-300']
      }[type] || [];
      document.getElementById('notifIconWrapper').className = `w-9 h-9 rounded-xl flex items-center justify-center shrink-0 ${styles[0]}`;
      document.getElementById('notifIcon').setAttribute('data-lucide', styles[1]);
      banner.className = `fixed top-3 left-1/2 -translate-x-1/2 translate-y-0 opacity-100 transition-all duration-300 z-[200] bg-white border-2 ${styles[2]} px-4 py-3 rounded-2xl shadow-lift flex items-center gap-3 max-w-lg w-[92%] sm:w-auto`;
      lucide.createIcons();
      clearTimeout(notifTimeout);
      notifTimeout = setTimeout(dismissNotification, 3200);
    }
    function dismissNotification() {
      const b = document.getElementById('posNotificationBanner');
      b.classList.remove('translate-y-0', 'opacity-100'); b.classList.add('-translate-y-40', 'opacity-0');
    }

    // ================= CLOCK & SHORTCUTS =================
    function updateClock() {
      const n = new Date();
      document.getElementById('liveClockTime').textContent = shopTime(n, { seconds: true });
      document.getElementById('liveClockDate').textContent = shopDate(n, { weekday: 'short', month: 'short', day: 'numeric' });
    }
    setInterval(updateClock, 1000);

    window.addEventListener('keydown', e => {
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) {
        if (e.key === 'Escape') { document.activeElement.blur(); closeGlobalVirtualKeyboard(); }
        return;
      }
      const map = { F2: clearCurrentOrder, F3: openPendingOrdersModal, F6: holdCurrentOrder, F7: openViewOrderModal, F8: handleCheckOut, F10: openPaymentModal };
      if (map[e.key]) { e.preventDefault(); map[e.key](); return; }
      if (e.key === 'Escape') {
        e.preventDefault(); closeGlobalVirtualKeyboard(); closeMoreMenu(); closePowerMenu();
        // A confirm sits above whatever asked it; Esc answers it and stops there.
        if (_confirmResolve) { resolveConfirm(false); return; }
        const open = ['paymentModal','tableModal','personsModal','pendingModal','modifierModal','discountModal','customerModal','settingsModal','settlementModal','mergeModal','orderPreviewModal','recallModal','punchModal'].find(id => !document.getElementById(id).classList.contains('hidden'));
        // Esc only dismisses things. It must never exit the till — a stray
        // keypress mid-order would close the terminal.
        if (open) closeModal(open);
      }
      if (e.key === '+') adjustSelectedQty(1);
      if (e.key === '-') adjustSelectedQty(-1);
      if (e.key === 'Delete') removeSelectedItem();
      if (e.key === 'ArrowUp') moveSelection(-1);
      if (e.key === 'ArrowDown') moveSelection(1);
    });

    window.addEventListener('DOMContentLoaded', async () => {
      buildKeyboard();
      renderCategories(); renderDishGrid(); renderCart(); calculateTotals();
      try { toggleTotalsBreakdown(localStorage.getItem('pos.totalsOpen') === '1'); } catch { }
      setOrderMode('dinein'); setVegFilter('all');
      bindVirtualKeyboardToInputs(); updateCustomerDisplay(); updateClock(); updatePendingBadge();
      renderSeqNo();
      loadQrSettings();
      loadWaiters();
      loadPunchList();
      lucide.createIcons();

      // Resolve the monitor layout first so the customer screen opens already
      // positioned, then launch it automatically.
      await refreshScreens();
      // The launcher opens the customer screen as its own kiosk window, so only
      // fall back to a popup when the POS was opened manually in a browser.
      if (!launcherOwnsDisplay()) openCustomerDisplay(true);
    });
  </script>
</body>
</html>
