@{
    Layout = null;
    var displayName = ((ViewData["DisplayName"] as string) ?? "").Trim();
    var roleName = (ViewData["RoleName"] as string) ?? "";
    var initial = displayName.Length > 0 ? displayName[..1].ToUpperInvariant() : "?";
    // Only admins and supervisors are offered the jump to the admin panel; for
    // anyone else the button is not rendered at all, so there is nothing to probe.
    var canAdmin = ViewData["CanAdmin"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="en" class="h-full select-none">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>@(await Brand.NameAsync())</title>
  <partial name="_AppIcons" />
  <partial name="_ShopClock" />
  <script src="~/lib/tailwind/tailwind.min.js"></script>
  <script src="~/lib/lucide/lucide.min.js"></script>
  <link rel="stylesheet" href="~/lib/fonts/fonts.css" />
  <link rel="stylesheet" href="~/css/density.css" asp-append-version="true" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
            digital: ['"Chakra Petch"', 'sans-serif'],
          },
          colors: {
            brand: { 25:'#fcfdfa',50:'#f9f9f3',100:'#f1f2e5',200:'#e4e6d1',300:'#d0d3b1',400:'#b8bc8a',500:'#828746',600:'#74793f',700:'#5e6133',800:'#474a26',900:'#37391e',950:'#202211' },
            mint: { 50:'#edfcf5',100:'#d3f7e6',200:'#a7eecb',500:'#10b981',600:'#059669',700:'#047857' }
          },
          boxShadow: {
            'soft': '0 1px 2px rgba(32,34,17,.04), 0 4px 16px -4px rgba(32,34,17,.08)',
            'lift': '0 10px 30px -8px rgba(116,121,63,.28)',
          },
          animation: { 'pop-in': 'popIn .18s cubic-bezier(.16,1,.3,1)' },
          keyframes: { popIn: { '0%': { transform: 'scale(.95)', opacity: 0 }, '100%': { transform: 'scale(1)', opacity: 1 } } }
        }
      }
    }
  </script>
  <style>
    /* White-first page with two faint orange glows - the glass cards need something soft behind them to frost. */
    .app-bg { background-color: #fdfdf9; background-image: radial-gradient(55rem 38rem at -8% -12%, rgba(184,188,138,.32), transparent 60%), radial-gradient(48rem 38rem at 108% 112%, rgba(208,211,177,.38), transparent 60%), radial-gradient(40rem 30rem at 55% 45%, rgba(241,242,229,.55), transparent 70%); background-attachment: fixed; }
    .glass { background: linear-gradient(135deg, rgba(255,255,255,.74), rgba(255,255,255,.4)); -webkit-backdrop-filter: blur(20px) saturate(170%); backdrop-filter: blur(20px) saturate(170%); border: 1px solid rgba(255,255,255,.95); box-shadow: inset 0 1px 0 #fff, inset 0 -1px 0 rgba(255,255,255,.35), 0 10px 30px -12px rgba(116,121,63,.22); }
    /* Modals and the login card: more opaque, so form text stays easy to read over whatever is behind. */
    .glass-strong { background: rgba(255,255,255,.84); -webkit-backdrop-filter: blur(24px) saturate(160%); backdrop-filter: blur(24px) saturate(160%); border: 1px solid rgba(255,255,255,.85); box-shadow: inset 0 1px 0 rgba(255,255,255,.95), 0 18px 48px -16px rgba(32,34,17,.28); }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #e4e6d1; border-radius: 6px; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { scrollbar-width: none; }
    .tap { touch-action: manipulation; transition: transform .1s ease, background-color .15s, border-color .15s, box-shadow .15s; }
    .tap:active { transform: scale(.96); }
    .tap:focus-visible { outline: 2px solid #74793f; outline-offset: 2px; }
    .dish-card:hover { box-shadow: 0 8px 22px -10px rgba(116,121,63,.35); border-color: #d0d3b1; }
    .rail-btn.active::before { content: ''; position: absolute; left: -10px; top: 18%; bottom: 18%; width: 4px; border-radius: 4px; background: #74793f; }
    .rail-btn.active::after { content: ''; position: absolute; right: -9px; top: 50%; transform: translateY(-50%); border-top: 8px solid transparent; border-bottom: 8px solid transparent; border-left: 9px solid #74793f; }
    .cut { --c: 14px; clip-path: polygon(0 0, calc(100% - var(--c)) 0, 100% var(--c), 100% 100%, var(--c) 100%, 0 calc(100% - var(--c))); }
    .cut-frame { padding: 1.5px; }
    .cut-frame > .cut { --c: 13.4px; }
    .tree-section { position: relative; padding-left: 26px; }
    .tree-section::before { content: ''; position: absolute; left: 8px; top: 14px; bottom: 0; width: 2px; background: linear-gradient(#d0d3b1, #f1f2e5); border-radius: 2px; }
    .tree-node { position: absolute; left: 2px; top: 6px; width: 14px; height: 14px; border-radius: 4px; transform: rotate(45deg); background: #fff; border: 2px solid #74793f; }
    .tree-branch { position: absolute; left: -18px; top: 50%; width: 18px; height: 2px; background: #e4e6d1; }
    /* lucide swaps the <i> for an <svg>, so the spin targets the child */
    .refreshing svg { animation: spin .7s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    /* Below sm the header actions share one row; square them up so they fit a 360px phone. */
    @@media (max-width: 639px) {
      #posActions > .tap, #posActions > .relative > .tap { width: 2.25rem; height: 2.25rem; padding: 0; }
    }
  </style>
</head>

<body class="app-bg text-slate-800 h-screen w-screen overflow-hidden flex flex-col font-sans antialiased">

  <!-- TOAST -->
  <div id="posNotificationBanner" class="fixed top-3 left-1/2 -translate-x-1/2 -translate-y-40 opacity-0 transition-all duration-300 z-[200] bg-white border border-brand-200 px-4 py-3 rounded-2xl shadow-lift flex items-center gap-3 max-w-lg w-[92%] sm:w-auto">
    <div id="notifIconWrapper" class="w-9 h-9 rounded-xl bg-brand-100 text-brand-700 flex items-center justify-center shrink-0"><i id="notifIcon" data-lucide="info" class="w-5 h-5"></i></div>
    <div class="flex-1 min-w-0"><h4 id="notifTitle" class="font-bold text-sm text-slate-900">Notification</h4><p id="notifDesc" class="text-xs text-slate-500 truncate">Description</p></div>
    <button onclick="dismissNotification()" class="text-slate-400 hover:text-slate-700 p-1"><i data-lucide="x" class="w-4 h-4"></i></button>
  </div>

  <!-- ========== CLOSING COVER ==========
       Painted the instant Close Terminal is confirmed and never taken down on the
       way out. Chrome needs a moment to tear a window down, and whatever is on
       screen then is what staff see — without this the till blanked out into
       browser furniture. Same colour as the page canvas, so the hand-off to
       Chrome's own last repaint is invisible. -->
  <div id="closingCover" class="hidden fixed inset-0 z-[300] app-bg flex flex-col items-center justify-center">
    <div class="w-24 h-24 rounded-3xl bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-lift flex items-center justify-center">
      <svg viewBox="14.5 14.5 71 71" class="w-12 h-12" aria-hidden="true"><defs><mask id="nbNPos1"><rect x="0" y="0" width="100" height="100" fill="#fff"/><path d="M39 63V36.5h6.6l9.8 14.8V36.5H62V63h-6.6l-9.8-14.8V63z" fill="#000"/></mask></defs><g mask="url(#nbNPos1)"><path d="M50 16.5C58.5 21 67 23.2 75 23.2V47C75 65.5 64.5 77.5 50 84.5C35.5 77.5 25 65.5 25 47V23.2C33 23.2 41.5 21 50 16.5Z" fill="#fff" stroke="#fff" stroke-width="3" stroke-linejoin="round"/><path d="M50 16.5V84.5C35.5 77.5 25 65.5 25 47V23.2C33 23.2 41.5 21 50 16.5Z" fill="#e7e9d6" stroke="#e7e9d6" stroke-width="3" stroke-linejoin="round"/></g></svg>
    </div>
    <p class="mt-6 text-lg font-extrabold text-brand-950 tracking-tight">Closing terminal</p>
    <p id="closingCoverNote" class="mt-1 text-xs font-semibold text-slate-400">Shift ended · signing out</p>
    <i data-lucide="loader-2" class="w-6 h-6 mt-5 text-brand-500 animate-spin"></i>
  </div>

  <form id="logoutForm" method="post" action="@Url.Action("Logout", "Account")" class="hidden">@Html.AntiForgeryToken()</form>

  <!-- HEADER -->
  <!-- Phones: brand and search share the first row, the actions take the second. -->
  @* relative z-30: the blur makes the header its own layer, which would otherwise
     paint the power menu underneath the rail, the cards and the order panel. *@
  <header class="relative z-30 min-h-[3.5rem] lg:h-14 bg-white/70 backdrop-blur-xl border-b border-brand-100 px-3 py-2 lg:px-4 lg:py-0 flex flex-wrap lg:flex-nowrap items-center gap-x-3 gap-y-2 lg:gap-4 shrink-0">
    <div class="flex items-center gap-2.5 lg:w-[200px] shrink-0">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-700 to-brand-500 text-white flex items-center justify-center"><svg viewBox="14.5 14.5 71 71" class="w-5 h-5" aria-hidden="true"><defs><mask id="nbNPos2"><rect x="0" y="0" width="100" height="100" fill="#fff"/><path d="M39 63V36.5h6.6l9.8 14.8V36.5H62V63h-6.6l-9.8-14.8V63z" fill="#000"/></mask></defs><g mask="url(#nbNPos2)"><path d="M50 16.5C58.5 21 67 23.2 75 23.2V47C75 65.5 64.5 77.5 50 84.5C35.5 77.5 25 65.5 25 47V23.2C33 23.2 41.5 21 50 16.5Z" fill="#fff" stroke="#fff" stroke-width="3" stroke-linejoin="round"/><path d="M50 16.5V84.5C35.5 77.5 25 65.5 25 47V23.2C33 23.2 41.5 21 50 16.5Z" fill="#e7e9d6" stroke="#e7e9d6" stroke-width="3" stroke-linejoin="round"/></g></svg></div>
      <div class="leading-tight">
        <div class="font-extrabold text-slate-900">@(await Brand.NameAsync())</div>
        <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider" title="@ViewData["MachineName"] · @ViewData["MachineGuid"]">@ViewData["TerminalName"]</div>
      </div>
    </div>
    <div class="relative flex-1 min-w-0 lg:max-w-xl">
      <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
      <input id="quickDishFilterInput" oninput="handleQuickDishFilter(this.value)" type="text" placeholder="Search dishes…"
        class="w-full h-10 bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-3 text-sm placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white">
    </div>
    <div id="posActions" class="w-full lg:w-auto lg:ml-auto flex items-center justify-between lg:justify-end gap-1 sm:gap-2">
      <div class="hidden xl:flex flex-col items-end pr-3 mr-1 border-r border-slate-200 leading-tight">
        <span id="liveClockTime" class="font-mono font-bold text-xs text-slate-700">--:--</span>
        <span id="liveClockDate" class="text-[10px] font-semibold text-slate-400">Today</span>
      </div>
      <button onclick="openPendingOrdersModal()" class="tap relative h-10 px-3 rounded-xl bg-amber-50 text-amber-800 border border-amber-200 flex items-center justify-center gap-1.5 text-xs font-bold">
        <i data-lucide="clock" class="w-4 h-4"></i><span class="hidden lg:inline">Held</span>
        <span id="pendingCountBadge" class="hidden absolute -top-1.5 -right-1.5 bg-amber-500 text-white text-[10px] font-extrabold w-5 h-5 rounded-full items-center justify-center">0</span>
      </button>
      <button onclick="openTransactionModal()" class="tap w-10 h-10 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 flex items-center justify-center" title="Transactions"><i data-lucide="arrow-left-right" class="w-4 h-4"></i></button>
      <button onclick="openSettlementModal()" class="tap w-10 h-10 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 flex items-center justify-center" title="Settlement"><i data-lucide="receipt-text" class="w-4 h-4"></i></button>
      <button onclick="openSettingsModal()" class="tap w-10 h-10 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 flex items-center justify-center" title="Settings"><i data-lucide="settings-2" class="w-4 h-4"></i></button>
      <!-- Waiters never sign in, so their shift is punched from here. -->
      <button onclick="openPunchModal()" class="tap relative w-10 h-10 rounded-xl bg-mint-50 border border-mint-200 text-mint-700 flex items-center justify-center" title="Waiter punch in / out">
        <i data-lucide="user-round-check" class="w-4 h-4"></i>
        <span id="punchCountBadge" class="hidden absolute -top-1.5 -right-1.5 bg-mint-600 text-white text-[10px] font-extrabold w-5 h-5 rounded-full items-center justify-center">0</span>
      </button>
@if (canAdmin)
{
      <!-- End of Day: moves closed bills to the archive tables. Admin / Supervisor only, checked server side too. -->
      <button id="eodBtn" onclick="runEndOfDay()" class="tap h-10 px-2.5 rounded-xl bg-sky-50 border border-sky-200 text-sky-700 flex items-center justify-center gap-1 text-[11px] font-extrabold" title="End of Day - archive closed bills"><i data-lucide="archive" class="w-4 h-4"></i><span class="hidden sm:inline">EOD</span></button>
      <a href="@Url.Action("Index", "Admin")" onclick="event.preventDefault(); window.location.replace(this.href)" class="tap w-10 h-10 rounded-xl bg-brand-50 border border-brand-200 text-brand-700 flex items-center justify-center" title="Admin panel"><i data-lucide="shield" class="w-4 h-4"></i></a>
}
      <div class="hidden lg:flex flex-col items-end pl-3 ml-1 border-l border-slate-200 leading-tight">
        <span class="text-xs font-extrabold text-slate-800">@displayName</span>
        <span class="text-[10px] font-bold text-brand-400 uppercase tracking-wider">@roleName</span>
      </div>
      <div class="hidden sm:flex w-9 h-9 rounded-full bg-gradient-to-br from-brand-700 to-brand-500 text-white font-bold text-sm items-center justify-center shrink-0" title="@displayName · @roleName">@initial</div>
      <!-- Both ways off this till sit behind the one power button: closing the
           terminal and signing out differ only in whether the window survives, and
           a cashier reaching for one looks in the same place for the other. -->
      <div class="relative">
        <button id="powerMenuBtn" onclick="togglePowerMenu(event)" class="tap w-10 h-10 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center" title="Close terminal"><i data-lucide="power" class="w-4 h-4"></i></button>
        <div id="powerMenu" class="hidden absolute top-12 right-0 w-60 glass-strong rounded-2xl shadow-lift p-1.5 z-[170] animate-pop-in text-sm">
          <button onclick="closePowerMenu();handleClosePOS()" class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-rose-50 flex items-start gap-2.5">
            <i data-lucide="power" class="w-4 h-4 text-rose-600 mt-0.5 shrink-0"></i>
            <span class="min-w-0">
              <span class="block font-bold text-slate-800">Close Terminal</span>
              <span class="block text-[11px] font-semibold text-slate-400 leading-snug">Ends the shift and shuts the window</span>
            </span>
          </button>
          <div class="h-px bg-slate-100 my-1"></div>
          <button onclick="closePowerMenu();handleSignOut()" class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-brand-50 flex items-start gap-2.5">
            <i data-lucide="user-round-x" class="w-4 h-4 text-brand-700 mt-0.5 shrink-0"></i>
            <span class="min-w-0">
              <span class="block font-bold text-slate-800">Logout</span>
              <span class="block text-[11px] font-semibold text-slate-400 leading-snug">Back to sign-in, terminal stays open</span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN: RAIL | MENU | ORDER -->
  <main class="flex-1 flex min-h-0">

    <!-- CATEGORY RAIL -->
    <nav class="w-[84px] lg:w-[104px] shrink-0 bg-white/60 backdrop-blur-xl border-r border-brand-100 flex flex-col">
      <div id="categoryRail" class="flex-1 overflow-y-auto no-scrollbar py-3 pl-[10px] pr-2 space-y-2"></div>
    </nav>

    <!-- MENU AREA -->
    <section class="flex-1 min-w-0 flex flex-col">
      <div class="px-3 lg:px-5 pt-3 lg:pt-4 pb-3 shrink-0">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="min-w-0">
            <div id="levelPath" class="flex items-center gap-1.5 text-xs font-bold flex-wrap"></div>
            <div class="flex items-baseline gap-2 mt-1">
              <h1 id="dishGridCategoryLabel" class="text-xl font-extrabold text-slate-900 tracking-tight">Tiffin</h1>
              <p id="dishGridCountLabel" class="text-xs font-semibold text-slate-400">0 dishes</p>
            </div>
          </div>
          <div class="flex items-center bg-white p-1 rounded-xl border border-slate-200 text-[11px] font-bold">
            <button id="vegFilterAll" onclick="setVegFilter('all')" class="tap px-3 py-1.5 rounded-lg">All</button>
            <button id="vegFilterVeg" onclick="setVegFilter('veg')" class="tap px-3 py-1.5 rounded-lg flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-600"></span>Veg</button>
            <button id="vegFilterNon" onclick="setVegFilter('nonveg')" class="tap px-3 py-1.5 rounded-lg flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-rose-600"></span>Non-veg</button>
          </div>
        </div>
      </div>
      <div class="flex-1 overflow-y-auto px-3 pb-3 lg:px-5 lg:pb-5">
        <div id="dishGrid" class="space-y-5"></div>
      </div>
    </section>

    <!-- ORDER PANEL: a column from lg up; below that a full-screen sheet opened from
         the order bar. z-40 keeps it under the modals it opens (z-50). -->
    <aside id="orderPanel" class="fixed inset-0 z-40 translate-y-full transition-transform duration-300 lg:static lg:z-auto lg:translate-y-0 lg:transition-none lg:w-[380px] xl:w-[410px] shrink-0 bg-white lg:border-l border-brand-100 flex flex-col min-h-0">
      <div class="p-4 border-b border-slate-100 shrink-0 space-y-3">
        <div class="flex lg:hidden items-center justify-between -mt-1">
          <span class="text-sm font-extrabold text-slate-900">Current order</span>
          <button onclick="toggleOrderSheet(false)" class="tap w-9 h-9 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 flex items-center justify-center" title="Back to menu"><i data-lucide="chevron-down" class="w-5 h-5"></i></button>
        </div>
        <div class="flex items-center justify-between gap-3">
          <div class="min-w-0 shrink-0">
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Order</div>
            <div class="flex items-baseline gap-2">
              <span id="seqNumberDisplay" class="font-digital font-bold text-2xl text-slate-900">#1</span>
              <span id="cartItemsBadge" class="text-xs font-semibold text-slate-400">0 items</span>
              <span id="mergeBadge" class="hidden text-[10px] font-extrabold text-brand-800 bg-brand-100 border border-brand-300 px-2 py-0.5 rounded-full tracking-wide">MERGED 0</span>
            </div>
          </div>
          <div class="hidden">
            <button id="btnDineIn" onclick="setOrderMode('dinein')" class="tap flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold"><i data-lucide="utensils" class="w-3.5 h-3.5"></i>Dine In</button>
            <button id="btnTakeAway" onclick="setOrderMode('takeaway')" class="tap flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold"><i data-lucide="shopping-bag" class="w-3.5 h-3.5"></i>Take Away</button>
          </div>
          <div class="flex items-stretch gap-2 min-w-0 flex-1 justify-end">
          <button id="tableChip" onclick="openTableModal()" class="hidden tap bg-brand-50 border border-brand-200 rounded-xl px-2.5 py-2 text-left">
            <div class="text-[10px] font-bold text-brand-500 uppercase">Table</div>
            <div id="currentTableBadge" class="text-sm font-extrabold text-brand-900">T5</div>
          </button>
          <button onclick="openPersonsModal()" class="hidden tap bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-2 text-left">
            <div class="text-[10px] font-bold text-slate-400 uppercase">Guests</div>
            <div id="currentPersonsCount" class="text-sm font-extrabold text-slate-800">2</div>
          </button>
          <button onclick="openCustomerModal()" class="tap bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-left min-w-0 w-44 flex items-center gap-2">
            <i data-lucide="user" class="w-4 h-4 text-slate-400 shrink-0"></i>
            <div class="min-w-0">
              <div class="text-[10px] font-bold text-slate-400 uppercase">Customer</div>
              <div id="topCustomerLabel" class="text-sm font-extrabold text-slate-800 truncate">Walk-in</div>
            </div>
          </button>
          </div>
        </div>
      </div>

      <div id="cartItemsList" class="flex-1 overflow-y-auto px-3 py-2 space-y-1.5"></div>

      <div class="px-3 py-2 border-t border-slate-100 flex items-center gap-1.5 shrink-0">
        <button onclick="openModifierModal()" class="tap flex-1 h-9 rounded-lg bg-brand-50 border border-brand-200 text-brand-800 text-xs font-bold flex items-center justify-center gap-1"><i data-lucide="pencil" class="w-3.5 h-3.5"></i>Note</button>
        <button onclick="toggleFOCForSelected()" class="tap flex-1 h-9 rounded-lg bg-amber-50 border border-amber-200 text-amber-700 text-xs font-bold">FOC</button>
        <button onclick="openDiscountModal()" class="tap flex-1 h-9 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold flex items-center justify-center gap-1"><i data-lucide="percent" class="w-3.5 h-3.5"></i>Disc.</button>
        <button onclick="clearCurrentOrder()" class="tap w-9 h-9 rounded-lg bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center" title="Clear cart (F2)"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
        <div class="relative">
          <button onclick="toggleMoreMenu(event)" class="tap w-9 h-9 rounded-lg bg-slate-50 border border-slate-200 text-slate-600 flex items-center justify-center" title="More"><i data-lucide="more-vertical" class="w-4 h-4"></i></button>
          <div id="moreMenu" class="hidden absolute bottom-11 right-0 w-52 glass-strong rounded-2xl shadow-lift p-1.5 z-40 animate-pop-in text-sm">
            <button onclick="closeMoreMenu();handleReprintReceipt()" class="w-full text-left px-3 py-2 rounded-lg hover:bg-brand-50 flex items-center gap-2"><i data-lucide="printer" class="w-4 h-4 text-slate-400"></i>Last Order</button>
          </div>
        </div>
      </div>

      <!-- Totals -->
      <div class="px-4 pt-3 pb-4 border-t border-slate-100 bg-slate-50/70 shrink-0">
        <div id="totalsBreakdown" class="hidden space-y-1 text-xs font-mono mb-2">
          <div class="flex justify-between"><span class="font-sans text-slate-500">Sub Total</span><span id="summarySubTotal" class="font-bold">$0.00</span></div>
          <div class="flex justify-between"><span class="font-sans text-slate-500">Discount (<span id="discountPercentLabel">0.00%</span>)</span><span id="summaryDiscount" class="font-bold text-amber-600">-$0.00</span></div>
          <div class="flex justify-between"><span class="font-sans text-slate-500">Service (<span id="servicePercentLabel">@(((decimal)ViewData["ServiceChargePercent"]!).ToString("0.00"))%</span>)</span><span id="summaryServiceCharge" class="font-bold">$0.00</span></div>
          <div class="flex justify-between"><span class="font-sans text-slate-500">Incdtl</span><span id="summaryIncdtl" class="font-bold">$0.00</span></div>
          <div class="flex justify-between"><span class="font-sans text-slate-500">GST (<span id="gstPercentLabel">@(((decimal)ViewData["GstPercent"]!).ToString("0.00"))%</span>)</span><span id="summaryGST" class="font-bold">$0.00</span></div>
        </div>
        <div onclick="toggleTotalsBreakdown()" class="flex justify-between items-end pt-2 border-t border-dashed border-slate-300 cursor-pointer select-none">
          <span class="text-sm font-extrabold text-slate-900 flex items-center gap-1">Net Total<span id="totalsBreakdownChevron" class="inline-flex text-slate-400 transition-transform"><i data-lucide="chevron-down" class="w-4 h-4"></i></span></span>
          <span id="summaryNetTotal" class="font-digital font-bold text-3xl text-brand-800 leading-none">$0.00</span>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-3">
          <button onclick="holdCurrentOrder()" class="tap h-12 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold flex flex-col items-center justify-center"><i data-lucide="pause" class="w-4 h-4"></i>Hold</button>
          <button onclick="openViewOrderModal()" class="tap h-12 rounded-xl bg-brand-100 border border-brand-300 text-brand-800 text-xs font-bold flex flex-col items-center justify-center"><i data-lucide="file-text" class="w-4 h-4"></i>Order</button>
          <button onclick="printBill()" class="tap h-12 rounded-xl bg-mint-50 border border-mint-200 text-mint-700 text-xs font-bold flex flex-col items-center justify-center"><i data-lucide="printer" class="w-4 h-4"></i>Quote</button>
        </div>
        <button onclick="openPaymentModal()" class="tap mt-2 w-full h-14 rounded-2xl bg-gradient-to-r from-brand-700 to-brand-500 text-white font-extrabold shadow-lift flex items-center justify-between px-5">
          <span class="flex items-center gap-2"><i data-lucide="credit-card" class="w-5 h-5"></i>Pay <span class="text-[10px] font-bold text-brand-200">F10</span></span>
          <span id="payBtnTotal" class="font-digital text-xl">$0.00</span>
        </button>
      </div>
    </aside>
  </main>

  <!-- Below lg: what is on the order, always in reach; tapping it opens the order sheet. -->
  <button id="orderSheetBar" onclick="toggleOrderSheet(true)" class="lg:hidden tap shrink-0 mx-3 mb-3 h-14 rounded-2xl bg-gradient-to-r from-brand-700 to-brand-500 text-white font-extrabold shadow-lift flex items-center justify-between px-5">
    <span class="flex items-center gap-2"><i data-lucide="shopping-basket" class="w-5 h-5"></i>View order <span id="orderSheetBarCount" class="text-xs font-bold text-brand-200">0 items</span></span>
    <span id="orderSheetBarTotal" class="font-digital text-xl">$0.00</span>
  </button>

  <!-- VIRTUAL KEYBOARD -->
  <!-- mousedown is cancelled so tapping a key never steals focus from the field being typed into. -->
  <div id="globalVirtualKeyboard" onmousedown="event.preventDefault()" class="fixed bottom-0 inset-x-0 bg-white/95 backdrop-blur-xl border-t border-brand-200 shadow-2xl p-3 z-[150] translate-y-full transition-transform duration-200">
    <div class="max-w-4xl mx-auto space-y-1.5">
      <div class="flex items-center justify-between px-1 pb-1.5 text-xs">
        <div class="flex items-center gap-2 text-slate-500"><i data-lucide="keyboard" class="w-4 h-4 text-brand-600"></i>Typing in: <span id="vkTargetLabel" class="font-bold text-brand-700">Field</span></div>
        <div class="flex gap-2">
          <button onclick="virtualKeyClear()" class="tap px-3 py-1 rounded-lg bg-rose-50 text-rose-700 font-bold border border-rose-200">Clear</button>
          <button onclick="closeGlobalVirtualKeyboard()" class="tap px-4 py-1 rounded-lg bg-brand-600 text-white font-bold">Done</button>
        </div>
      </div>
      <div id="vkRows" class="space-y-1.5"></div>
    </div>
  </div>

  <!-- ===================== MODALS ===================== -->

  <!-- PAYMENT -->
  <div id="paymentModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="glass-strong rounded-3xl w-full max-w-5xl shadow-2xl overflow-hidden animate-pop-in flex flex-col max-h-[95vh]">
      <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center shrink-0">
        <h2 class="text-base font-extrabold text-slate-900">Settle Payment</h2>
        <button onclick="closeModal('paymentModal')" class="text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <div id="paymentModalBody" class="flex-1 overflow-y-auto p-6 space-y-5">
        <div class="bg-brand-50 border border-brand-200 rounded-2xl p-4 flex flex-wrap sm:flex-nowrap items-center gap-x-5 gap-y-3">
          <div class="shrink-0"><span class="text-[11px] text-brand-600 font-bold uppercase tracking-wider block">Amount Payable</span><span id="paymentModalTotal" class="font-digital font-bold text-3xl text-brand-900">$0.00</span></div>

          <!-- WAITER — who the bill is credited to, saved on the order; leave
               unassigned for counter sales. One scrolling row of chips rather than
               a dropdown: at a touch screen a tap beats opening a list, and the row
               keeps working the same way whether there are three waiters or thirty. -->
          <div class="order-last sm:order-none basis-full sm:basis-auto flex-1 min-w-0">
            <span class="text-[11px] text-brand-600 font-bold uppercase tracking-wider block mb-1.5">Waiter</span>
            <div id="waiterCards" class="flex gap-2 overflow-x-auto pb-1 -mb-1"></div>
            <p id="waiterEmptyHint" class="hidden mt-1.5 text-[11px] font-semibold text-amber-600">No active waiter accounts — add one in the Admin Panel to credit bills.</p>
          </div>

          <span id="paymentModalModeBadge" class="shrink-0 ml-auto self-start sm:self-center bg-white border border-brand-200 text-brand-800 text-xs px-3 py-1 rounded-full font-bold">Dine In (T5)</span>
        </div>

        <!-- MIXED: one payer, any number of tenders. One box per active mode under
             Admin > Transaction Modes; whatever they leave goes on QR / UPI. Leave a
             part at 0 to skip it, so an all-cash bill is just one part. -->
        <div id="mixedSection" class="hidden space-y-3">
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
            <!-- Two rows of tenders show at once (row = 28 label + 4 + 46 input = 78px,
                 x2 + 12 gap = 168, + 4 padding so the focus border isn't clipped);
                 the rest scroll. Focusing a box (Tab / Enter) scrolls it into view. -->
            <div id="mixedInputs" class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-h-[172px] overflow-y-auto p-0.5 pr-1.5"></div>
            <p class="text-[11px] text-slate-400 mt-2">The rest is paid by QR / UPI. Leave a part at 0 to skip it.</p>
          </div>
          <div id="mixedSummary" class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center"></div>
          <p id="mixedOverWarn" class="hidden text-xs font-bold text-red-600 text-center"></p>
        </div>

        <!-- SPLIT BILL -->
        <div id="splitSection" class="hidden">
          <div class="flex items-center justify-between bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 mb-3">
            <div>
              <span class="text-xs font-bold text-slate-600 block">Split between</span>
              <span class="text-[11px] text-slate-400">Tap an amount to change it; the others share what is left</span>
              <button onclick="resetSplitAmounts()" id="splitResetBtn" class="tap hidden text-[11px] font-bold text-brand-700 underline">Reset to equal</button>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button onclick="changeSplitCount(-1)" class="tap w-9 h-9 rounded-xl bg-white border border-slate-200 font-extrabold text-slate-600">&minus;</button>
              <span id="splitCount" class="w-10 text-center font-digital font-bold text-xl">2</span>
              <button onclick="changeSplitCount(1)" class="tap w-9 h-9 rounded-xl bg-white border border-slate-200 font-extrabold text-brand-700">+</button>
            </div>
          </div>

          <div id="splitList" class="space-y-2 max-h-52 overflow-y-auto mb-3"></div>
          <div id="splitWarn" class="hidden px-4 py-2 mb-3 rounded-xl bg-rose-50 border border-rose-200 text-xs font-bold text-rose-700"></div>

          <div class="grid grid-cols-3 gap-2 text-center">
            <div class="bg-slate-50 border border-slate-200 rounded-xl py-2">
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Order</div>
              <div id="splitOrderTotal" class="font-digital font-bold text-lg text-slate-800">$0.00</div>
            </div>
            <div class="bg-mint-50 border border-mint-200 rounded-xl py-2">
              <div class="text-[10px] font-bold text-mint-600 uppercase tracking-wider">Collected</div>
              <div id="splitCollected" class="font-digital font-bold text-lg text-mint-700">$0.00</div>
            </div>
            <div class="bg-amber-50 border border-amber-200 rounded-xl py-2">
              <div class="text-[10px] font-bold text-amber-600 uppercase tracking-wider">Remaining</div>
              <div id="splitRemaining" class="font-digital font-bold text-lg text-amber-700">$0.00</div>
            </div>
          </div>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-slate-100 flex justify-end gap-3 shrink-0">
        <button onclick="closeModal('paymentModal')" class="tap px-5 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-bold text-sm">Cancel</button>
        <button onclick="finalizePayment()" class="tap px-6 py-2.5 rounded-xl bg-mint-600 hover:bg-mint-700 text-white font-extrabold text-sm flex items-center gap-2"><i data-lucide="check" class="w-4 h-4"></i>Complete Payment</button>
      </div>
    </div>
  </div>

  <!-- TABLE -->
  <div id="tableModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="glass-strong rounded-3xl w-full max-w-md shadow-2xl p-5 animate-pop-in">
      <div class="flex justify-between items-center mb-4"><h3 class="text-base font-extrabold">Select Table</h3><button onclick="closeModal('tableModal')" class="text-slate-400"><i data-lucide="x" class="w-5 h-5"></i></button></div>
      <div id="tableGrid" class="grid grid-cols-4 gap-2.5"></div>
    </div>
  </div>

  <!-- PERSONS -->
  <div id="personsModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="glass-strong rounded-3xl w-full max-w-xs shadow-2xl p-5 animate-pop-in">
      <div class="flex justify-between items-center mb-4"><h3 class="text-base font-extrabold">Number of Guests</h3><button onclick="closeModal('personsModal')" class="text-slate-400"><i data-lucide="x" class="w-5 h-5"></i></button></div>
      <div id="personsGrid" class="grid grid-cols-4 gap-2"></div>
    </div>
  </div>

  <!-- PENDING -->
  <div id="pendingModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="glass-strong rounded-3xl w-full max-w-lg shadow-2xl p-5 animate-pop-in">
      <div class="flex justify-between items-center mb-4"><h3 class="text-base font-extrabold">Held Orders</h3><button onclick="closeModal('pendingModal')" class="text-slate-400"><i data-lucide="x" class="w-5 h-5"></i></button></div>
      <div id="pendingOrdersList" class="space-y-2.5 max-h-80 overflow-y-auto"></div>
    </div>
  </div>

  <!-- WAITER PUNCH -->
  <div id="punchModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="glass-strong rounded-3xl w-full max-w-lg shadow-2xl p-5 animate-pop-in flex flex-col max-h-[85vh]">
      <div class="flex justify-between items-center mb-4 shrink-0">
        <div>
          <h3 class="text-base font-extrabold">Waiter Attendance</h3>
          <p class="text-[11px] text-slate-400 font-semibold">Punch a waiter in at the start of their shift, and out at the end</p>
        </div>
        <div class="flex items-center gap-1">
          <button onclick="loadPunchList()" title="Refresh list" class="tap w-9 h-9 rounded-xl bg-slate-50 border border-slate-200 text-brand-700 flex items-center justify-center"><i data-lucide="refresh-cw" class="w-4 h-4"></i></button>
          <button onclick="closeModal('punchModal')" class="w-9 h-9 flex items-center justify-center text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
      </div>

      <div class="flex gap-2 mb-4 shrink-0">
        <select id="punchWaiterSelect" class="flex-1 min-w-0 h-11 px-3 rounded-xl border border-slate-200 bg-slate-50 text-sm font-bold text-slate-700 focus:outline-none focus:border-brand-500 focus:bg-white"></select>
        <button id="punchInBtn" onclick="punchIn()" class="tap h-11 px-5 rounded-xl bg-mint-600 hover:bg-mint-700 text-white font-extrabold text-sm flex items-center gap-2 shrink-0 disabled:opacity-40"><i data-lucide="log-in" class="w-4 h-4"></i>Punch In</button>
      </div>

      <div class="flex items-center justify-between mb-2 shrink-0">
        <span class="text-xs font-extrabold text-slate-500 uppercase tracking-wider">On shift</span>
        <span id="punchOnCount" class="text-xs font-bold text-slate-400"></span>
      </div>
      <div id="punchList" class="space-y-2 overflow-y-auto min-h-0"></div>
    </div>
  </div>

  <!-- CONFIRM: the till's own stand-in for window.confirm(), which shows the
       browser's "this page says" box. Above every other modal, since some ask
       from inside one. Driven by posConfirm(). -->
  <div id="confirmModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[180] flex items-center justify-center p-4">
    <div class="glass-strong rounded-3xl w-full max-w-sm shadow-2xl p-6 animate-pop-in">
      <div class="flex items-start gap-3 mb-4">
        <div id="confirmIconWrap" class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"><i id="confirmIcon" class="w-5 h-5"></i></div>
        <div class="min-w-0">
          <h3 id="confirmTitle" class="text-base font-extrabold text-slate-900"></h3>
          <div id="confirmBody" class="mt-1 space-y-2 text-sm font-medium text-slate-500"></div>
        </div>
      </div>
      <div id="confirmWarn" class="hidden mb-4 px-4 py-3 rounded-2xl bg-amber-50 border border-amber-200">
        <div class="flex items-center gap-2 text-amber-800 text-xs font-extrabold uppercase tracking-wider mb-1"><i data-lucide="alert-triangle" class="w-4 h-4"></i><span id="confirmWarnTitle"></span></div>
        <p id="confirmWarnText" class="text-sm font-semibold text-amber-900"></p>
        <button id="confirmWarnAction" class="tap hidden mt-2.5 h-9 px-3.5 rounded-xl bg-white border border-amber-300 text-amber-800 font-bold text-xs flex items-center gap-1.5"><i data-lucide="user-check" class="w-3.5 h-3.5"></i><span id="confirmWarnActionText"></span></button>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <button onclick="resolveConfirm(false)" class="tap h-11 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm">Cancel</button>
        <button id="confirmOkBtn" onclick="resolveConfirm(true)" class="tap h-11 rounded-xl text-white font-extrabold text-sm"></button>
      </div>
    </div>
  </div>

  <!-- VIEW / RECALL ORDER -->
  <div id="recallModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-3 sm:p-6">
    <div class="glass-strong rounded-3xl w-full max-w-6xl h-full max-h-[92vh] shadow-2xl overflow-hidden animate-pop-in flex flex-col">
      <!-- Header -->
      <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center gap-3 shrink-0">
        <div class="min-w-0">
          <h2 class="text-lg font-extrabold text-slate-900">Today's Orders</h2>
          <p class="text-[11px] text-slate-400 font-semibold">Paid bills and holds of this trading day &middot; newest first &middot; tap a row to preview</p>
        </div>
        <div class="flex items-center gap-1">
          <button id="recallRefreshBtn" onclick="loadRecallList()" title="Refresh list" class="tap w-9 h-9 rounded-xl bg-slate-50 border border-slate-200 text-brand-700 flex items-center justify-center"><i data-lucide="refresh-cw" class="w-4 h-4"></i></button>
          <button onclick="closeModal('recallModal')" class="w-9 h-9 flex items-center justify-center text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
      </div>
      <!-- Toolbar: search + status chips -->
      <div class="px-6 py-3 border-b border-slate-100 flex flex-wrap items-center gap-3 shrink-0">
        <div class="relative flex-1 min-w-[220px] max-w-md">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
          <input id="recallSearch" type="text" autocomplete="off" placeholder="Search order no, customer or phone…"
                 oninput="onRecallSearch()"
                 class="w-full h-10 pl-9 pr-9 rounded-xl bg-slate-50 border border-slate-200 text-sm font-semibold focus:outline-none focus:border-brand-500 focus:bg-white">
          <button id="recallSearchClear" onclick="clearRecallSearch()" class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-6 h-6 rounded-md text-slate-400 hover:text-slate-700 flex items-center justify-center"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div id="recallStatusChips" class="flex flex-wrap gap-1.5"></div>
      </div>
      <!-- Table -->
      <div class="flex-1 overflow-auto">
        <table class="w-full text-sm">
          <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur">
            <tr class="text-[10px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-200">
              <th class="text-left px-6 py-2.5">Order</th>
              <th class="text-left px-3 py-2.5">Time</th>
              <th class="text-left px-3 py-2.5">Customer</th>
              <th class="text-left px-3 py-2.5">Phone</th>
              <th class="text-left px-3 py-2.5 hidden md:table-cell">Waiter</th>
              <th class="text-center px-3 py-2.5">Qty</th>
              <th class="text-left px-3 py-2.5">Status</th>
              <th class="text-right px-3 py-2.5">Total</th>
              <th class="px-6 py-2.5"></th>
            </tr>
          </thead>
          <tbody id="recallList"></tbody>
        </table>
      </div>
      <!-- Footer: paging -->
      <div class="px-6 py-3 border-t border-slate-100 bg-slate-50/70 flex flex-wrap items-center gap-3 shrink-0">
        <label class="flex items-center gap-2 text-xs font-semibold text-slate-500">
          Rows per page
          <select id="recallPageSize" onchange="setRecallPageSize(this.value)"
                  class="h-9 pl-3 pr-8 rounded-xl bg-white border border-slate-200 text-xs font-bold text-slate-700 focus:outline-none focus:border-brand-500 cursor-pointer">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </label>
        <span id="recallPageInfo" class="text-xs font-semibold text-slate-500"></span>
        <div class="ml-auto flex items-center gap-1.5">
          <button id="recallPrev" onclick="gotoRecallPage(_recall.page - 1)" class="tap h-9 px-3 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold flex items-center gap-1 disabled:opacity-40 disabled:pointer-events-none"><i data-lucide="chevron-left" class="w-4 h-4"></i>Prev</button>
          <div id="recallPageNums" class="flex items-center gap-1"></div>
          <button id="recallNext" onclick="gotoRecallPage(_recall.page + 1)" class="tap h-9 px-3 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold flex items-center gap-1 disabled:opacity-40 disabled:pointer-events-none">Next<i data-lucide="chevron-right" class="w-4 h-4"></i></button>
        </div>
      </div>
    </div>
  </div>

  <!-- ORDER PREVIEW -->
  <div id="orderPreviewModal" onclick="if (event.target === this) closeModal('orderPreviewModal')" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[60] flex items-center justify-center p-4">
    <div class="glass-strong rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden animate-pop-in flex flex-col max-h-[90vh]">
      <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-start gap-3 shrink-0">
        <div class="min-w-0">
          <h2 id="opTitle" class="text-base font-extrabold text-slate-900"></h2>
          <p id="opSub" class="text-[11px] text-slate-400 font-semibold mt-0.5"></p>
        </div>
        <button onclick="closeModal('orderPreviewModal')" class="w-9 h-9 flex items-center justify-center text-slate-400 hover:text-slate-700 shrink-0"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <div id="opBody" class="flex-1 overflow-y-auto px-6 py-4"></div>
      <div class="px-6 py-3 border-t border-slate-100 bg-slate-50/70 flex items-center gap-2 shrink-0">
        <button id="opRecallBtn" class="hidden tap px-5 py-2 rounded-xl bg-brand-600 text-white font-bold text-sm flex items-center gap-1.5"><i data-lucide="rotate-ccw" class="w-4 h-4"></i>Recall to till</button>
        <button id="opRemoveBtn" class="hidden tap px-4 py-2 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 font-bold text-sm flex items-center gap-1.5"><i data-lucide="trash-2" class="w-4 h-4"></i>Remove</button>
        <button onclick="closeModal('orderPreviewModal')" class="tap ml-auto px-5 py-2 rounded-xl bg-slate-100 text-slate-700 font-bold text-sm">Close</button>
      </div>
    </div>
  </div>

  <!-- MERGE BILL -->
  <div id="mergeModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="glass-strong rounded-3xl w-full max-w-2xl shadow-2xl overflow-hidden animate-pop-in flex flex-col max-h-[85vh]">
      <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center shrink-0">
        <div>
          <h2 class="text-base font-extrabold text-slate-900">Merge Bills</h2>
