@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Display</title>
  <partial name="_AppIcons" />
  <script src="~/lib/tailwind/tailwind.min.js"></script>
  <script src="~/lib/qrcodejs/qrcode.min.js"></script>
  <link rel="stylesheet" href="~/lib/fonts/fonts.css" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            digital: ['"Chakra Petch"', 'sans-serif'],
          },
          colors: {
            lavender: { 50:'#f6f3fc', 100:'#ece5fa', 200:'#ded2f6', 300:'#c5b0f0', 500:'#8c60dc', 600:'#7540cc', 700:'#6432b4', 800:'#522995', 950:'#231046' },
            mint: { 50:'#edfcf5', 500:'#10b981', 600:'#059669' }
          }
        }
      }
    }
  </script>
  <style>
    body {
      background:
        radial-gradient(1100px 520px at 8% -12%, #ece5fa 0%, transparent 62%),
        radial-gradient(900px 480px at 108% 112%, #e4f6ef 0%, transparent 60%),
        #f4f2f9;
    }
    .row-in { animation: rowIn .28s cubic-bezier(.16,1,.3,1) both; }
    @@keyframes rowIn { from { opacity:0; transform:translateY(16px) scale(.985); } to { opacity:1; transform:none; } }
    .fade-out { animation: fadeOut .2s ease forwards; }
    @@keyframes fadeOut { to { opacity:0; transform:translateX(16px); } }
    .total-pop { animation: totalPop .32s cubic-bezier(.16,1,.3,1); }
    @@keyframes totalPop { from { transform:scale(.955); } to { transform:scale(1); } }
    .glow { animation: glow 2.6s ease-in-out infinite; }
    @@keyframes glow { 0%,100%{opacity:.45} 50%{opacity:.85} }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #ded2f6; border-radius: 8px; }
  </style>
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col font-sans antialiased select-none">

  <!-- HEADER -->
  <header class="h-24 bg-gradient-to-r from-lavender-950 via-lavender-800 to-lavender-600 text-white flex items-center justify-between px-12 shrink-0 shadow-xl relative overflow-hidden">
    <div class="absolute inset-0 opacity-25 pointer-events-none" style="background:radial-gradient(620px 220px at 18% 0%, #fff, transparent 70%)"></div>
    <div class="relative flex items-center gap-5">
      <div class="w-14 h-14 rounded-2xl bg-white/15 ring-1 ring-white/25 flex items-center justify-center">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </div>
      <div>
        <div class="font-extrabold text-3xl leading-none tracking-tight">@(await Brand.NameAsync())</div>
        <div class="text-[11px] text-white/55 uppercase tracking-[0.22em] font-bold mt-1.5">Customer Display</div>
      </div>
    </div>
    <div class="relative text-right">
      <div id="clockDisplay" class="font-digital text-4xl leading-none"></div>
      <div id="dateDisplay" class="text-[11px] text-white/50 font-bold uppercase tracking-[0.15em] mt-1.5"></div>
    </div>
  </header>

  <!-- FULLSCREEN HINT -->
  <div id="fsHint" class="hidden fixed inset-x-0 bottom-0 z-50 bg-lavender-950/90 text-white text-center py-3 text-sm font-bold">
    Click anywhere to go fullscreen &nbsp;·&nbsp; or press F11
  </div>

  <!-- IDLE SCREEN -->
  <div id="idleScreen" class="flex-1 flex flex-col items-center justify-center gap-9">
    <div class="relative">
      <div class="absolute -inset-5 rounded-[2.75rem] bg-lavender-300 blur-3xl glow"></div>
      <div class="relative w-36 h-36 rounded-[2.25rem] bg-white ring-1 ring-lavender-200 shadow-2xl flex items-center justify-center">
        <svg class="w-20 h-20 text-lavender-600" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </div>
    </div>
    <div class="text-center">
      <h1 class="text-7xl font-extrabold text-lavender-900 tracking-tight mb-4">Welcome</h1>
      <p class="text-slate-400 font-semibold text-2xl">Your order will appear here</p>
    </div>
    <div class="flex gap-3">
      <span class="w-3 h-3 rounded-full bg-lavender-300 animate-bounce" style="animation-delay:0ms"></span>
      <span class="w-3 h-3 rounded-full bg-lavender-500 animate-bounce" style="animation-delay:150ms"></span>
      <span class="w-3 h-3 rounded-full bg-lavender-700 animate-bounce" style="animation-delay:300ms"></span>
    </div>
  </div>

  <!-- THANK YOU SCREEN -->
  <div id="thankYouScreen" class="hidden flex-1 flex-col items-center justify-center gap-9">
    <div class="relative">
      <div class="absolute -inset-5 rounded-[2.75rem] bg-mint-200 blur-3xl glow"></div>
      <div class="relative w-36 h-36 rounded-[2.25rem] bg-white ring-1 ring-mint-200 shadow-2xl flex items-center justify-center">
        <svg class="w-20 h-20 text-mint-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>
    <div class="text-center">
      <h1 class="text-7xl font-extrabold text-mint-600 tracking-tight mb-4">Thank You!</h1>
      <p class="text-slate-400 font-semibold text-2xl">Please come again</p>
    </div>
  </div>

  <!-- ACTIVE ORDER SCREEN -->
  <div id="activeScreen" class="hidden flex-1 flex min-h-0">

   <!-- LEFT: order -->
   <div class="flex-1 flex flex-col min-w-0 min-h-0">

    <!-- Order meta bar -->
    <div class="px-12 py-5 bg-white/75 backdrop-blur border-b border-lavender-100 flex items-center gap-5 shrink-0">
      <div class="flex items-baseline gap-3">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-[0.18em]">Order</span>
        <span id="cd-seqNo" class="font-digital font-bold text-4xl text-lavender-800 leading-none">#1</span>
      </div>
      <div class="h-7 w-px bg-slate-200"></div>
      <span id="cd-mode" class="text-sm font-bold text-lavender-800 bg-lavender-100 ring-1 ring-lavender-200 px-4 py-1.5 rounded-full">Dine In</span>
      <span id="cd-table" class="text-sm font-bold text-slate-700 bg-slate-100 ring-1 ring-slate-200 px-4 py-1.5 rounded-full">T5</span>
      <span id="cd-items" class="text-base font-bold text-slate-400 ml-auto">0 items</span>
    </div>

    <!-- Cart list -->
    <div class="flex-1 overflow-y-auto px-12 py-6 space-y-3.5" id="cd-cartList"></div>

    <!-- Totals footer -->
    <div class="shrink-0 bg-white border-t border-lavender-100 px-12 pt-6 pb-7" style="box-shadow:0 -10px 34px -14px rgba(35,16,70,.16)">
      <div class="flex justify-end mb-5">
        <div class="w-[440px] space-y-2.5 text-lg">
          <div class="flex justify-between">
            <span class="text-slate-400 font-semibold">Sub Total</span>
            <span id="cd-subTotal" class="font-bold text-slate-800 font-digital text-xl">$0.00</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400 font-semibold" id="cd-discLabel">Discount (0%)</span>
            <span id="cd-discount" class="font-bold text-amber-600 font-digital text-xl">-$0.00</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400 font-semibold" id="cd-scLabel">Service (@(((decimal)ViewData["ServiceChargePercent"]!).ToString("0"))%)</span>
            <span id="cd-serviceCharge" class="font-bold text-slate-800 font-digital text-xl">$0.00</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400 font-semibold" id="cd-gstLabel">GST (@(((decimal)ViewData["GstPercent"]!).ToString("0"))%)</span>
            <span id="cd-gst" class="font-bold text-slate-800 font-digital text-xl">$0.00</span>
          </div>
        </div>
      </div>

      <div class="rounded-3xl bg-gradient-to-r from-lavender-950 via-lavender-800 to-lavender-600 text-white px-9 py-6 flex items-center justify-between shadow-xl relative overflow-hidden">
        <div class="absolute inset-0 opacity-20 pointer-events-none" style="background:radial-gradient(420px 160px at 12% 0%, #fff, transparent 70%)"></div>
        <div class="relative">
          <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-white/55">Amount Payable</div>
          <div class="text-lg font-semibold text-white/80 mt-1">Thank you for your order</div>
        </div>
        <span id="cd-netTotal" class="relative font-digital font-bold text-7xl leading-none">$0.00</span>
      </div>
    </div>
   </div>

   <!-- RIGHT: payment QR (only when enabled in Terminal Settings) -->
   <aside id="cd-qrPanel" class="hidden w-[480px] shrink-0 border-l border-lavender-100 bg-white/70 backdrop-blur flex-col items-center justify-center px-10 gap-7">
     <div class="text-center">
       <h2 class="text-4xl font-extrabold text-lavender-900 tracking-tight">Scan to Pay</h2>
       <p class="text-slate-400 font-semibold text-lg mt-2">PayNow &middot; any Singapore banking app</p>
     </div>

     <div class="relative">
       <div class="absolute -inset-4 rounded-[2rem] bg-lavender-200 blur-2xl opacity-60"></div>
       <div class="relative bg-white p-6 rounded-[1.75rem] ring-1 ring-lavender-200 shadow-xl">
         <div id="cd-qrBox" class="w-[300px] h-[300px] flex items-center justify-center"></div>
       </div>
     </div>

     <div class="text-center">
       <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-400">Amount</div>
       <div id="cd-qrAmount" class="font-digital font-bold text-6xl text-lavender-900 leading-none mt-1.5">$0.00</div>
     </div>

     <p id="cd-qrWarning" class="hidden text-center text-sm font-bold text-amber-600 bg-amber-50 ring-1 ring-amber-200 rounded-xl px-4 py-2.5">
       No PayNow UEN or mobile configured — this code shows the amount only and cannot take payment.
     </p>
   </aside>
  </div>

  <script>
    // Rates from config_terminal_setting, used only until the first cart arrives —
    // every push from the till carries the percentages it actually billed at.
    const CONFIG_SERVICE_CHARGE = @ViewData["ServiceChargePercent"];
    const CONFIG_GST = @ViewData["GstPercent"];

    const cap = s => s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : '';
    const money = (v, sym) => `${sym || '$'}${Number(v).toFixed(2)}`;

    // ---------------- PayNow QR (EMVCo merchant-presented / SGQR) ----------------
    // PayNow is not a URI scheme: it is an EMVCo TLV payload terminated by a
    // CRC-16/CCITT-FALSE checksum over everything including the "6304" tag.

    const tlv = (tag, value) => {
      const v = String(value);
      return tag + String(v.length).padStart(2, '0') + v;
    };

    function crc16(input) {
      let crc = 0xFFFF;
      for (let i = 0; i < input.length; i++) {
        crc ^= input.charCodeAt(i) << 8;
        for (let bit = 0; bit < 8; bit++) {
          crc = (crc & 0x8000) ? ((crc << 1) ^ 0x1021) & 0xFFFF : (crc << 1) & 0xFFFF;
        }
      }
      return crc.toString(16).toUpperCase().padStart(4, '0');
    }

    function paymentPayload(data) {
      const amount = Number(data.totals.netTotal).toFixed(2);

      if (!data.payNowProxy) return `Order ${data.seqNo} - Amount ${amount}`;

      // Proxy type: "0" = mobile, "2" = UEN.
      const account =
        tlv('00', 'SG.PAYNOW') +
        tlv('01', data.payNowType === 'mobile' ? '0' : '2') +
        tlv('02', data.payNowProxy) +
        tlv('03', '0');                       // amount locked, customer cannot edit

      const name = (data.merchantName || 'NEXBILL').toUpperCase().slice(0, 25);

      const payload =
        tlv('00', '01') +                     // payload format indicator
        tlv('01', '12') +                     // dynamic QR: single use, fixed amount
        tlv('26', account) +
        tlv('52', '0000') +                   // merchant category code
        tlv('53', '702') +                    // SGD
        tlv('54', amount) +
        tlv('58', 'SG') +
        tlv('59', name) +
        tlv('60', 'Singapore') +
        tlv('62', tlv('01', String(data.seqNo))) +   // bill reference
        '6304';

      return payload + crc16(payload);
    }

    let _qrLast = null;
    function renderQrPanel(data, sym) {
      const panel = document.getElementById('cd-qrPanel');

      if (!data.showQr) {
        panel.classList.add('hidden');
        panel.classList.remove('flex');
        _qrLast = null;           // force a redraw next time it is switched on
        return;
      }

      panel.classList.remove('hidden');
      panel.classList.add('flex');
      document.getElementById('cd-qrAmount').textContent = money(data.totals.netTotal, sym);
      document.getElementById('cd-qrWarning').classList.toggle('hidden', !!data.payNowProxy);

      // Regenerating a QR is not free, so only redraw when the value changed.
      const payload = paymentPayload(data);
      if (payload === _qrLast) return;
      _qrLast = payload;

      const box = document.getElementById('cd-qrBox');
      box.innerHTML = '';
      if (typeof QRCode === 'undefined') {
        box.innerHTML = '<span class="text-sm font-bold text-slate-400 text-center">QR library unavailable offline</span>';
        return;
      }
      new QRCode(box, {
        text: payload,
        width: 300,
        height: 300,
        colorDark: '#231046',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.M
      });
    }

    // Stable per-dish colour so the same item always gets the same avatar tint.
    const AVATAR_TINTS = ['#7540cc','#0e9f6e','#d97706','#e11d48','#2563eb','#0891b2','#9333ea','#16a34a','#ea580c','#4f46e5'];
    function avatarTint(name) {
      let h = 0;
      for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) % 9973;
      return AVATAR_TINTS[h % AVATAR_TINTS.length];
    }

    // Clock
    function updateClock() {
      const now = new Date();
      document.getElementById('clockDisplay').textContent =
        now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      document.getElementById('dateDisplay').textContent =
        now.toLocaleDateString([], { weekday: 'long', day: 'numeric', month: 'short' });
    }
    setInterval(updateClock, 1000); updateClock();

    // Screens
    const idle     = document.getElementById('idleScreen');
    const active   = document.getElementById('activeScreen');
    const thankYou = document.getElementById('thankYouScreen');
    let thankYouTimer = null;

    function showScreen(name) {
      [idle, active, thankYou].forEach(el => {
        el.classList.add('hidden');
        el.classList.remove('flex-1', 'flex', 'flex-col');
      });
      const el = name === 'idle' ? idle : name === 'active' ? active : thankYou;
      el.classList.remove('hidden');
      // The order screen lays out as a row so the QR panel can sit beside it.
      el.classList.add('flex-1', 'flex');
      if (el !== active) el.classList.add('flex-col');
    }

    function renderCart(data) {
      const { cart, totals, seqNo, orderMode, tableNo, currency } = data;
      const sym = currency || '$';

      if (!cart || cart.length === 0) {
        if (thankYouTimer) { showScreen('thankYou'); return; }
        showScreen('idle'); return;
      }

      showScreen('active');

      // Meta
      document.getElementById('cd-seqNo').textContent = `#${String(seqNo).padStart(3, '0')}`;
      document.getElementById('cd-mode').textContent = orderMode === 'dinein' ? 'Dine In' : 'Take Away';
      const tableEl = document.getElementById('cd-table');
      if (orderMode === 'dinein') { tableEl.textContent = tableNo; tableEl.classList.remove('hidden'); }
      else tableEl.classList.add('hidden');
      const total = cart.reduce((a, c) => a + c.qty, 0);
      document.getElementById('cd-items').textContent = `${total} item${total === 1 ? '' : 's'}`;

      // Cart rows
      const list = document.getElementById('cd-cartList');
      const prev = new Set([...list.querySelectorAll('[data-id]')].map(el => el.dataset.id));
      const curr = new Set(cart.map(i => i.id + '_' + i.modifier));

      // Remove rows no longer in cart
      list.querySelectorAll('[data-id]').forEach(el => {
        if (!curr.has(el.dataset.id)) { el.classList.add('fade-out'); setTimeout(() => el.remove(), 200); }
      });

      cart.forEach((item, idx) => {
        const key = item.id + '_' + item.modifier;
        const lineTotal = item.foc ? 0 : item.qty * item.rPrice;
        let row = list.querySelector(`[data-id="${CSS.escape(key)}"]`);
        if (!row) {
          row = document.createElement('div');
          row.dataset.id = key;
          row.className = 'row-in flex items-center gap-6 bg-white rounded-3xl px-7 py-5 ring-1 ring-lavender-100 shadow-sm';
          list.appendChild(row);
        }
        row.innerHTML = `
          <div class="relative shrink-0">
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-white font-extrabold text-2xl shadow-sm"
                 style="background:${avatarTint(item.name)}">${cap(item.name).charAt(0)}</div>
            <span class="absolute -bottom-2 -right-2 min-w-[30px] h-[30px] px-2 rounded-full bg-lavender-950 text-white text-sm font-extrabold flex items-center justify-center ring-[3px] ring-white">${item.qty}</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-bold text-slate-900 text-2xl leading-tight truncate">${cap(item.name)}${item.foc ? ' <span class="align-middle text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-md font-extrabold ml-2">FOC</span>' : ''}</div>
            ${item.modifier ? `<div class="text-base text-lavender-600 italic truncate mt-1">&#8627; ${item.modifier}</div>` : ''}
            <div class="text-sm text-slate-400 font-semibold mt-1">${money(item.rPrice, sym)} each</div>
          </div>
          <div class="shrink-0 font-digital font-bold text-4xl ${item.foc ? 'text-amber-500 line-through' : 'text-slate-900'}">${money(lineTotal, sym)}</div>`;
      });

      // Totals
      document.getElementById('cd-subTotal').textContent    = money(totals.subTotal, sym);
      document.getElementById('cd-discount').textContent    = `-${money(totals.discountAmt, sym)}`;
      document.getElementById('cd-serviceCharge').textContent = money(totals.serviceChargeAmt, sym);
      document.getElementById('cd-gst').textContent         = money(totals.gstAmt, sym);

      // Draw the eye to the total only when it actually changed.
      const netEl = document.getElementById('cd-netTotal');
      const net = money(totals.netTotal, sym);
      if (netEl.textContent !== net) {
        netEl.textContent = net;
        netEl.classList.remove('total-pop');
        void netEl.offsetWidth;
        netEl.classList.add('total-pop');
      }

      renderQrPanel(data, sym);
      document.getElementById('cd-discLabel').textContent   = `Discount (${Number(totals.discountPercent || 0).toFixed(0)}%)`;
      document.getElementById('cd-scLabel').textContent     = `Service (${Number(totals.serviceChargePercent ?? CONFIG_SERVICE_CHARGE).toFixed(0)}%)`;
      document.getElementById('cd-gstLabel').textContent    = `GST (${Number(totals.gstPercent ?? CONFIG_GST).toFixed(0)}%)`;
    }

    // Server-sent events: works across browsers, profiles and machines, and the
    // server replays the current cart as soon as this connects.
    const stream = new EventSource('@Url.Content("~/")' + 'api/display/stream');

    stream.onmessage = e => {
      let msg;
      try { msg = JSON.parse(e.data); } catch { return; }

      if (msg.type === 'closed') {
        // The till is shutting down. Stop reconnecting, then try to close; if the
        // browser refuses, fall back to the welcome screen rather than leaving a
        // customer's order on display.
        stream.close();
        clearTimeout(thankYouTimer);
        thankYouTimer = null;
        showScreen('idle');
        window.close();
        return;
      }

      if (msg.type === 'paid') {
        clearTimeout(thankYouTimer);
        showScreen('thankYou');
        thankYouTimer = setTimeout(() => { thankYouTimer = null; showScreen('idle'); }, 4000);
        return;
      }

      // Only a new order cancels the thank-you screen early; the empty-cart
      // update that follows payment must not cut it short.
      if (msg.cart && msg.cart.length) { clearTimeout(thankYouTimer); thankYouTimer = null; }
      renderCart(msg);
    };

    // Idle on load
    showScreen('idle');

    // Fullscreen. Browsers refuse a self-initiated request on load, so attempt it
    // and fall back to the first click/keypress in this window.
    if (new URLSearchParams(location.search).get('fs') === '1') {
      const hint = document.getElementById('fsHint');
      const enter = () => {
        try {
          if (document.fullscreenElement) return Promise.resolve();
          return document.documentElement.requestFullscreen({ navigationUI: 'hide' }) || Promise.resolve();
        } catch (err) { return Promise.reject(err); }
      };

      const onGesture = () => {
        enter().catch(() => {});
        hint.classList.add('hidden');
        document.removeEventListener('click', onGesture);
        document.removeEventListener('keydown', onGesture);
      };

      enter().catch(() => {
        hint.classList.remove('hidden');
        document.addEventListener('click', onGesture);
        document.addEventListener('keydown', onGesture);
      });

      document.addEventListener('fullscreenchange', () => {
        if (document.fullscreenElement) hint.classList.add('hidden');
      });
    }

  </script>
</body>
</html>
