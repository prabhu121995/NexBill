{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Pos": {
    "TimeZone": "Singapore Standard Time"
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": { "PermitLimit": 600, "WindowSeconds": 60 },
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 }
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
